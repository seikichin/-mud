/******************************************************
 * vrm_fixed.lpc  -  固定形状虚拟区域引擎（固定地下城）
 *
 * 由 /std/room/vrm_dungeon.lpc 派生：保留全部房间工厂与生命周期管理，
 * 只把“拓扑来源”从随机 DFS 换成地图文件。
 *
 * 【适用】
 *   固定地下城：上百间同质房间，形状手工设计，每次重建都一样。
 *   （十几间具名房间的营地/城镇街区不需要本引擎，直接写房间文件更合适）
 *
 * 【用法】
 *   1) 区域文件 /d/xxx/fixed1.lpc：
 *
 *        inherit "/std/room/vrm_fixed";
 *
 *        void create() {
 *          set_inherit_room(__DIR__ "fixed1_room");   // 房间模板
 *          set_maze_map(__DIR__ "fixed1");            // 地图文件（.map 可省略）
 *          set_maze_spacing(1);
 *
 *          set_entry_dir("north");                    // 入口在迷宫哪一侧
 *          set_link_entry_dir("down");                // 外面进入的方向
 *          set_entry_back_dir("up");                  // （可选）入口房返回外面的方向
 *          set_link_entry_room("/d/xxx/gate");
 *          set_link_exit_dir("up");
 *          set_link_exit_room("/d/xxx/gate");
 *
 *          set_entry_short(...); set_entry_desc(...);
 *          set_exit_short(...);  set_exit_desc(...);
 *          set_maze_room_short(...); set_maze_room_desc(...);
 *        }
 *
 *   2) 在相邻房间写一条普通出口（"pub" 是实例键，固定值即可）:
 *
 *        set("exits", ([ "down": "/d/xxx/fixed1/pub/entry" ]));
 *
 * 【地图文件格式】
 *       [SIZE] l,m,h           # 可选；省略时按内容推导
 *       [ENTRY] x,y,z          # 可选；入口格坐标
 *       [EXIT]  x,y,z          # 可选；出口格坐标
 *       [Z=0]                  # 楼层段头，后续数据行都属于 z=0
 *       0C 0C 0C               # 每格两位十六进制方向位掩码
 *       00 00 0C               # 00 = 无房间
 *
 *       位值（见 include/vrm.h）:
 *         1=E(东,+x)  2=W(西,-x)  4=S(南,-y)  8=N(北,+y)  16=D(下,-z)  32=UP(上,+z)
 *         64=NE(东北)  128=NW(西北)  256=SE(东南)  512=SW(西南)
 *         1024=NU(北边高处)  2048=SU(南边高处)  4096=EU(东边高处)  8192=WU(西边高处)
 *         16384=ND(北边低处)  32768=SD(南边低处)  65536=ED(东边低处)  131072=WD(西边低处)
 *       每格十六进制，1~8 位均可解析（斜向位全开时是 5 位）；00 = 无房间。
 *       数据行自 y=0 起（首行为 y=0），第 n 列的 x = n-1；格与格之间用空格分隔。
 *       斜向出口与基础方向一样要求「互反」（A 的 NE 位对应 B 的 SW 位），
 *       check_maze_map() 会逐位检查。
 *       '#' 开头为注释；空行忽略；'[' 开头的行不得缩进。
 *
 *       [LINK] x,y,z,方向,目标   # 可选；特殊出口（enter/out 等非网格方向）
 *         目标为 "tx,ty,tz" → 本迷宫内的另一格
 *         目标为其它字符串  → 直接作为对象路径（可指向迷宫外的房间）
 *         例: [LINK] 5,3,0,enter,5,4,0
 *         不受方向位的互反/相邻约束；校验器只检查格间目标必须非空。
 *
 * 【修改约定】
 *   同 vrm_dungeon.lpc：先父后子 update
 ******************************************************/

#include <vrm.h>;
inherit "/std/room/vrm_dungeon";

// ---------- 地图文件状态 ----------
string maze_map_file;      // 地图文件路径（.map 可省略）
string *map_lines;         // 地图文本行（缓存）
int map_meta_done;         // 头部是否已解析
int map_broken;            // 地图加载失败（避免重复刷日志）
int map_enter_set;
int map_enter_x, map_enter_y, map_enter_z;
int map_exit_set;
int map_exit_x, map_exit_y, map_exit_z;

// 特殊出口（enter/out 等非网格方向）
// key = "x,y,z"，值 = ({ ({方向名, 目标}), ... })
// 目标是 "tx,ty,tz" 形式 → 本迷宫内的另一格；否则视为对象路径
mapping maze_links;
int map_link_count;

string entry_back_dir;     // 入口房返回外面的方向
string exit_back_dir;      // 出口房通向外面的方向
string maze_owner_key;     // 固定区域的实例键（强制覆盖请求路径里的 owner）

// ---------- 设置器 ----------

void set_maze_map(string f) {
  if (!stringp(f) || f == "") return;
  maze_map_file = f;
  map_lines = 0;
  map_meta_done = 0;
  map_broken = 0;
  maze_links = ([]);
  map_link_count = 0;
}

// 地图改动后重新读取
void reload_maze_map() {
  map_lines = 0;
  map_meta_done = 0;
  map_broken = 0;
  maze_links = ([]);
  map_link_count = 0;
}

void set_entry_back_dir(string d) {
  if (stringp(d) && d != "") entry_back_dir = d;
}

// 固定区域的实例键：房间名统一为 <引擎>/<键>/...，与谁先进来无关。
// 不设时沿用请求路径里的那段（通常就是入口房间写的那段）。
void set_maze_owner_key(string k) {
  if (stringp(k) && k != "") maze_owner_key = k;
}

void set_exit_back_dir(string d) {
  if (stringp(d) && d != "") exit_back_dir = d;
}

string query_maze_map() { return maze_map_file; }

// 返回方向：优先用显式设置，否则取进入方向的反向
string query_entry_back_dir() {
  if (stringp(entry_back_dir)) return entry_back_dir;
  if (stringp(link_entry_dir) && stringp(reverse_dir[link_entry_dir]))
    return reverse_dir[link_entry_dir];
  return link_entry_dir;
}

string query_exit_back_dir() {
  if (stringp(exit_back_dir)) return exit_back_dir;
  if (stringp(link_exit_dir) && stringp(reverse_dir[link_exit_dir]))
    return reverse_dir[link_exit_dir];
  return link_exit_dir;
}

// ---------- 地图解析基础 ----------

// 解析一个十六进制格（1~8 位）；非法字符返回 -1
int map_hex(string s) {
  int i, n, v, c;

  if (!stringp(s) || s == "") return -1;
  n = strlen(s);
  v = 0;
  for (i = 0; i < n; i++) {
    c = s[i];
    if (c >= 48 && c <= 57) v = v * 16 + (c - 48);
    else if (c >= 97 && c <= 102) v = v * 16 + (c - 87);
    else if (c >= 65 && c <= 70) v = v * 16 + (c - 55);
    else return -1;
  }
  return v;
}

// 一行数据 → 格子数组
int *map_row_cells(string line) {
  string *toks;
  int i, n;
  int *res = ({});

  if (!stringp(line) || line == "") return res;
  toks = explode(line, " ");
  n = sizeof(toks);
  for (i = 0; i < n; i++) {
    if (!stringp(toks[i]) || toks[i] == "") continue;
    res += ({ map_hex(toks[i]) });
  }
  return res;
}

// 段头标签："[XXX] ..." → "XXX"；非段头返回 0
string map_tag(string line) {
  int e;
  if (!stringp(line) || line == "" || line[0] != '[') return 0;
  e = strsrch(line, "]");
  if (e <= 1) return 0;
  return line[1..e-1];
}

// 段头参数
string map_arg(string line) {
  int e;
  if (!stringp(line) || line == "") return "";
  e = strsrch(line, "]");
  if (e < 0 || e + 1 >= strlen(line)) return "";
  return line[e+1..];
}

// 前置声明（fluffos 要求先声明后用）
string *query_map_lines();

// ---------- 特殊出口（[LINK] 段） ----------
// 语法： [LINK] x,y,z,方向,目标
//   目标为 "tx,ty,tz"  → 本迷宫内的另一格
//   目标为其它字符串  → 直接作为对象路径（可指向迷宫外的房间）
// 用途：表达 enter / out / 爬 / 钻 等非网格方向，以及任意跨格连线。
// 说明：这些出口不参与方向位掩码，因而不受互反/相邻约束；
//       校验器只检查"格间目标"必须是本迷宫里的非空格。
void parse_maze_links() {
  string *lines, *parts;
  string line, tag, arg, key, dir, tgt;
  int i, n, k, nparts, x, y, z, tx, ty, tz;

  maze_links = ([]);
  map_link_count = 0;

  lines = query_map_lines();
  n = sizeof(lines);

  for (i = 0; i < n; i++) {
    line = lines[i];
    if (!stringp(line) || line == "") continue;
    if (line[0] != '[') continue;

    tag = map_tag(line);
    if (!stringp(tag) || tag != "LINK") continue;

    arg = map_arg(line);
    if (!stringp(arg) || arg == "") continue;
    if (sscanf(arg, "%s", key) != 1) continue;
    if (!stringp(key) || key == "") continue;

    parts = explode(key, ",");
    nparts = sizeof(parts);
    if (nparts < 5) continue;

    x = to_int(parts[0]);
    y = to_int(parts[1]);
    z = to_int(parts[2]);
    dir = parts[3];
    if (!stringp(dir) || dir == "") continue;

    if (nparts >= 7) {
      tx = to_int(parts[4]);
      ty = to_int(parts[5]);
      tz = to_int(parts[6]);
      tgt = sprintf("%d,%d,%d", tx, ty, tz);
    } else {
      tgt = parts[4];
      for (k = 5; k < nparts; k++) tgt += "," + parts[k];
    }
    if (!stringp(tgt) || tgt == "") continue;

    key = sprintf("%d,%d,%d", x, y, z);
    if (!arrayp(maze_links[key])) maze_links[key] = ({});
    maze_links[key] += ({ ({ dir, tgt }) });
    map_link_count++;
  }
}

// 读地图文件（缓存）
string *query_map_lines() {
  string txt;

  if (arrayp(map_lines)) return map_lines;
  if (!stringp(maze_map_file) || maze_map_file == "") return ({});

  txt = read_file(maze_map_file);
  if (!stringp(txt) || txt == "")
    txt = read_file(maze_map_file + ".map");
  if (!stringp(txt) || txt == "") {
    log_file("VRM", sprintf("vrm_fixed: 无法读取地图 [%s]", maze_map_file));
    map_lines = ({});
    return map_lines;
  }

  txt = replace_string(txt, "\r", "");
  map_lines = explode(txt, "\n");
  return map_lines;
}

// ---------- 头部解析 ----------
// 注意：create_maze() 的顺序是 refresh_vars() → check_vars() → query_maze_size()，
// 而 check_vars() 会校验 l/m/h，所以固定地图的尺寸必须在 check_vars() 之前就绪
// → 由下面的 refresh_vars() 覆盖提前装载（这也是本引擎与随机引擎的关键差异）。
void query_maze_size() {
  string *lines;
  string line, tag, arg;
  int i, n, a, b, c, zz, cols;
  int currows, maxrows, maxcols, maxz, have_size;

  if (map_meta_done) return;

  lines = query_map_lines();
  n = sizeof(lines);

  have_size = 0;
  currows = 0; maxrows = 0; maxcols = 0; maxz = 0;

  for (i = 0; i < n; i++) {
    line = lines[i];
    if (!stringp(line) || line == "") continue;
    if (line[0] == '#') continue;

    if (line[0] == '[') {
      tag = map_tag(line);
      arg = map_arg(line);
      if (!stringp(tag)) continue;

      if (tag == "SIZE") {
        if (sscanf(arg, "%d,%d,%d", a, b, c) == 3) {
          l = a; m = b; h = c;
          have_size = 1;
        }
        continue;
      }
      if (tag == "ENTRY") {
        if (sscanf(arg, "%d,%d,%d", a, b, c) == 3) {
          map_enter_set = 1;
          map_enter_x = a; map_enter_y = b; map_enter_z = c;
        }
        continue;
      }
      if (tag == "EXIT") {
        if (sscanf(arg, "%d,%d,%d", a, b, c) == 3) {
          map_exit_set = 1;
          map_exit_x = a; map_exit_y = b; map_exit_z = c;
        }
        continue;
      }
      if (sscanf(tag, "Z=%d", zz) == 1) {
        if (currows > maxrows) maxrows = currows;
        currows = 0;
        if (zz + 1 > maxz) maxz = zz + 1;
        continue;
      }
      continue;   // 未知段头忽略
    }

    // 数据行
    cols = sizeof(map_row_cells(line));
    if (cols > maxcols) maxcols = cols;
    currows++;
  }
  if (currows > maxrows) maxrows = currows;

  if (!have_size) {
    // 按内容推导；推不出时保留 create() 里 set_maze_long() 的设定
    if (maxcols >= 2) l = maxcols;
    if (maxrows >= 2) m = maxrows;
    if (maxz >= 1) h = maxz;
  }

  if (h < 1) h = 1;
  map_meta_done = 1;
}

// 覆盖：在 check_vars() 之前把地图头读进来（定好 l/m/h）
void refresh_vars() {
  ::refresh_vars();
  if (!map_meta_done) query_maze_size();
  // 固定区域的实例键：无论谁触发，房间名都用同一个键
  if (stringp(maze_owner_key) && maze_owner_key != "") owner = maze_owner_key;
}

// ---------- 填充 all[x][y][z] ----------
void fill_maze_from_map() {
  string *lines;
  string line, tag;
  int i, n, x, y, z, zz, v, bad;
  int *cells;

  lines = query_map_lines();
  n = sizeof(lines);
  z = 0; y = 0; bad = 0;

  for (i = 0; i < n; i++) {
    line = lines[i];
    if (!stringp(line) || line == "") continue;
    if (line[0] == '#') continue;

    if (line[0] == '[') {
      tag = map_tag(line);
      if (stringp(tag) && sscanf(tag, "Z=%d", zz) == 1) {
        z = zz;
        y = 0;
      }
      continue;
    }

    if (z < 0 || z >= h) { y++; continue; }
    if (y < 0 || y >= m) { y++; continue; }

    cells = map_row_cells(line);
    for (x = 0; x < sizeof(cells); x++) {
      if (x >= l) break;
      v = cells[x];
      if (v < 0 || v > ALL_DIRS) {
        bad++;
        v = 0;
      }
      all[x][y][z] = v;
    }
    y++;
  }

  if (bad)
    log_file("VRM", sprintf("vrm_fixed: %s 有 %d 个非法格（已按墙处理）",
      maze_map_file, bad));
}

// 地图加载失败：保留尺寸，把内容清空
// （让扫描与房间工厂安全地失败，且地图修好后引擎还能重建）
void map_fail(string why) {
  if (!map_broken)
    log_file("VRM", sprintf("vrm_fixed [%s]: %s", maze_map_file, why));
  map_broken = 1;

  if (l >= 2 && m >= 2 && h >= 1) {
    all = allocate(l);
    for (int i = 0; i < l; i++) all[i] = allocate(m);
    for (int i = 0; i < l; i++)
      for (int j = 0; j < m; j++) all[i][j] = allocate(h);
  } else {
    all = ({});
  }
}

// ---------- 建图：分配数组 + 读地图 + 定入口 ----------
void build_maze() {
  int i, j;

  if (!stringp(maze_map_file) || maze_map_file == "") {
    map_fail("未调用 set_maze_map()");
    return;
  }

  if (!map_meta_done) query_maze_size();

  if (l < 2 || m < 2 || h < 1) {
    map_fail(sprintf("地图尺寸非法 l=%d m=%d h=%d", l, m, h));
    return;
  }

  all = allocate(l);
  for (i = 0; i < l; i++) all[i] = allocate(m);
  for (i = 0; i < l; i++)
    for (j = 0; j < m; j++) all[i][j] = allocate(h);

  fill_maze_from_map();
  parse_maze_links();

  enter = new(class coordinate);
  if (map_enter_set) {
    enter->x = map_enter_x;
    enter->y = map_enter_y;
    enter->z = map_enter_z;
  } else {
    enter->x = to_int(l / 2);
    enter->y = to_int(m / 2);
    enter->z = 0;
    switch (entry_dir) {
      case "south": enter->y = 0; break;
      case "north": enter->y = m - 1; break;
      case "west":  enter->x = 0; break;
      case "east":  enter->x = l - 1; break;
      case "up":    enter->z = h - 1; break;
      case "down":  enter->z = 0; break;
    }
  }

  if (enter->x < 0 || enter->x >= l || enter->y < 0 || enter->y >= m
      || enter->z < 0 || enter->z >= h) {
    map_fail(sprintf("入口坐标越界 %d,%d,%d", enter->x, enter->y, enter->z));
    return;
  }

  if (!all[enter->x][enter->y][enter->z]) {
    map_fail(sprintf("入口格 %d,%d,%d 在地图中是空的",
      enter->x, enter->y, enter->z));
    return;
  }
}

// ---------- 覆盖 vrm_dungeon 的钩子 ----------

// 固定地图：拓扑来自文件，无出口时绝不递归重建（坏地图会打爆 eval cost）
int query_maze_retry_on_failure() {
  return 0;
}

// 地图里 [EXIT] 指定的出口是否可用
int query_maze_has_fixed_exit() {
  if (!map_exit_set) return 0;
  if (!arrayp(all)) return 0;
  if (map_exit_x < 0 || map_exit_x >= l) return 0;
  if (map_exit_y < 0 || map_exit_y >= m) return 0;
  if (map_exit_z < 0 || map_exit_z >= h) return 0;
  return all[map_exit_x][map_exit_y][map_exit_z] ? 1 : 0;
}

mixed query_maze_leave(mixed valid_leaves, mixed dflt) {
  class coordinate c;

  if (!query_maze_has_fixed_exit()) return dflt;

  c = new(class coordinate);
  c->x = map_exit_x;
  c->y = map_exit_y;
  c->z = map_exit_z;
  return c;
}

// 共享实例：固定区域是全服共用的一处地方，
// 请求的 owner 键与首次建立时不同也不另建实例（否则会各自建一份副本）。
int query_maze_shared() {
  return 1;
}

// 固定区域是“公共场所”：不把迷宫实例挂到某个玩家身上
object query_maze_actor() {
  return this_object();
}

mixed query_maze_mark_ob(mixed who) {
  return owner;
}

// 覆盖基类的房间回调钩子：先走房间模板，再补上 [LINK] 特殊出口。
// 调用时机在 vrm_dungeon::create_maze() 内部——此时方向位出口都已 set 完，
// 因此 [LINK] 若用了同名方向，会覆盖方向位出口。
void setup_room_callbacks(mixed f, object ob, int l, int m, int h, int x, int y, int z) {
  mixed *ls;
  string tgt;
  int i, n, tx, ty, tz;

  ::setup_room_callbacks(f, ob, l, m, h, x, y, z);

  if (!mapp(maze_links)) return;
  ls = maze_links[sprintf("%d,%d,%d", x, y, z)];
  if (!arrayp(ls)) return;

  n = sizeof(ls);
  for (i = 0; i < n; i++) {
    if (!arrayp(ls[i]) || sizeof(ls[i]) < 2) continue;
    tgt = ls[i][1];
    if (!stringp(tgt) || tgt == "") continue;
    // "tx,ty,tz" 三整数形式 = 本迷宫内的另一格 → 换算成房间路径
    if (sscanf(tgt, "%d,%d,%d", tx, ty, tz) == 3)
      tgt = mroom_fname(tx, ty, tz);
    ob->set(sprintf("exits/%s", ls[i][0]), tgt);
  }
}

// 入口房：补一条通往区域外的普通出口（固定区域不走 out 动作）
void setup_entry_room_extra(object ob) {
  string d;
  if (!ob) return;
  d = query_entry_back_dir();
  if (stringp(d) && d != "" && stringp(link_entry_room) && link_entry_room != "")
    ob->set(sprintf("exits/%s", d), link_entry_room);
}

// 出口房：同上
void setup_exit_room_extra(object ob) {
  string d;
  if (!ob) return;
  d = query_exit_back_dir();
  if (stringp(d) && d != "" && stringp(link_exit_room) && link_exit_room != "")
    ob->set(sprintf("exits/%s", d), link_exit_room);
}

// ---------- 校验工具（地图作者 / 巫师命令用）----------

// 校验已建成的迷宫：出口互反、指向不越界、入口/出口格存在。
// 返回错误描述数组（空数组 = 通过）。
string *check_maze_map() {
  string *errs = ({});
  int x, y, z, k, v, nx, ny, nz, cnt, enter_bit, leave_bit;
  // 方向位/坐标偏移/反向位统一取 vrm_dungeon 的 18 向表（6 基础向 + 12 斜向）

  if (!arrayp(all) || l < 2 || m < 2 || h < 1)
    return ({ "迷宫未建立（地图可能加载失败）" });

  // 入口格/出口格各有一个位是「指向迷宫外」的（分别指向 entry / exit 房间），
  // 这是引擎设计（查询房间时会被覆盖），校验时须放行。
  enter_bit = dir_bit(entry_dir);
  leave_bit = dir_bit(reverse_dir[entry_dir]);

  cnt = 0;
  for (x = 0; x < l; x++)
    for (y = 0; y < m; y++)
      for (z = 0; z < h; z++) {
        v = all[x][y][z];
        if (!v) continue;
        cnt++;
        for (k = 0; k < sizeof(dir_bits); k++) {
          if (!(v & dir_bits[k])) continue;
          nx = x + dir_dx[k]; ny = y + dir_dy[k]; nz = z + dir_dz[k];
          if (nx < 0 || nx >= l || ny < 0 || ny >= m || nz < 0 || nz >= h) {
            if ((x == enter->x && y == enter->y && z == enter->z && dir_bits[k] == enter_bit)
             || (x == leave->x && y == leave->y && z == leave->z && dir_bits[k] == leave_bit))
              continue;
            errs += ({ sprintf("(%d,%d,%d) 方向 %s 指向越界", x, y, z, dir_names[k]) });
            continue;
          }
          if (!all[nx][ny][nz])
            errs += ({ sprintf("(%d,%d,%d) 方向 %s 指向空房间", x, y, z, dir_names[k]) });
          else if (!(all[nx][ny][nz] & dir_opp[k]))
            errs += ({ sprintf("(%d,%d,%d) 与 (%d,%d,%d) 出口不互反（%s）", x, y, z, nx, ny, nz, dir_names[k]) });
        }
      }

  // 特殊出口（[LINK]）校验：格间目标必须是本迷宫里的非空格
  parse_maze_links();
  {
    string *ks = keys(maze_links);
    int ii, jj, nn, lx, ly, lz;
    mixed *ls, *one;
    for (ii = 0; ii < sizeof(ks); ii++) {
      if (sscanf(ks[ii], "%d,%d,%d", lx, ly, lz) != 3) continue;
      ls = maze_links[ks[ii]];
      if (!arrayp(ls)) continue;
      nn = sizeof(ls);
      for (jj = 0; jj < nn; jj++) {
        one = ls[jj];
        if (!arrayp(one) || sizeof(one) < 2) continue;
        if (sscanf(one[1], "%d,%d,%d", nx, ny, nz) != 3) continue;
        if (nx < 0 || nx >= l || ny < 0 || ny >= m || nz < 0 || nz >= h)
          errs += ({ sprintf("(%d,%d,%d) 特殊出口 %s 目标越界", lx, ly, lz, one[0]) });
        else if (!all[nx][ny][nz])
          errs += ({ sprintf("(%d,%d,%d) 特殊出口 %s 指向空房间", lx, ly, lz, one[0]) });
      }
    }
  }

  if (cnt < 1) errs += ({ "地图里没有任何房间" });

  if (map_enter_set) {
    if (map_enter_x < 0 || map_enter_x >= l || map_enter_y < 0 || map_enter_y >= m
        || map_enter_z < 0 || map_enter_z >= h)
      errs += ({ "[ENTRY] 越界" });
    else if (!all[map_enter_x][map_enter_y][map_enter_z])
      errs += ({ "[ENTRY] 指向空房间" });
  } else {
    errs += ({ "缺少 [ENTRY]（将按 entry_dir 自动选）" });
  }

  if (map_exit_set) {
    if (map_exit_x < 0 || map_exit_x >= l || map_exit_y < 0 || map_exit_y >= m
        || map_exit_z < 0 || map_exit_z >= h)
      errs += ({ "[EXIT] 越界" });
    else if (!all[map_exit_x][map_exit_y][map_exit_z])
      errs += ({ "[EXIT] 指向空房间" });
  } else {
    errs += ({ "缺少 [EXIT]（将按边界房间随机选）" });
  }

  return errs;
}

// 连通性检查：从入口 BFS，返回不可达的房间数
int check_maze_reachable() {
  int *q = ({});
  int *seen = ({});
  int i, x, y, z, k, v, nx, ny, nz, cnt, idx, key, total;
  // 方向位/坐标偏移统一取 vrm_dungeon 的 18 向表

  if (!arrayp(all) || l < 2 || m < 2 || h < 1) return -1;
  parse_maze_links();

  total = 0;
  for (x = 0; x < l; x++)
    for (y = 0; y < m; y++)
      for (z = 0; z < h; z++)
        if (all[x][y][z]) total++;

  if (!total) return 0;

  seen = allocate(l * m * h);
  for (i = 0; i < l * m * h; i++) seen[i] = 0;

  x = enter->x; y = enter->y; z = enter->z;
  key = x + y * l + z * l * m;
  seen[key] = 1;
  q = ({ key });
  cnt = 1;

  for (idx = 0; idx < sizeof(q); idx++) {
    int key2 = q[idx];
    x = key2 % l;
    y = (key2 / l) % m;
    z = key2 / (l * m);

    v = all[x][y][z];
    for (k = 0; k < sizeof(dir_bits); k++) {
      if (!(v & dir_bits[k])) continue;
      nx = x + dir_dx[k]; ny = y + dir_dy[k]; nz = z + dir_dz[k];
      if (nx < 0 || nx >= l || ny < 0 || ny >= m || nz < 0 || nz >= h) continue;
      if (!all[nx][ny][nz]) continue;
      key = nx + ny * l + nz * l * m;
      if (seen[key]) continue;
      seen[key] = 1;
      q += ({ key });
      cnt++;
    }

    // 特殊出口（[LINK]）：按有向边计入连通性
    {
      mixed *ls = maze_links[sprintf("%d,%d,%d", x, y, z)];
      int ii, tx, ty, tz;
      if (arrayp(ls))
        for (ii = 0; ii < sizeof(ls); ii++) {
          if (!arrayp(ls[ii]) || sizeof(ls[ii]) < 2) continue;
          if (sscanf(ls[ii][1], "%d,%d,%d", tx, ty, tz) != 3) continue;
          if (tx < 0 || tx >= l || ty < 0 || ty >= m || tz < 0 || tz >= h) continue;
          if (!all[tx][ty][tz]) continue;
          key = tx + ty * l + tz * l * m;
          if (seen[key]) continue;
          seen[key] = 1;
          q += ({ key });
          cnt++;
        }
    }
  }

  return total - cnt;
}

// =====================================================================
//  虚拟路径（覆盖 vrm_dungeon 的默认实现）
//
//  默认实现： mroom_fname = <区域对象路径>/<owner>/x/y/z
//  固定区域的 owner 由 set_maze_owner_key() 指定，恒等于区域名，
//  于是路径里出现三段重复的区名：
//      /d/fixedtest/<区>/<区>/<区>/<x>/<y>/<z>
//  当 owner 与区域对象自身的文件名相同时，owner 段是冗余的，这里把它去掉：
//      格房   /d/fixedtest/<区>/<x>/<y>/<z>
//      入口房 /d/fixedtest/<区>/entry
//      出口房 /d/fixedtest/<区>/exit
//
//  注意：owner 与区域文件名不同的区域（例如 /d/fixedtest/test/ 下的
//  fixed1(pub)、big6(pub6) 等测试区）会退化为默认实现，保持原路径不变，
//  以免同一目录下的多个区域互相撞名。
//  /adm/daemons/virtuald 的 compile_object 已同步支持该短路径。
// =====================================================================

// owner 段是否为冗余（owner == 区域对象文件名）
int query_maze_owner_redundant() {
  string b;
  int i;

  b = base_name(this_object());
  i = strsrch(b, "/", -1);
  b = (i >= 0) ? b[i + 1..] : b;
  return (stringp(owner) && owner != "" && b == owner);
}

// 虚拟房间的路径前缀
string query_maze_pathbase() {
  string b;
  int i;

  b = base_name(this_object());
  if (!query_maze_owner_redundant()) return b;
  i = strsrch(b, "/", -1);
  return (i > 0) ? b[0..i - 1] : b;
}

string mroom_fname(int x, int y, int z) {
  if (query_maze_owner_redundant())
    return sprintf("%s/%d/%d/%d", query_maze_pathbase(), x, y, z);
  return sprintf("%s/%s/%d/%d/%d", query_maze_pathbase(), owner, x, y, z);
}

string maze_link_fname(string what) {
  if (query_maze_owner_redundant())
    return sprintf("%s/%s", query_maze_pathbase(), what);
  return sprintf("%s/%s/%s", query_maze_pathbase(), owner, what);
}
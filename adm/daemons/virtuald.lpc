/* /system/daemon/virtual.c
 * from XO Object Library II
 * compile some virtual objects. 
 * created by trill 19970920
 * last modify by akuma on 24-04-2002
 * version 1.1 for player self-found domains
 * add virtual object for MF by akuma 2003-7-9
 */


void create() {
  seteuid(getuid());
}

// This function is called by master object to return the "virtual" object
// of <file> when dirver failed to find such a file.

object compile_object(string file) {

  string pname = file;
  object obj, oe;
  if (!file) {
    return 0;
  } else if (strlen(file) > 15 && file[0..15] == "/d/phoenix/base/" && file != "/d/phoenix/base/alive") {

    obj = find_object("/d/phoenix/base/alive");
    if (!obj)
      obj = load_object("/d/phoenix/base/alive");
    // this object controls the whole virtual area.

    oe = obj->get_obj(file);
    if (oe)
      return oe;
    destruct(obj);
    return 0;
  } else if (strlen(file) > 15 && file[0..15] == "/d/place/player/") {
    object room = new("/d/place/player/newroom");
    if (room->restore_me(file[16..]))
      return room;
    else {
      destruct(room);
      return 0;
    }
  } else if (strlen(file) > 15 && file[0..15] == "/d/place/domain/") {
    object room = new("/std/room/vroom");
    room->restore_me(file[16..]);
    room->set_exits(file);
    return room;
  }

  // ------------------------------------------------------------------
  //  vrm_fixed 固定区域：短路径（通用版；2026-09-28 由 fixedtest 专用版泛化）
  //    <区域目录>/<区名>/<x>/<y>/<z> | /entry | /exit
  //      → <区域目录>/<区名>->query_maze_room("<区名>/<x>/<y>/<z>|entry|exit")
  //  例：/d/fixedtest/tangmen/3/4/0、/d/bylh/jianghu/7/11/0
  //  （vrm_fixed 覆盖了 mroom_fname/query_maze_pathbase，虚拟格房路径
  //    就是 <区目录>/<区名>/x/y/z，不再带重复的区名段）
  //  注：query_maze_room() 的参数格式是 "<owner>/<tail>"，此处的 owner
  //      就是固定区域的实例键（= 区名），故须显式补上该段。
  // ------------------------------------------------------------------
  {
    string area, tail, apath, cand;
    object ad, r;
    int k, sl, qx, qy, qz, ok;

    k = -1;
    for (int i = strlen(file) - 1; i > 0; i--) {
      if (file[i] != '/')
        continue;

      tail = file[i + 1..];
      ok = 0;
      if (tail == "entry" || tail == "exit")
        ok = 1;
      else if (sscanf(tail, "%d/%d/%d", qx, qy, qz) == 3)
        ok = 1;
      if (!ok)
        continue;

      apath = file[0..i - 1];

      // 布局 A：<目录>/<区名>.lpc        （如 /d/bylh/jianghu.lpc）
      if (file_size(apath + ".lpc") >= 0) {
        k = i;
        break;
      }

      // 布局 B：<目录>/<区名>/<区名>.lpc （如 /d/fixedtest/tangmen/tangmen.lpc）
      sl = strsrch(apath, "/", -1);
      cand = apath + "/" + ((sl >= 0) ? apath[sl + 1..] : apath);
      if (file_size(cand + ".lpc") >= 0) {
        apath = cand;
        k = i;
        break;
      }
    }

    if (k > 0) {
      sl = strsrch(apath, "/", -1);
      area = (sl >= 0) ? apath[sl + 1..] : apath;
      tail = file[k + 1..];

      ad = find_object(apath);
      if (!objectp(ad))
        ad = load_object(apath);
      if (objectp(ad) && inherits("/std/room/vrm_base", ad)) {
        r = ad->query_maze_room(area + "/" + tail);
        if (objectp(r)) {
          r->set_virtual_flag();
          return r;
        }
      }
    }
  }

  while (1) {
    int idx = strsrch(pname, "/", -1);

    if (idx == -1)
      return 0;

    if (idx != 0)
      pname = pname[0..idx - 1];

    //		CHANNEL_D->do_sys_channel("sys", "file= " + file + "  pname=" + pname);

    if (file_size(pname + ".lpc") >= 0)
      if (obj = pname->query_maze_room(file[idx + 1..])) {
        obj->set_virtual_flag();
        return obj;
      }
    if (!idx)
      return 0;
  }

  return 0;
}

// Silencer@fengyun workgroup	June.2005
//稀有怪物和物品发生器
//spawnd.c:	控制稀有怪物和物品的定时分布

//	Now it will actively search item and NPC and recreate them if necessary.
//	CLONE will not trigger Spawnd
// 注意如果物品编译出错，ｓｐａｗｎｄ将停止此物品序列之后的产生。
// 我这里写了room的情况，不过，最好不要用哈，not tested thoroughly
//
// [2026-09-15] 移植 DGD fymud 侧的同源修复并新增 spawn_all():
//   1. restart_spawn() counter 语义修正(num<=0 立即生效) + 参数越界保护
//   2. 分布失败时发系统频道告警(原来完全静默, 失败项 respawn=100000 永久停摆且无人知晓)
//   3. 新增 stat_spawn_table() 诊断, 一眼看出哪几项已停摆
//   4. 新增 spawn_all() 立即把所有条目分布一遍
//   内部把"跑一轮"抽成 check_spawn_table(force), 供定时器与 spawn_all 复用,
//   避免直接调用 dis_spawn_table() 会重复挂 call_out 定时器链的问题。

#define SPAWN_INTERVAL 3600 // 3600 --> 1 hour per check.当然你可以用3457来搞坏:D

#include <ansi.h>

inherit F_DBASE;
mapping *spawn_table;
mapping *read_table(string file);

void init_spawn_table();    //　初始化
void show_spawn_table();    //	ｌｉｓｔ　ｓｐａｗｎｓ
void clear_spawn_table();    // 在 init_spawn_table前清理所有非ｒｏｏｍ的复制物件
int check_spawn_table(int force);   // 内部: 跑一轮分布检查(force=1 忽略计时)

int restart_spawn(int order, int num);  // 让room/npc/item自己call this决定restart;
int check_spawn(int num);     //  spawnd 检查某物品是否已经在player手中了
void stat_spawn_table();      // [新增] 列出所有分布项的当前状态
int spawn_all(int clear_first);  // [新增] 立即把所有条目分布一遍

void create() {
  seteuid(getuid());
  spawn_table = read_table("/adm/etc/spawn_table");
  set("channel_id", "分布精灵");
  set("id", "spawnd");
  init_spawn_table();
}

void init_spawn_table() {
  int i;
  clear_spawn_table();   // All previous have to be destructed.
  for (i = 0; i < sizeof(spawn_table); i++) {
    spawn_table[i]["counter"] = -1 - random(10);  // reboot后随机10小时内分布
    spawn_table[i]["start"] = 1;
    spawn_table[i]["respawn"] = spawn_table[i]["respawn_base"] + random(spawn_table[i]["respawn_random"]);
  }
  /*        CHANNEL_D->do_sys_channel(
                        "sys",sprintf("初始化分布列表，\n%O\n初始化完毕。\n",
                        spawn_table));*/
  call_out("dis_spawn_table", SPAWN_INTERVAL);
}

void show_spawn_table() {
  CHANNEL_D->do_sys_channel(
    "sys", sprintf("当前物品分布情况为：\n%O\n\n",
      spawn_table));
}

//	[新增] 列出所有分布项的当前状态
//	用法: 巫师 call spawnd->stat_spawn_table();
//	      对 respawn >= 100000 的项(已停摆), 用 restart_spawn(编号,-1) 恢复
void stat_spawn_table() {
  int i, halted;
  halted = 0;
  CHANNEL_D->do_sys_channel("sys",
    sprintf("系统: spawn 分布表共 %d 项\n", sizeof(spawn_table)));
  for (i = 0; i < sizeof(spawn_table); i++) {
    // respawn >= 100000 表示该项分布失败已被暂停(见 check_spawn_table)
    if (spawn_table[i]["respawn"] >= 100000) {
      halted++;
      CHANNEL_D->do_sys_channel("sys",
        sprintf("  [停摆] #%d %s %s (respawn=%d counter=%d)\n",
          i, spawn_table[i]["type"], spawn_table[i]["file"],
          spawn_table[i]["respawn"], spawn_table[i]["counter"]));
    } else {
      CHANNEL_D->do_sys_channel("sys",
        sprintf("  [正常] #%d %s %s (respawn=%d counter=%d)\n",
          i, spawn_table[i]["type"], spawn_table[i]["file"],
          spawn_table[i]["respawn"], spawn_table[i]["counter"]));
    }
  }
  CHANNEL_D->do_sys_channel("sys",
    sprintf("系统: 共 %d 项, %d 项已停摆; 恢复用 call spawnd->restart_spawn(编号,-1)\n",
      sizeof(spawn_table), halted));
}

//	[新增] 立即把所有条目分布一遍(不等 respawn 计时)
//	clear_first = 0 : 当前已有存活副本的条目跳过(不会重复生成)
//	clear_first = 1 : 先清掉旧的 spawnd 副本, 再全部重新生成
//	用法: call spawnd->spawn_all();
//	返回: 本次实际分布出去的条目数
int spawn_all(int clear_first) {
  int n;
  if (clear_first) clear_spawn_table();
  n = check_spawn_table(1);
  CHANNEL_D->do_sys_channel("sys",
    sprintf("系统: spawn_all 完成, 本次分布 %d 项。\n", n));
  return n;
}

//	这个函数is outdated, 用于强制respawn，
int restart_spawn(int order, int num)  // num一般是设为0了，除非你要它立即开始(-1)
{
  if (order < 0 || order >= sizeof(spawn_table)) return 0;  // 越界保护

  spawn_table[order]["start"] = 1;

  // counter 语义: check_spawn_table 每轮先 counter++ 再判 "== 0" 才分布,
  // 所以"立即生效"必须置 -1(下一轮 +1 恰好归 0);
  // 若照抄 num 本身, num=0 时下一轮变 1 就再也回不到 0, 要等完整个 respawn 周期才生效。
  //   num <= 0 : 立即生效
  //   num >  0 : num 轮之后生效
  spawn_table[order]["counter"] = (num <= 0) ? -1 : -num;
  return 1;
}

void dis_spawn_table() {
  check_spawn_table(0);
  call_out("dis_spawn_table", SPAWN_INTERVAL);
}

//	内部: 跑一轮分布检查(供 dis_spawn_table / spawn_all 复用)
//	force = 0 : 常规定时检查(依 counter/respawn 决定是否分布)
//	force = 1 : 忽略计时, 对当前没有存活副本的条目立即分布
int check_spawn_table(int force) {
  int i;
  string name;
  object obj, room;
  int spawned;

  spawned = 0;
  for (i = 0; i < sizeof(spawn_table); i++) {
    if (!force) {
      if (!spawn_table[i]["start"]) {
        // 这里处理物品和NPC的respawn
        if (spawn_table[i]["type"] == "room") continue;
        if (check_spawn(i)) continue;  // 已经有一个没被user拿了的copy

        spawn_table[i]["start"] = 1;
        spawn_table[i]["counter"] = 1;
      }
      spawn_table[i]["counter"]++;
      if (spawn_table[i]["counter"] >= spawn_table[i]["respawn"])
        spawn_table[i]["counter"] = 0;
      if (spawn_table[i]["counter"] != 0) continue;
    } else {
      // 强制模式: 已有存活副本的条目跳过, 避免重复生成
      if (spawn_table[i]["type"] != "room" && check_spawn(i)) continue;
    }

    name = spawn_table[i]["file"];

    CHANNEL_D->do_sys_channel(
      "sys", sprintf("系统于%s开始分布%s\n",
        "/cmds/usr/uptime"->chinese_time(5, time() + ""), name));

    spawn_table[i]["start"] = 0;
    spawned++;

    // Room
    if (spawn_table[i]["type"] == "room") {
      obj = find_object(name);
      if (!obj) obj = load_object(name);
      if (!obj) {
        spawn_table[i]["respawn"] = 100000;
        CHANNEL_D->do_sys_channel("sys",
          sprintf("系统: 刷新目标%d(%s)时失败, 已暂停刷新, 巫师可用 call spawnd->restart_spawn(%d,-1) 恢复\n",
            i, name, i));
      } else {
        obj->set("spawn_num", i);
        obj->set("spawn_legal", 1);
        obj->init_spawn();
      }
      continue;
    }
    // 人物或者物品
    obj = new(name);
    if (!obj) {
      spawn_table[i]["respawn"] = 100000;
      CHANNEL_D->do_sys_channel("sys",
        sprintf("系统: 刷新目标%d(%s)时失败, 已暂停刷新, 巫师可用 call spawnd->restart_spawn(%d,-1) 恢复\n",
          i, name, i));
      continue;
    }
    obj->set("spawn_num", i);
    obj->set("spawn_legal", 1);

    if (!spawn_table[i]["self_init"]) {
      room = find_object(obj->query("spawn_location"));
      if (!room) room = load_object(obj->query("spawn_location"));
      if (!room || !(obj->move(room))) {
        spawn_table[i]["respawn"] = 100000;
        CHANNEL_D->do_sys_channel("sys",
          sprintf("系统: 刷新目标%d(%s)时移动失败, 已暂停刷新, 巫师可用 call spawnd->restart_spawn(%d,-1) 恢复\n",
            i, name, i));
        destruct(obj);
      }
      if (room) room->set("perma_exist", 1);  // We don't want it to be cleaned out.
      continue;
    }
    if (!obj->init_spawn())
      destruct(obj);
  }
  return spawned;
}
mapping *read_table(string file) {
  string *line, *field, *format;
  mapping *data;
  int i, rn, fn;
  //      write(sprintf("file is %s\n",file));
  line = explode(read_file(file), "\n");
  data = ({});
  for (i = 0; i < sizeof(line); i++) {
    if (line[i] == "" || line[i][0] == '#') continue;
    //               write(sprintf("line[%d]= %O\n field=%O\n format= %O \n",i,line[i],field,format));
    if (!pointerp(field)) {
      field = explode(line[i], ":");
      continue;
    }
    if (!pointerp(format)) {
      format = explode(line[i], ":");
      continue;
    }
    break;
  }
  //      write(sprintf("line= %O\n field=%O\n format= %O \n",line,field,format));
  for (rn = 0, fn = 0; i < sizeof(line); i++) {
    if (line[i] == "" || line[i][0] == '#') continue;
    if (!fn) data += ({ allocate_mapping(sizeof(field)) });
    sscanf(line[i], format[fn], data[rn][field[fn]]);
    fn = (++fn) % sizeof(field);
    if (!fn)++ rn;
  }
  return data;
}


void clear_spawn_table() {
  int i, j;
  string name;
  object *list;

  for (i = 0; i < sizeof(spawn_table); i++) {
    if (spawn_table[i]["type"] == "room") continue;

    name = spawn_table[i]["file"];
    /*		CHANNEL_D->do_sys_channel(
              "sys",sprintf("系统于%s开始清理%s。\n",
                     "/cmds/usr/uptime"->chinese_time(5,time()+""),name));*/
    // 人物或者物品
    list = children(name);
    if (sizeof(list) < 1) continue;
    for (j = 0; j < sizeof(list); j++) {
      if (!list[j]->query("spawn_legal")) continue;  // not spawnd created.
      if (!environment(list[j])) continue;  // source
      if (spawn_table[i]["type"] == "item") {
        if (userp(environment(list[j]))) continue;  // user hold
        if (environment(environment(list[j])))
          if (userp(environment(environment(list[j])))) continue;  // user hold in container
          if (environment(list[j])->query("tax") >= 1) continue;
      }
      CHANNEL_D->do_sys_channel(
        "sys", sprintf("系统清除%O @ %O。\n", list[j], environment(list[j])));
      destruct(list[j]);
    }
  }
  return;
}

int check_spawn(int num) {

  string name;
  object *list;
  int i, count = 0;

  if (spawn_table[num]["type"] == "room") return 0;

  name = spawn_table[num]["file"];
  list = children(name);
  if (!list || sizeof(list) < 1) return 0;
  for (i = 0; i < sizeof(list); i++) {
    if (!list[i]->query("spawn_legal")) continue;  // not spawnd created.
    if (!environment(list[i])) continue;   // source
    if (userp(environment(list[i]))) continue;  // user hold
    if (environment(environment(list[i])))
      if (userp(environment(environment(list[i])))) continue;  // user hold in container
      count++;
  }
  return count;
}

// mxpd.lpc - MXP (MUD eXtension Protocol) 支持
//
// 与驱动配合:
//   config.fluffos:  enable mxp : 1
//   连接时驱动发 IAC DO 91 (MXP); 客户端回 IAC WILL 91 后 has_mxp(ob) 为真,
//   驱动同时会调用玩家对象的 mxp_enable() apply。
//
// 本 daemon 只负责生成 MXP 标记文本。所有函数在客户端不支持 MXP 时
// 原样返回普通文本, 因此调用方可以直接拼接, 无需自己分支。
//
// 安全: 玩家可控文本(物品名、玩家名等)必须经 escape() 转义后再放进标记,
//       否则玩家可以伪造 MXP 标签。

#include <ansi.h>
#include <mxp.h>

// 元素定义(必须整行处于 secure 行中才会被客户端接受)
#define MXP_ELEMENTS \
  ("<!ELEMENT rshort FLAG=RoomName>" + \
   "<!ELEMENT rdesc  FLAG=RoomDesc>" + \
   "<!ELEMENT rexits FLAG=RoomExit>")

void create() { }

// ------------------------------------------------------------------
// 状态查询
// ------------------------------------------------------------------

// 客户端是否"能渲染 MXP, 但可能没完成 telnet 协商"。
//
// 目前识别 Mudlet: 它连接时依次上报 TTYPE "MUDLET" / "ANSI-TRUECOLOR" / "MTTS <n>",
// 我们在 login 对象上保留了第一个值(见 obj/login.lpc 的 terminal_type)。
// Mudlet 的源码里有一条兜底(trackMXPElementDetection): 只要数据流中出现任意 MXP
// 行模式标记 ESC[<0-7>z —— 而我们下发的元素定义与每个标签都会带 —— 它就会自动
// 启用 MXP 处理器并锁定 secure 模式。因此对这类客户端, 即便 telnet 协商没成功
// (例如连线早于本功能启用, 或用户在客户端关掉了 MXP 协商开关), 直接发 MXP 标记
// 也能被正确渲染成可点击链接。
int ttype_supports_mxp(object ob) {
  object link;
  string t;

  link = ob->query_temp("link_ob");
  if (!objectp(link)) return 0;

  t = link->query_temp("mxp/ttype");
  if (!stringp(t) || !strlen(t)) return 0;

  if (strsrch(lower_case(t), "mudlet") != -1) return 1;

  return 0;
}

// MXP 对该玩家是否可用: 客户端支持 MXP 且玩家没有关闭(set mxp 0)
int query_mxp(object ob) {
  mixed v;
  int supported;

  if (!objectp(ob)) return 0;
  if (!interactive(ob)) return 0;

  supported = ttype_supports_mxp(ob);
  if (!supported && ob->query_temp("mxp/enabled")) supported = 1;
#if efun_defined(has_mxp)
  if (!supported && has_mxp(ob)) supported = 1;
#endif
  if (!supported) return 0;

  v = ob->query("env/mxp");
  if (undefinedp(v)) return 1;          // 默认开启
  if (intp(v)) return v ? 1 : 0;
  if (stringp(v)) {
    v = lower_case(v);
    if (v == "0" || v == "no" || v == "off" || v == "false" ||
        v == "disable" || v == "disabled")
      return 0;
  }
  return 1;
}

// ------------------------------------------------------------------
// 文本转义
// ------------------------------------------------------------------

// 转义玩家可控文本中的 MXP 临界字符, 防止标签注入
string escape(string str) {
  if (!stringp(str)) return "";
  str = replace_string(str, "&", "&amp;");
  str = replace_string(str, "<", "&lt;");
  str = replace_string(str, ">", "&gt;");
  return str;
}

// 转义标签属性值
string escape_attr(string str) {
  str = escape(str);
  str = replace_string(str, "\"", "&quot;");
  str = replace_string(str, "'", "&apos;");
  return str;
}

// ------------------------------------------------------------------
// 初始化: 首次使用时下发元素定义
// ------------------------------------------------------------------

// 返回 1 表示该玩家可用 MXP；首次调用会下发元素定义
int init(object ob) {
  if (!query_mxp(ob)) return 0;

  if (!ob->query_temp("mxp/definitions_sent")) {
    ob->set_temp("mxp/definitions_sent", 1);
    // 整行 secure 模式(到行尾为止), 元素定义只在 secure 行生效
    tell_object(ob, MXP_SECURE_LINE + MXP_ELEMENTS + "\n");
  }
  return 1;
}

// ------------------------------------------------------------------
// 标记生成
// ------------------------------------------------------------------

// 普通元素包裹。ESC[4z = 仅让紧随其后的一个标签进入 secure 模式,
// 标签之间的正文仍处于 open 模式, 因此玩家可控文本不会被当作标签解析。
string tag(object ob, string name, string text) {
  if (!query_mxp(ob)) return text;
  if (!stringp(text)) text = "";
  return MXP_TEMP_SECURE + "<" + name + ">" + text +
         MXP_TEMP_SECURE + "</" + name + ">";
}

// 带属性的元素
string tag_args(object ob, string name, string args, string text) {
  if (!query_mxp(ob)) return text;
  if (!stringp(text)) text = "";
  if (!stringp(args) || !strlen(args)) return tag(ob, name, text);
  return MXP_TEMP_SECURE + "<" + name + " " + args + ">" + text +
         MXP_TEMP_SECURE + "</" + name + ">";
}

// 可点击命令链接(客户端点击 text 后把 command 发回服务器)
string cmd(object ob, string command, string text) {
  if (!query_mxp(ob)) return text;
  if (!stringp(command) || !strlen(command)) return text;
  if (!stringp(text)) text = "";
  return MXP_TEMP_SECURE + "<send href=\"" + escape_attr(command) + "\">" +
         text + MXP_TEMP_SECURE + "</send>";
}

// 房间名 / 房间描述 / 出口行(带自动地图 FLAG)
string rshort(object ob, string text) { return tag(ob, "rshort", text); }
string rdesc(object ob, string text)  { return tag(ob, "rdesc",  text); }
string rexits(object ob, string text) { return tag(ob, "rexits", text); }

// 是否是"可安全用作指令参数"的 ASCII 标识符。
// 实测: 本驱动的 present()/指令解析不接受含多字节字符的参数
// (present("board",env)=1, 但 present("管理事项板",env)=0),
// 所以链接里只能用英文 id, 不能用中文 name。
int is_ascii_id(string s) {
  int i, c;

  if (!stringp(s) || !strlen(s)) return 0;
  for (i = 0; i < strlen(s); i++) {
    c = s[i];
    if (c >= 'a' && c <= 'z') continue;
    if (c >= 'A' && c <= 'Z') continue;
    if (c >= '0' && c <= '9') continue;
    if (c == '-' || c == '_') continue;
    return 0;
  }
  return 1;
}

// 为某个对象生成 look 指令(用于把房间里的物品/人物变成可点击链接)。
// query("id") 既可能是字符串(本库大多数对象, 如 "smaug"/"board"),
// 也可能是数组; 这里两种都处理, 且只接受纯 ASCII 的 id。
// 找不到合适的 id 就返回 "", 调用方会退化成普通文本(不生成点不动的死链)。
string look_cmd(object ob) {
  mixed ids;
  string id, cand;
  int i;

  if (!objectp(ob)) return "";

  ids = ob->query("id");

  if (stringp(ids)) {
    if (strlen(ids) && is_ascii_id(ids)) id = ids;
  } else if (arrayp(ids)) {
    for (i = 0; i < sizeof(ids) && !strlen(id); i++) {
      cand = ids[i];
      if (stringp(cand) && strlen(cand) && is_ascii_id(cand)) id = cand;
    }
  }

  if (!stringp(id) || !strlen(id)) return "";
  return "look " + id;
}

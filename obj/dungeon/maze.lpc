// PRIVATE MAZE GENERATOR - maze （变体适配层）

// 公共实现见 /std/room/vrm_dungeon.lpc（再上层为 /std/room/vrm_base.lpc）
// 本文件只保留：本变体的配置 create() 与房间工厂 query_maze_room()。

#pragma optimize

inherit "/std/room/vrm_dungeon";
#include <vrm.h>;
#include <ansi.h>;

// ============ 本变体的钩子 ============

// 迷宫三维随主人等级增长。
void query_maze_size() {
  object who;

  who = find_player(owner);

  l = (who->query("level") / 50) + 2;
  m = (who->query("level") / 50) + 2;
  h = (who->query("level") / 50) + 2;
}

// 拆除迷宫时玩家撤到风云广场（与原 maze 的硬编码一致）。
string query_exile_room() {
  return "/d/fycycle/sroad5";
}

void create() {
  set_inherit_room(__DIR__ "maze_room");
  set_maze_long(2 + random(2), 2 + random(2), 1 + random(2));
  set_maze_spacing(1);
  set_maze_refresh(1800);  // 每个maze生存30min.

  set_entry_dir("north");

  set_link_entry_dir("down");
  set_link_entry_room("/d/fy/fysquare");
  set_link_entry_room_x(110);
  set_link_entry_room_y(0);
  set_link_entry_room_z(0);

  set_link_exit_dir("out");
  set_link_exit_room("/d/fy/fysquare");

  set_entry_short(MAG "漆黑入口" NOR);
  set_entry_desc(@LONG

LONG
  );

  set_exit_short(MAG "行路难" NOR);
  set_exit_desc(@LONG
行路难，行路难，多歧路，今安在？
LONG
  );

  set_maze_room_short(MAG "古佛窟" NOR);
  set_maze_room_desc(@LONG
再往里去，就是小巴山传闻中神秘莫测的古佛窟。站在洞口看去，只见灰岩风
锈，貌不惊人，但据曾侥幸自佛窟中逃出性命的人说，窟内借万尊佛像之力布有奇
门阵法，能以五音五色乱人心脉，一进佛窟，就只见各种幻象层出不穷，定力稍有
不坚，便会迷失在异象之中。
LONG
  );

}



// 房间工厂 query_maze_room() 已上移到 /std/room/vrm_dungeon.lpc。
// 本变体直接沿用基类默认钩子（默认值即 maze 的行为），无需覆盖。

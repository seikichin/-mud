// PRIVATE MAZE GENERATOR - standardmaze （变体适配层）

// 公共实现见 /std/room/vrm_dungeon.lpc（再上层为 /std/room/vrm_base.lpc）
// 本文件只保留：本变体的配置 create() 与房间工厂 query_maze_room()。

#pragma optimize

#define COLLECT_ROOM "/d/fy/hiretem"

inherit "/std/room/vrm_dungeon";
#include <vrm.h>;
#include <ansi.h>;

// ============ 本变体的钩子 ============

// 拆除迷宫时给玩家看的提示（标准版多两个换行）。
string query_destroy_msg() {
  return "突然传来一阵天崩地裂般的撼动，你吓得连忙冲出迷宫，\n转头看去，整个迷宫已经崩毁於无形。\n\n\n";
}

// 标准迷宫连玩家尸体一起移出（原 standardmaze 的行为）。
int query_move_player_corpses() {
  return 1;
}

void create() {
  set_inherit_room(__DIR__ "standardmaze_room");
  set_maze_long(3, 3, 1);
  //	set_maze_long(2, 2, 2);
  set_maze_spacing(1);
  set_maze_refresh(3600);  // 每个maze生存60min.

  set_entry_dir("north");

  set_link_entry_dir("down");
  set_link_entry_room("/d/fy/fysquare");
  set_link_entry_room_x(110);
  set_link_entry_room_y(0);
  set_link_entry_room_z(0);

  set_link_exit_dir("out");
  set_link_exit_room("/d/fy/fysquare");

  set_entry_short(MAG "漆黑入口" NOR);
  set_entry_desc(@LONG

黑漆漆的一个密窟，虽然一眼看去空荡荡的，但似乎随时随地会跳出伏兵，若是
你不想丧命于此，可用（ｏｕｔ）命令退出

LONG
  );

  set_exit_short(MAG "总坛" NOR);
  set_exit_desc(@LONG

终于到了密窟深处，这里胡乱地堆着些柴草，想到一路上的血战，你恨不得把这
个鬼地方一把火烧了（ｂｕｒｎ）。

LONG
  );

  set_maze_room_short(MAG "古佛窟" NOR);
  set_maze_room_desc(@LONG
再往里去，就是小巴山传闻中神秘莫测的古佛窟。站在洞口看去，只见灰岩风
锈，貌不惊人，但据曾侥幸自佛窟中逃出性命的人说，窟内借万尊佛像之力布有奇
门阵法，能以五音五色乱人心脉，一进佛窟，就只见各种幻象层出不穷，定力稍有
不坚，便会迷失在异象之中。
LONG
  );

}


// ============ 房间工厂的变体钩子 ============
// （工厂本体见 /std/room/vrm_dungeon.lpc）

// 私有迷宫实例在玩家身上的属性键。该键由 quest 系统
// (cmds/std/entermaze.lpc、obj/dungeon/boss_user.lpc) 共用，不可与其它变体合并。
string query_maze_prop_key() {
  return "private_maze/maze";
}

// 建迷宫时把实例记到"迷宫主人"身上（原 standardmaze 的行为）。
object query_maze_actor() {
  return find_player(owner);
}

// 入口房间附带三维（原 standardmaze 的行为）。
void setup_entry_room_extra(object ob) {
  ob->set("x/l", l);
  ob->set("x/m", m);
  ob->set("x/h", h);
}

// standardmaze_room 的回调签名不含 height。
void setup_room_callbacks(mixed f, object ob, int l, int m, int h, int x, int y, int z) {
  f->setup_room_desc(ob, l, m, x, y, z);
  f->setup_npc_obj(ob, l, m, x, y, z);
}

// PRIVATE MAZE GENERATOR - halloween （变体适配层）

// 公共实现见 /std/room/vrm_dungeon.lpc（再上层为 /std/room/vrm_base.lpc）
// 本文件只保留：本变体的配置 create() 与房间工厂 query_maze_room()。

#pragma optimize

inherit "/std/room/vrm_dungeon";
#include <vrm.h>;
#include <ansi.h>;

// ============ 本变体的钩子 ============

// 万圣节迷宫固定 4x4x2。
void query_maze_size() {
  object who;

  who = find_player(owner);

  l = 4;
  m = 4;
  h = 2;
}

// 拆除迷宫时玩家撤到郭大妈的封窖（与原 halloween 的硬编码一致）。
string query_exile_room() {
  return "/d/taoyuan/guojia1";
}

// 万圣节迷宫的拆除提示走郭大妈剧情。
string query_destroy_msg() {
  return "郭大妈高喊道：出来，出来了诶！封窖的时候到了！\n你现在可以向郭大妈回报结果(end)了……\n";
}

void create() {
  set_inherit_room(__DIR__ "halloween_room");
  set_maze_long(2 + random(2), 2 + random(2), 1 + random(2));
  set_maze_spacing(1);
  set_maze_refresh(270);  // 每个maze生存3min.--> 4'30'' easy is fine :)

  set_entry_dir("north");

  set_link_entry_dir("down");
  set_link_entry_room("/d/fy/fysquare");
  set_link_entry_room_x(110);
  set_link_entry_room_y(0);
  set_link_entry_room_z(0);

  set_link_exit_dir("out");
  set_link_exit_room("/d/fy/fysquare");

  set_entry_short(MAG "南瓜仓底层" NOR);
  set_entry_desc("南瓜南瓜南瓜南瓜南瓜南瓜南瓜南瓜南瓜还是南瓜...\n");

  set_exit_short(MAG "南瓜仓顶阁" NOR);
  set_exit_desc("南瓜南瓜南瓜南瓜南瓜南瓜南瓜南瓜南瓜没错这里都是南瓜...\n");

  set_maze_room_short(MAG "古佛窟" NOR);
  set_maze_room_desc(@LONG
再往里去，就是小巴山传闻中神秘莫测的古佛窟。站在洞口看去，只见灰岩风
锈，貌不惊人，但据曾侥幸自佛窟中逃出性命的人说，窟内借万尊佛像之力布有奇
门阵法，能以五音五色乱人心脉，一进佛窟，就只见各种幻象层出不穷，定力稍有
不坚，便会迷失在异象之中。
LONG
  );

}


// ============ 房间工厂的变体钩子 ============
// （工厂本体见 /std/room/vrm_dungeon.lpc）

// 私有迷宫实例在玩家身上的属性键（halloween 专属命名空间）。
string query_maze_prop_key() {
  return "private_mazer/maze";
}

// halloween_room->destruct_maze() 需要 mark_ob 是玩家对象本身（它用 user->query(...)），
// 而 maze/standardmaze 的房间模板用 find_player(query("mark_ob")) 需要 id 字符串。
// 这是真实语义差异，不可统一。
mixed query_maze_mark_ob(object actor) {
  return actor;
}

// halloween_room 的回调多一个前置 owner 参数，且额外调用 setup_room_obj。
void setup_room_callbacks(mixed f, object ob, int l, int m, int h, int x, int y, int z) {
  f->setup_room_desc(owner, ob, l, m, h, x, y, z);
  f->setup_npc_obj(owner, ob, l, m, h, x, y, z);
  f->setup_room_obj(owner, ob, l, m, h, x, y, z);
}

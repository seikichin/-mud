#include <ansi.h>
inherit __DIR__ "scroll.lpc";

void create() {
  set_name("『" MAG "紫陌残篇·撼天秘鉴" NOR "』" NOR, ({ "scroll" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", YEL "一卷薄薄的丝绢，可以阅读(Read)以学习上面所记载的能力。\n" NOR);
    set("value", 1000);
    set("unit", "本");
    set("material", "paper");
    set("teaching", "damage");
  }
}


// 《白玉老虎》蜀中唐门武学秘籍 · 毒针图谱

inherit ITEM;

void create() {
  set_name("毒针图谱", ({ "毒针图谱", "duzhen tupu", "zhen tupu" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("value", 2000);
    set("material", "paper");
    set("no_get", 1);
    set("no_sell", 1);
    set("long",
      "一叠薄薄的绢，上面用极细的墨线画着各式各样的针。\n有的像牛毛，有的像绣花针，最长的一枚也短得几乎看不见。\n每根针旁边都注着淬毒的方子。\n");
    set("skill", ([
      "name": "tangmen-zhen",
      "exp_required": 200000,
      "sen_cost": 15,
      "difficulty": 5,
      "liter_level": 20,
      "max_skill": 100,
    ]));
  }
  ::init_item();
}

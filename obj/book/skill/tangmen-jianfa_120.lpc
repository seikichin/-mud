// 《白玉老虎》蜀中唐门武学秘籍 · 唐门剑谱

inherit ITEM;

void create() {
  set_name("唐门剑谱", ({ "唐门剑谱", "tangmen jianpu", "jianpu" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("value", 2000);
    set("material", "paper");
    set("no_get", 1);
    set("no_sell", 1);
    set("long",
      "一卷剑谱，画的是六招。\n每一招都画了三遍：第一遍是起手，第二遍是中途，第三遍是收势。\n剑路很短，也很干净 —— 没有一招是多余的。\n");
    set("skill", ([
      "name": "tangmen-jianfa",
      "exp_required": 500000,
      "sen_cost": 20,
      "difficulty": 6,
      "liter_level": 30,
      "max_skill": 120,
    ]));
  }
  ::init_item();
}

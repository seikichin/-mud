// 《白玉老虎》蜀中唐门武学秘籍 · 满天花雨真诀

inherit ITEM;

void create() {
  set_name("满天花雨真诀", ({ "满天花雨真诀", "manyu zhenjue", "huayu zhenjue" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("value", 2000);
    set("material", "paper");
    set("no_get", 1);
    set("no_sell", 1);
    set("long",
      "一本很厚的册子，前面二十页全是废纸 ——\n写满了又划掉的字。\n\n后面的字才渐渐定了下来，一行一行数着：\n六十四件，六十四个部位。\n");
    set("skill", ([
      "name": "manyu-lihua",
      "exp_required": 2000000,
      "sen_cost": 30,
      "difficulty": 8,
      "liter_level": 40,
      "max_skill": 130,
    ]));
  }
  ::init_item();
}

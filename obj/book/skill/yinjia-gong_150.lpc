// 《白玉老虎》蜀中唐门武学秘籍 · 阴劲秘要

inherit ITEM;

void create() {
  set_name("阴劲秘要", ({ "阴劲秘要", "yinjia miyao", "yinjia gong" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("value", 2000);
    set("material", "paper");
    set("study_class", "tangmen");
    set("no_sell", 1);
    set("long",
      "册子很薄，字也很少。\n\n只有一句话，反复写了七遍：\n\n    「先坏其身，后成其功。」\n");
    set("skill", ([
      "name": "yinjia-gong",
      "exp_required": 3000000,
      "sen_cost": 35,
      "difficulty": 8,
      "liter_level": 40,
      "max_skill": 60,
    ]));
  }
  ::init_item();
}

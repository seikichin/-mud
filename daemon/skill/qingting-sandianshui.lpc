// qingting-sandianshui.lpc —— 《白玉老虎》蜀中唐门武学
// 原著：「蜀中唐门」并不是一个武功的门派，也不是一个秘密帮会，而是一个家族。
// 他们的毒药暗器实在太可怕，江湖中人闻而丧胆。
#include <ansi.h>
inherit SKILL;

void setup() {
  set("name", "蜻蜓三抄水");
  set("type", "step");
  set("usage/dodge", 1);
  set("usage/move", 1);
  set("skill_class", "tangmen");
  set("effective_level", 175);
  set("difficulty", 350);
  set("dodge_msg", ({
    "$n脚尖在水面上连点三下，人已掠出七丈，$N追之不及。\n",
    "$n一纵一落再一纵，身法轻得像一片落在水上的叶子。\n",
    "$n三个起落间已绕着$N转了半圈，$N连他的方向都辨不清。\n",
    "$n身子贴着地面掠了出去，$N这一招只劈到了一片残影。\n",
  }));
}

int valid_learn(object me) {
  if (!::valid_learn(me)) return 0;
  if ((int)me->query_skill("move", 1) < 58)
    return notify_fail("你的基本功夫不到家，练不成蜻蜓三抄水。
");
  return 1;
}

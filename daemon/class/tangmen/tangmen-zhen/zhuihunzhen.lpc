// 唐门毒针·『追魂针』(zhuihunzhen)
//
//   一枚针，追着魂魄走。唐门的针细如牛毛，出手没有声音，
//   内力却顺着针身连点三处 —— 三叠，都在一个呼吸里。
//
//   （本招式不附带任何中毒效果，只有即时的伤害。）

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

#include "/daemon/class/tangmen/tangmen_ammo.lpc"

int perform(object me, object target) {
  string err;
  int extra;

  extra = me->query_skill("tangmen-zhen", 1);
  if (extra < 80)
    return notify_fail("『追魂针』需要80级的唐门毒针。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("『追魂针』只能对战斗中的对手使用。\n");

  if (stringp(err = tangmen_ammo_error(me)))
    return notify_fail(err);

  message_vision(HIC "\n$N指间一紧，一根细得几乎看不见的针已经没入风中 —— 连破空的声音都没有。\n" NOR, me, target);

  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);

  COMBAT_D->do_attack(me, target, TYPE_PERFORM, HIC "第一叠！针入" NOR);
  COMBAT_D->do_attack(me, target, TYPE_PERFORM, HIC "第二叠！针转" NOR);
  COMBAT_D->do_attack(me, target, TYPE_PERFORM, HIC "第三叠！针归" NOR);

  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);

  use_tangmen_ammo(me, target);
  me->perform_busy(2);
  return 1;
}

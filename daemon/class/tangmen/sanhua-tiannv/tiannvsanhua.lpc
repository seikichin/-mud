// 散花天女·『天女散花』(tiannvsanhua)
//
//   散花天女是唐门手里最重的一种暗器 ——
//   花心一绽，火与铁就一起泼出去。
//
//   （本招式不附带任何中毒效果，只有即时的伤害。）

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

#include "/daemon/class/tangmen/tangmen_ammo.lpc"

int perform(object me, object target) {
  string err;
  int extra;

  extra = me->query_skill("sanhua-tiannv", 1);
  if (extra < 150)
    return notify_fail("『天女散花』需要150级的散花天女。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("『天女散花』只能对战斗中的对手使用。\n");

  if (stringp(err = tangmen_ammo_error(me)))
    return notify_fail(err);

  message_vision(HIR "\n$N取出一枚散花天女，指尖在花心上一紧 —— 那朵牡丹，开了。\n" NOR, me, target);

  me->add_temp("apply/attack", extra / 2);
  me->add_temp("apply/damage", extra * 3 / 2);

  COMBAT_D->do_attack(me, target, TYPE_PERFORM, HIR "一瓣！铁与火齐出" NOR);
  COMBAT_D->do_attack(me, target, TYPE_PERFORM, HIR "二瓣！花心尽碎" NOR);
  COMBAT_D->do_attack(me, target, TYPE_PERFORM, HIR "三瓣！地也跟着裂了" NOR);

  me->add_temp("apply/attack", -extra / 2);
  me->add_temp("apply/damage", -extra * 3 / 2);

  use_tangmen_ammo(me, target);
  me->perform_busy(3);
  return 1;
}

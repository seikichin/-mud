// 毒蒺藜·『蒺藜布地』(jilibudi)
//
//   一枚蒺藜十三片叶子，落地之后还有倒刺。
//   唐门的人不只是打暗器，还要让这一片地都变成暗器。
//
//   （本招式不附带任何中毒效果，只有即时的压制。）

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

#include "/daemon/class/tangmen/tangmen_ammo.lpc"

int perform(object me, object target) {
  string msg, err;
  int extra, mod;
  mapping buff;

  extra = me->query_skill("dujili", 1);
  if (extra < 100)
    return notify_fail("『蒺藜布地』需要100级的毒蒺藜。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("『蒺藜布地』只能对战斗中的对手使用。\n");

  if (stringp(err = tangmen_ammo_error(me)))
    return notify_fail(err);

  if (ANNIE_D->check_buff(target, "powerdown"))
    return notify_fail("对方已经被逼得迈不开步子了。\n");

  mod = COMBAT_D->can_busy(me, target, "dujili");
  if (!mod)
    return notify_fail(HIW "此人步法沉稳，这一片蒺藜困他不住。\n" NOR);

  message_vision(HIY "\n$N手一抖，一把蒺藜贴着地面撒开 —— \n" NOR
    HIC "十三片叶子在半空里张开，落地时已是一地锋利的星。\n" NOR, me, target);

  if (COMBAT_D->do_busy_attack(me, target, "dujili/jilibudi", "weapon", extra * 2, mod)) {
    msg = HIR "$n" HIR "每迈一步都要先看一眼脚下，越打越是缩手缩脚。\n" NOR;
    buff = ([
      "caster": me,
      "who": target,
      "type": "powerdown",
      "att": "curse",
      "name": "毒蒺藜·蒺藜布地",
      "buff1": "apply/attack",
      "buff1_c": -extra,
      "buff2": "apply/dodge",
      "buff2_c": -extra / 2,
      "time": 60,
      "buff_msg": msg,
    ]);
    ANNIE_D->buffup(buff);
    target->set_temp("busy_timer/dujili", time());
  } else {
    msg = WHT "可是$n" WHT "一提气，整个人从那一片蒺藜上踏了过去！\n" NOR;
    COMBAT_D->do_attack(target, me, TYPE_PERFORM, msg);
  }

  use_tangmen_ammo(me, target);
  me->perform_busy(2);
  return 1;
}

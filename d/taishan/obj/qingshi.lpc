#include <ansi.h>
inherit ITEM;
void create() {
  set_name("青石碎片", ({ "qingshi suipian", "suipian", "stone" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("value", 0);
    set("long",
      "一块从万仙楼溪底石坪上崩落的碎石。断面平整得不像石头，\n"
      "上面有一道浅浅的印子，笔直得像一根绷紧的弦。\n");
  }
  ::init_item();
}

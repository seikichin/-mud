inherit SMART_NPC;
inherit F_VENDOR;
#include <ansi.h>

int ask_kongque();

void create() {
  set_name("欧阳朔", ({ "ouyang shuo" }));
  set("gender", "男性");
  set("age", 39);
  set("title", MAG "紫电青霜阁主人" NOR);
  set("long", "一个穿戴整齐的中年人，举止谈吐优雅。\n");
  set("combat_exp", 2500000);
  set("attitude", "friendly");
  set("class", "beggar");
  set("per", 30);

  set("vendor_goods", ([
    "/obj/generate/commonweapon/50/axe": 20,
    "/obj/generate/commonweapon/50/blade": 20,
    "/obj/generate/commonweapon/50/fist": 20,
    "/obj/generate/commonweapon/50/hammer": 20,
    "/obj/generate/commonweapon/50/spear": 20,
    "/obj/generate/commonweapon/50/staff": 20,
    "/obj/generate/commonweapon/50/sword": 20,
    "/obj/generate/commonweapon/50/throwing": 20,
    "/obj/generate/commonweapon/50/whip": 20,
  ]));

  set("inquiry", ([
    "孔雀翎": (: ask_kongque :),
    "kongque": (: ask_kongque :),
    "kong que ling": (: ask_kongque :),
  ]));

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: auto_smart_fight(50) :),
  }));

  auto_npc_setup("wang", 180, 160, 0, "/obj/weapon/", "fighter_w", "dragonstrike", 1);
  setup();
  carry_object(__DIR__ "obj/oucloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
  ::init();
}

void reset() {
  set("vendor_goods", ([
    "/obj/generate/commonweapon/50/axe": 20,
    "/obj/generate/commonweapon/50/blade": 20,
    "/obj/generate/commonweapon/50/fist": 20,
    "/obj/generate/commonweapon/50/hammer": 20,
    "/obj/generate/commonweapon/50/spear": 20,
    "/obj/generate/commonweapon/50/staff": 20,
    "/obj/generate/commonweapon/50/sword": 20,
    "/obj/generate/commonweapon/50/throwing": 20,
    "/obj/generate/commonweapon/50/whip": 20,
  ]));
}

int ask_kongque() {
  object me = this_player();
  int rumor = me->query_temp("kongquelin/rumor");

  if (rumor < 1) {
    message_vision("$N抬眼看了看$n，淡淡道：孔雀翎？这三个字你都没听人说起过，来问我做什么。\n",
      this_object(), me);
    return 1;
  }
  if (rumor >= 3) {
    message_vision("$N摇了摇头：该说的，我都说了。\n", this_object(), me);
    return 1;
  }

  message_vision("$N放下手里的活计，神色郑重起来：\n", this_object(), me);
  message_vision(HIY "「那盒子，我见过一次。」\n" NOR, this_object(), me);
  message_vision(HIY "「二十年前有位客人带着它进这阁子，我只远远看了一眼。」\n" NOR,
    this_object(), me);
  message_vision(HIY "「盒盖上那只孔雀，眼睛是活的。它盯着你的时候，你连手都抬不起来。」\n" NOR,
    this_object(), me);
  message_vision(HIW "「孔雀山庄三百年的声名，八十里的基业，五百条人命，全搁在那一个小小的盒子上。」\n" NOR,
    this_object(), me);
  message_vision(HIW "「只要孔雀翎还在一天，就没人敢去轻犯孔雀山庄——这个道理，青龙会也一样明白。」\n" NOR,
    this_object(), me);

  me->set_temp("kongquelin/rumor", 3);
  me->set_temp("kongquelin/used", 0);
  tell_object(me, HIG "\n【紫电青霜阁主人的证言，让「孔雀翎」三个字在地牢里传开了】\n" NOR);
  return 1;
}

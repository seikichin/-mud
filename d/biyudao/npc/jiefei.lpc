// 《碧玉刀》—— 独眼龙（劫匪）
// 第一戒：不可惹事生非
// 记录：j1 = 0 走开 / 1 出手救人 / 2 帮凶

inherit NPC;
#include <ansi.h>

void create() {
  set_name("独眼龙", ({ "duyanlong", "du yan long", "bandit" }));
  set("gender", "男性");
  set("age", 34);
  set("long", @LONG
一个满脸横肉的汉子，左眼上盖着块黑布。手里提着一柄缺了口的刀，
刀尖上还沾着点什么。
LONG
  );
  set("attitude", "friendly");
  set("combat_exp", 3000);
  set("bellicosity", 500);
  setup();
  carry_object("/obj/armor/cloth")->wear();
}

void init() {
  object me;

  ::init();
  add_action("do_answer", "answer");
  if (interactive(me = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, me);
  }
}

void greeting(object me) {
  if (!me || environment(me) != environment()) return;
  message_vision(HIR "\n独眼龙一把揪住那商旅的衣领，喝道：\n"
    "「把钱交出来，饶你不死！」\n" NOR, me);
  message_vision(HIW "那商旅抱着个破包袱，瑟瑟发抖。\n" NOR, me);
  tell_object(me, HIG "（answer 住手  /  answer 不管  /  answer 帮忙）\n" NOR);
}

int do_answer(string arg) {
  object me, ob;

  me = this_player();
  if (!me) return 0;
  if (!arg) return notify_fail("你要怎么做？\n");

  if (me->query("biyudao/j1")) {
    tell_object(me, "独眼龙斜了你一眼：「少管闲事。」\n");
    return 1;
  }

  if (arg == "住手" || arg == "救人" || arg == "住手救人") {
    me->set("biyudao/j1", 1);
    me->add("biyudao/trust", 1);
    message_vision(HIW "\n$N上前一步，沉声道：「住手。」\n" NOR, me);
    message_vision(HIR "独眼龙上上下下打量了$N一眼，啐了一口：\n"
      "「晦气。」\n" NOR, me);
    message_vision(HIW "他拖刀退入林中，转眼不见了。\n" NOR, me);
    message_vision(HIY "那商旅跌坐在地上，连连作揖：「多谢恩公！多谢恩公！」\n" NOR, me);
    message_vision(HIW "他起身时，目光在$N的包袱上停了一下——很短，短得像是看错了。\n" NOR, me);
    ob = present("wanglaoshi", environment());
    if (ob) ob->set_temp("saved", 1);
    destruct(this_object());
    return 1;
  }
  else if (arg == "不管" || arg == "走开") {
    me->set("biyudao/j1", 0);
    message_vision(HIW "$N绕过他们，继续向北走去。\n" NOR, me);
    message_vision(HIW "背后传来一声闷哼，$N没有回头。\n" NOR, me);
    return 1;
  }
  else if (arg == "帮忙" || arg == "劫他") {
    me->set("biyudao/j1", 2);
    me->add("biyudao/trust", -1);
    message_vision(HIR "$N拔刀上前，与独眼龙一左一右将那人夹在中间。\n" NOR, me);
    message_vision(HIR "独眼龙哈哈一笑：「兄弟上道！」\n" NOR, me);
    message_vision(HIY "那商旅惊恐地看着$N，像是要把这张脸记下来。\n" NOR, me);
    return 1;
  }

  return notify_fail("（answer 住手 / answer 不管 / answer 帮忙）\n");
}

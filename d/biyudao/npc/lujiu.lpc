// 《碧玉刀》—— 卢九（赛云庄庄主·终局对质）
//
// ★ 核心机制（小说 L1189 + L1218）：
//   ① 承认全部（且确实破过戒）    → 通过
//   ② 否认，但有破戒记录            → 识破
//   ③ 否认，且确实全守戒            → 不算说谎，但“看不出人品” → 不通过
//
// 为什么“全守戒”也不通过：戒条是父亲的经验，但不是答案。
// 什么都躲开的人，没有可以被信任的证据。

inherit NPC;
#include <ansi.h>

void create() {
  set_name("卢九", ({ "lu jiu", "lujiu", "lu" }));
  set("gender", "男性");
  set("age", 58);
  set("title", HIW "赛云庄庄主" NOR);
  set("long", @LONG
一个清瘦的老人，穿着很素净的衣裳，手里换了条新丝巾。
他说话很慢，咳嗽几声才接一句，眼睛却像两把刀子。
LONG
  );
  set("attitude", "friendly");
  set("combat_exp", 100000);
  setup();
  carry_object("/obj/armor/cloth")->wear();
}

void init() {
  object me;

  ::init();
  add_action("do_answer", "answer");
  if (interactive(me = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 3, me);
  }
}

void greeting(object me) {
  if (!me || environment(me) != environment()) return;
  message_vision(HIW "\n卢九换了条新丝巾，轻轻咳嗽两声，缓缓道：\n" NOR, me);
  message_vision(HIW "「四月十五，宝珠山庄。朱二爷做寿，\n"
    "来求亲的少年人里，只有两三个是他的劲敌。\n"
    "你——是哪一路的？」\n" NOR, me);
  message_vision(HIY "他忽然换了话头：\n"
    "「我听说你这一路上，惹过事、交过朋友、赌过钱、\n"
    "和乞丐说过话、信过陌生人的话、还和陌生女人——有没有？」\n" NOR, me);
  tell_object(me, HIG "（answer 是  /  answer 否）\n" NOR);
}

int do_answer(string arg) {
  int broke, trust, i;
  string *js = ({ "biyudao/j1", "biyudao/j2", "biyudao/j3", "biyudao/j4",
                  "biyudao/j5", "biyudao/j6", "biyudao/j7" });
  object me, obj;

  me = this_player();
  if (!me) return 0;
  if (!arg) return notify_fail("你要怎么说？\n");

  if (me->query("biyudao/done")) {
    tell_object(me, "卢九拱手道：「宝珠山庄的客，卢某记下了。」\n");
    return 1;
  }

  /* 统计破戒次数（j = 1 或 2 都算“做了”） */
  broke = 0;
  for (i = 0; i < 7; i++) {
    if (me->query(js[i]) == 1 || me->query(js[i]) == 2) broke++;
  }
  trust = me->query("biyudao/trust");

  if (arg == "是" || arg == "有" || arg == "承认") {
    if (broke == 0) {
      message_vision(HIW "\n$N想了想，如实道：「没有。」\n" NOR, me);
      message_vision(HIY "卢九盯着$N看了很久，缓缓摇头：\n"
        "「一个什么都没做的人，我看不出他的人品。」\n" NOR, me);
      message_vision(HIY "他拄着手杖起身，往庄里去了。\n" NOR, me);
      tell_object(me, HIG "\n【提示】卢九要看的是你的行事，不是你的一尘不染。\n来都来了，总得做点事。\n\n" NOR);
      return 1;
    }

    if (!me->query("biyudao/knife")) {
      message_vision(HIW "\n$N老老实实道：「惹过、赌过、也说过话——\n"
        "可那柄刀，我弄丢了。」\n" NOR, me);
      message_vision(HIY "卢九蹙眉：「送刀的人却丢了刀——\n"
        "那你得先把刀找回来。」\n" NOR, me);
      tell_object(me, HIG "\n【提示】湖畔还有个人，你或许该去见她。\n\n" NOR);
      return 1;
    }

    if (trust < 2) {
      message_vision(HIW "\n$N道：「是，都做过。」\n" NOR, me);
      message_vision(HIY "卢九点点头：「敢认，难得。」\n" NOR, me);
      message_vision(HIY "他却又道：「可你做的这几件，终究不够瞧。\n"
        "——去走走吧，路上的事还没完。」\n" NOR, me);
      return 1;
    }

    /* ★ 通过 */
    me->set("biyudao/done", 1);
    message_vision(HIW "\n$N把一路上的事，一件一件说了出来。\n" NOR, me);
    message_vision(HIY "说到赌坊那一局的时候，卢九忽然打断：\n"
      "「输了多少？」\n" NOR, me);
    message_vision(HIW "$N道：「不记得了。输了就是输了。」\n" NOR, me);
    message_vision(HIC "卢九哈哈大笑，笑得咳嗽起来。\n" NOR, me);
    message_vision(HIC "「赌钱时最容易看出一个人的人品。」\n"
      "「所以我才信你——你绝不会说谎。」\n" NOR, me);
    message_vision(HIW "他接过碧玉刀看了一眼，又递还$N：\n"
      "「刀是好刀。可你这一路上真正带着的东西，\n"
      "比这把刀值钱得多。」\n" NOR, me);
    message_vision(HIY "（真正的武器不是刀，是诚实。）\n" NOR, me);

    REWARD_D->riddle_done(me, "碧玉刀", 10, 1);
    if (QUESTS_D->verify_quest(me, "碧玉刀"))
      QUESTS_D->special_reward(me, "碧玉刀");
    return 1;
  }
  else if (arg == "否" || arg == "没有" || arg == "无") {
    if (broke > 0) {
      message_vision(HIW "\n$N道：「没有。一路上我什么也没做。」\n" NOR, me);
      message_vision(HIR "卢九的丝巾停在手里。\n" NOR, me);
      message_vision(HIR "「是么。」他拍了拍手，屏风后走出个人来——\n" NOR, me);
      if (me->query("biyudao/leak")) {
        message_vision(HIY "何二扶着门框，小声道：\n"
          "「爷，这位客官在店里，把自己家世说了半个时辰。」\n" NOR, me);
      }
      if (me->query("biyudao/cheat")) {
        message_vision(HIY "黄麻子甩着骰子，笑嘻嘻地：\n"
          "「卢爷，这位小兄弟在我台子上动过手。」\n" NOR, me);
      }
      message_vision(HIR "卢九缓缓道：「刀是好刀。可惜拿刀的人，\n"
        "嘴上比手上快。」\n" NOR, me);
      message_vision(HIR "他挥了挥手：「宝珠山庄不缺客人。」\n" NOR, me);
      me->set("biyudao/exposed", 1);
      tell_object(me, HIG "\n【提示】卢九要的不是完人。他若问你，你实说就是。\n"
        "（再 answer 一次）\n\n" NOR);
      return 1;
    }

    message_vision(HIW "\n$N道：「没有。」\n" NOR, me);
    message_vision(HIY "卢九看着$N，慢慢摇了摇头：\n"
      "「你没说谎。可一个什么都没做的人，\n"
      "我看不出他的人品。」\n" NOR, me);
    return 1;
  }

  return notify_fail("（answer 是 / answer 否）\n");
}

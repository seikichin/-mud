#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "巨大的镜子");
  set("long", @LONG
拉起空布幔便露出一面晶莹而巨大的镜子，镜框上镶满了翡翠和珠宝，但就算
这些价值连城的珠宝，也不能掩蔽镜子的光彩，这镜子本身就象是带着神秘的魔力。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "northup": __DIR__ "bedroom",
    "southup": __DIR__ "flower2",
  ]));
  set("objects", ([
    __DIR__ "npc/mirror_soul": 1,
  ]));
  set("no_force", 1);
  set("no_fly", 1);
  set("coor/x", 0);
  set("coor/y", -10);
  set("coor/z", -10);
  setup();

}

//  谜题「镜中之花」-- 第 6 阶段：照见镜中真形（不靠打赢）
void init() {
  add_action("do_zhao", "zhao");
}

int do_zhao(string arg) {
  object me;

  me = this_player();

  if (REWARD_D->check_m_success(me, "镜中之花"))
    return notify_fail("镜中的人影，你早已了然于胸。\n");

  if (REWARD_D->riddle_check(me, "镜中之花") != 5)
    return notify_fail("你凑近镜子，镜面灰蒙蒙的，什么也照不出来。\n");

  message_vision(HIW "\n$N伸手拂去镜上的浮尘……\n" NOR, me);
  tell_object(me, HIW "\n镜中映出的竟不是你的脸。\n\n"
                       "那是一尊石像——眉眼慈悲，嘴角含笑，\n"
                       "正是你在花海深处见过的那一尊。\n\n"
                       "你忽然明白了：镜里那团黑影并不是鬼。\n"
                       "它照见的，是看镜的人自己心里最怕的东西。\n" NOR);
  me->set_temp("guanyin/saw_true", 1);
  REWARD_D->riddle_set(me, "镜中之花", 6);
  tell_object(me, HIC "\n（往上走，去见一见镜子的主人）\n" NOR);
  return 1;
}

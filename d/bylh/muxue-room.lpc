// 《白玉老虎》—— 墓穴 · 格房模板
//
//   格房 short/long 由坐标 (x,y,z) 决定：分区兜底 + 关键格特写。
//   改这里的文字即可直接改变对应格子的 look 结果。

inherit ROOM;
#include <ansi.h>

void create() {}

// ---------------------------------------------------------------
//  分区
// ---------------------------------------------------------------
string region_short(int x, int y) {
  if (y <= 1) return HIC "墓道" NOR;
  if (y == 2 && x <= 6) return HIC "西墓室" NOR;
  if (y == 2 && x >= 8) return HIC "东墓室" NOR;
  if (y == 2) return HIC "墓道" NOR;
  if (y == 3) return HIC "横甬道" NOR;
  if (y == 4) return HIC "甬道" NOR;
  if (y == 5) return HIC "主墓室" NOR;
  if (y == 6) return HIC "竖井" NOR;
  if (y == 7) return HIC "下横道" NOR;
  return HIC "旧墓道" NOR;
}

string region_long(int x, int y) {
  string s;

  if (y <= 1) {
    s = "一段新掘开的墓道。两壁的土还是潮的，指甲一碰就簌簌往下掉。\n"
        "空气闷得发稠，混着一股甜腥气——那是尸气。\n";
    if (y == 0) s += "身后堆着坍下来的新土，来路已经被堵死了。\n";
    return s;
  }

  if (y == 2 && x <= 6) {
    s = "一间窄小的墓室。正中摆着一口没有上漆的薄棺，棺盖斜斜地敞着。\n"
        "棺里的骸骨蜷成一团，两只手还死死抠着棺壁。\n";
    if (x <= 1) s += "再往西，墙就塌了，砖缝里往外渗黑水。\n";
    return s;
  }

  if (y == 2 && x >= 8) {
    s = "一间窄小的墓室。角落里堆着七八个陶罐，罐口都用黄泥封着。\n"
        "拿手一推，罐子就滚开去，里面空空荡荡，只有一股陈年的霉味。\n";
    if (x >= 12) s += "再往东，是一堵渗水的砖墙，走不通了。\n";
    return s;
  }

  if (y == 2) {
    return "墓道在这里稍稍宽了些，两壁的土色也深了一层。\n"
           "墙根下横着一根断了的扁担，扁担头上还缠着半截麻绳。\n";
  }

  if (y == 3) {
    return "一条横贯东西的甬道。壁上插着几支早已熄灭的长明灯，\n"
           "灯油凝成了黑块。甬道顶上，隔几步就刻着一个墨斗形的记号。\n";
  }

  if (y == 4) {
    return "一条窄甬道。地上积着一层浅浅的黑水，踩下去没有声音。\n"
           "墙根处有一道长长的抓痕，一直划到转角——像是有人用指甲拖着走过去的。\n";
  }

  if (y == 5) {
    s = "这里像是整座墓穴的主墓室，比别处宽敞得多。\n"
        "地上整整齐齐排着两列石棺，棺盖上积了厚厚的灰。\n"
        "最中央的地面上，画着一个极大的、已经褪了色的圆。\n";
    if (x <= 1) s += "西边的棺木都空着，棺底凿了一个个拳头大的窟窿。\n";
    return s;
  }

  if (y == 6) {
    return "一口竖井，是从上往下挖的。井壁上凿着一级级的浅坑，可以踩着上下。\n"
           "井底堆着碎砖烂瓦，还有些说不清是什么的黑色碎屑。\n";
  }

  if (y == 7) {
    s = "一条低矮的横道，得低着头才走得过去。\n"
        "头顶的砖缝里一直在滴水，一滴，一滴，敲在石板上，声音被放得很大。\n";
    if (x <= 3) s += "再往西，横道的尽头是一堵死墙。\n";
    else if (x >= 10) s += "再往东，横道的尽头也是一堵死墙。\n";
    return s;
  }

  // y >= 8
  s = "墓穴的尽头。脚下的砖缝里长出细白的草芽——上面就是地面了。\n";
  if (y >= 9) s += "正北方的顶上，透下来一线灰蒙蒙的光。\n";
  return s;
}

// ---------------------------------------------------------------
//  关键格特写
// ---------------------------------------------------------------
mapping maze_cell_desc = ([
  "7,0,0" : ({ HIC "墓道·坍口" NOR,
    "从乱葬岗那道土坎上滑下来，一路滑到这里。\n"
    "头顶的洞口只剩下巴掌大，天光像一根灰白的针，扎在黑里。\n"
    "再往北走几步，就是真正的墓穴深处了。\n" }),

  "1,1,0" : ({ HIC "西墓室·尽头" NOR,
    "墓室尽头的墙上，嵌着半块残碑。碑上的字大多剥落了，\n"
    "剩下的几笔，横平竖直，像是半个「唐」字。\n" }),

  "12,1,0" : ({ HIC "东墓室·尽头" NOR,
    "墙角的陶罐后面，缩着一具小小的骸骨——看骨架，还是个孩子。\n"
    "他的手边，放着一枚磨得发亮的铜钱。\n" }),

  "1,5,0" : ({ HIC "主墓室·西端" NOR,
    "这一排石棺全是空的，棺底凿着窟窿——是「疑冢」。\n"
    "最里侧那口棺材的窟窿边缘，留着一小片被撕下来的衣角。\n" }),

  "7,5,0" : ({ HIC "主墓室·中央" NOR,
    "地上那个褪了色的圆，是用朱砂画的。\n"
    "圆心里是一个墨斗形的图案——和你在大风堂密室那幅舆图上见过的，一模一样。\n"
    "圆的外圈，刻着四个字：\n\n"
    "    白  玉  老  虎\n\n"
    "四个字都被人用刀划过，划得很深，像是恨不得把它们从石头上剜掉。\n" }),

  "3,7,0" : ({ HIC "下横道·西尽头" NOR,
    "死墙。墙上的砖比别处新，砌得也齐整——\n"
    "有人后来动过这堵墙，动完之后，又原样砌了回去。\n" }),

  "10,7,0" : ({ HIC "下横道·东尽头" NOR,
    "死墙。墙角放着一只倒扣的碗，碗底压着三粒骰子。\n"
    "三粒都朝下，点数看不见。\n" }),

  "7,9,0" : ({ HIC "旧墓道·出口" NOR,
    "墓道的尽头，一段塌了的石阶斜斜地指着上面。\n"
    "石阶的缝隙里长满了白草。往上走，就是地面了。\n" }),
]);

// ---------------------------------------------------------------
void setup_room_desc(object room, int length, int width, int height, int x, int y, int z) {
  string key, sn, lg;
  mixed info;

  key = sprintf("%d,%d,%d", x, y, z);
  info = maze_cell_desc[key];

  if (arrayp(info) && sizeof(info) >= 2) {
    sn = info[0];
    lg = info[1];
  } else {
    sn = region_short(x, y);
    lg = region_long(x, y);
  }

  room->set("short", sn);
  room->set("long", lg);
  room->set("map_x", x);
  room->set("map_y", y);
  room->set("map_z", z);

  room->setup();
}

void setup_npc_obj(object room, int length, int width, int height, int x, int y, int z) {
  return;
}

int setup_entry_room() { return 1; }
int setup_exit_room() { return 1; }


// 《白玉老虎》—— 虎山密道 · 格房模板（幕七·虎山行）
//
//   谋略：石壁上的记号是反的 —— 照着走会中伏。
//   唯一解线索：入口段 (4,1,0) 的尸骨。他照着记号走了，
//   中了针，爬回来，死在墙根 —— 墙上留了半句话。

inherit ROOM;
#include <ansi.h>

int do_knock(string arg);


void create() {}

// ---------------------------------------------------------------
//  分区
// ---------------------------------------------------------------
string region_short(int x, int y) {
  if (y >= 9) return HIC "密道·北口" NOR;
  if (y <= 1) return HIC "密道·南口" NOR;
  return HIC "虎山密道" NOR;
}

string region_long(int x, int y) {
  string s;

  s = "一条从山体里凿出来的通道。石壁凿得很粗糙，头顶压得很低，得弯着腰走。\n"
      "空气里有一股土腥味，底下还压着一点很淡的、说不清的味道。\n";

  if (y >= 9) s += "前面透进一线天光。\n";
  else if (y <= 1) s += "石阶的光从身后照进来，把影子拉得很长。\n";
  else s += "每隔几步，石壁上插着一支火把——火把是新的，油还没烧干。\n";

  return s;
}

// ---------------------------------------------------------------
//  关键格
// ---------------------------------------------------------------
mapping maze_cell_desc = ([
  "4,0,0" : ({ HIC "密道·南口" NOR,
    "一道石阶从上面垂下来，阶缝里漏进一线灰白的天光。\n"
    "再往南，就是狮子林那片石头。\n"
    "往 north，通道一直伸进黑里。\n" }),

  "4,1,0" : ({ HIC "密道·墙根" NOR,
    "通道在这里宽了一点。\n\n"
    "墙根下坐着一个人。\n\n"
    "——说「坐着」其实不准确。他是靠着墙的，两条腿伸得很直，头垂在胸前。\n"
    "衣裳还是整整齐齐的，只是颜色已经发暗。\n\n"
    "他右手攥着一截断剑。剑尖在石壁上划过，留下两行字，刻得很浅，\n"
    "像是用尽了最后一点力气：\n\n"
    "    他  们  指  的  路\n"
    "    是  死  的\n\n"
    "最后一个「的」字只刻了一半。\n\n"
    "他的左腿上，钉着一根针。针尾是青的。\n" }),

  "4,3,0" : ({ HIC "密道·西岔" NOR,
    "石壁在这里错开，分出一条向西的岔道。\n\n"
    "岔道口的石壁上刻着一个记号——一个箭头，指着西边。\n"
    "箭头的旁边还有半个字，像是「生」。\n\n"
    "刻痕很深，很新。\n" }),

  "6,5,0" : ({ HIC "密道·东岔" NOR,
    "通道在这里分出一股，往东去。\n\n"
    "东边那个洞口的上方，石壁上刻着四个字：\n\n"
    "    此  路  可  行\n\n"
    "字是正楷，一笔一划，刻得端端正正。\n" }),

  "3,7,0" : ({ HIC "密道·深岔" NOR,
    "这里又分出一条岔道，往西去。\n\n"
    "岔道口的石壁上，刻着一只脚印。\n"
    "脚印是朝西的，脚趾头刻得很清楚。\n\n"
    "脚印的下面，压着另外一道刻痕——被人用石头凿掉了，凿得很急。\n" }),

  "3,3,0" : ({ HIC "西岔·尽头" NOR,
    "你往里走了七八步。\n\n"
    "通道忽然断了——前面是一面凿得很平的石壁，没有门，也没有缝。\n\n"
    "你正要回头。\n" }),

  "7,5,0" : ({ HIC "东岔·尽头" NOR,
    "通道往东一拐，就到了尽头。\n\n"
    "前面是一间小屋大小的石室，石室正中摆着一只木箱，箱盖开着。\n"
    "你走近看了一眼——箱子里是空的。\n\n"
    "你正要回头。\n" }),

  "2,7,0" : ({ HIC "深岔·尽头" NOR,
    "通道在这里往下沉了一截，尽头是一片乱石。\n\n"
    "乱石堆里露出半只靴子。靴子还在，脚已经不在了。\n\n"
    "你正要回头。\n" }),

  "3,8,0" : ({ HIC "密道·薄壁" NOR,
    "这一段通道比别处宽，石壁的颜色也浅一些。\n\n"
    "你伸手按了按——石壁是凉的。但按下去的时候，指尖感觉到一丝极细的震动。\n\n"
    "墙那边，有声音。\n\n"
    "不是风。是脚步声。\n"
    "有一个人，在墙那边来回地走。\n" }),

  "3,9,0" : ({ HIC "密道·北口" NOR,
    "通道在这里到了头。\n\n"
    "前面是一道低矮的石门，门半开着，外面透进天光。\n"
    "门缝里能看见一线青色的天，和几根摇着的草。\n" }),
]);

// ---------------------------------------------------------------
void setup_room_desc(object room, int length, int width, int height, int x, int y, int z) {
  string key, sn, lg;
  mixed info;

  key = sprintf("%d,%d,%d", x, y, z);
  info = maze_cell_desc[key];

  if (arrayp(info) && sizeof(info) >= 2) {
    sn = info[0];
    lg = info[1];
  } else {
    sn = region_short(x, y);
    lg = region_long(x, y);
  }

  room->set("short", sn);
  room->set("long", lg);
  room->set("map_x", x);
  room->set("map_y", y);
  room->set("map_z", z);

  if (x == 4 && y == 1) {
    room->set("item_desc", ([
      "尸骨" : "他死了很久了。皮肉已经干了，贴在骨头上。\n\n"
               "左腿上那根针，针尖是从里往外透的——它射进来的时候，他是背对着的。\n"
               "也就是说：他当时正在往回走。\n\n"
               "他右手那截断剑的剑刃上，刻着一个很小的字：「唐」。\n",
      "针"   : "一根细针，针尾发青。\n"
               "唐门的暗器里，这种最小，也最阴。\n",
      "字"   : "「他们指的路，是死的。」\n"
               "刻得很浅。最后一个字只刻了一半——\n"
               "他就死在这半笔上。\n",
      "断剑" : "半截剑。断口不平，是砸断的。\n"
               "剑柄上缠的布已经烂了，露出里面的木胎。\n",
    ]));
  }
  else if (x == 4 && y == 3) {
    room->set("item_desc", ([
      "记号" : "箭头指着西边。\n"
               "刻痕很深，是新的——凿面上的石粉还没被火把的烟熏黑。\n"
               "刻它的人，不怕别人看见。\n",
      "箭头" : "指西。\n"
               "用力很猛，一凿到底，是个使惯了刀的人凿的。\n",
    ]));
  }
  else if (x == 6 && y == 5) {
    room->set("item_desc", ([
      "字"   : "「此路可行」四个字，正楷，端端正正。\n\n"
               "刻痕也是新的。而且——\n"
               "这四个字最后那一竖收笔的时候，微微往上挑了一下。\n"
               "刻这几个字的人，写得很轻松。\n"
               "太轻松了。\n",
    ]));
  }
  else if (x == 3 && y == 7) {
    room->set("item_desc", ([
      "脚印" : "脚趾头朝西。刻得很深。\n\n"
               "脚印底下压着另外一道刻痕——被人用石头凿掉了。\n"
               "凿得很急，还剩一点尾巴没凿干净。\n"
               "那尾巴看上去，原来像是刻着「不」字的一横。\n",
    ]));
  }

  room->setup();
}

void setup_npc_obj(object room, int length, int width, int height, int x, int y, int z) {
  return;
}

int setup_entry_room() { return 1; }
int setup_exit_room() { return 1; }

// ---------------------------------------------------------------
//  进入
// ---------------------------------------------------------------
void init() {
  if (query("map_x") == 3 && query("map_y") == 8)
    add_action("do_knock", "敲");
}

// 岔路口的机关：往「记号指的方向」走 = 中伏
int valid_leave(object me, string dir) {
  if (!me || !interactive(me)) return 1;

  if ((query("map_x") == 4 && query("map_y") == 3 && dir == "west")
   || (query("map_x") == 6 && query("map_y") == 5 && dir == "east")
   || (query("map_x") == 3 && query("map_y") == 7 && dir == "west")) {

    me->receive_damage("kee", 25);
    return notify_fail(HIR "你刚踏出半步——\n\n"
      "石壁顶上一个小孔里，忽然射出一线寒光！\n\n" NOR
      "你猛地偏头，一根细针擦着耳根钉进身后的石壁，针尾还在抖。\n\n"
      "你退回了原位。\n" NOR);
  }

  return 1;
}


// 敲石壁 —— 声东击西
int do_knock(string arg) {
  object me = this_player();

  if (arg && arg != "" && arg != "石壁" && arg != "壁")
    return 0;

  if (me->query_temp("bylh/hs_decoy")) {
    write("墙那边已经没有人了。\n");
    return 1;
  }

  write("你屈起指节，在石壁上敲了三下。\n\n"
        "「咚、咚、咚」——声音是空的，一直传到很远的地方去。\n\n"
        "墙那边的脚步声，停了。\n\n"
        "过了片刻，忽然响起一阵急促的奔走——朝东边去了。\n"
        "再往后，什么声音也没有了。\n\n"
        HIY "你收住手，退回到通道里。\n" NOR);

  me->set_temp("bylh/hs_decoy", 1);
  return 1;
}

// 陷阱机制由 valid_leave 实现（call_out 在本环境不可靠，已弃用）


// 《白玉老虎》—— 江湖路 · 格房模板
//
//   格房 short/long 由坐标 (x,y,z) 决定：分区兜底 + 关键格特写。
//   改这里的文字即可直接改变对应格子的 look 结果。

inherit ROOM;
#include <ansi.h>

void create() {}

// ---------------------------------------------------------------
//  分区
// ---------------------------------------------------------------
string region_short(int x, int y) {
  if (y <= 3) return HIC "废驿道" NOR;
  if (y == 4 || y == 5) return HIG "官道" NOR;
  if (y == 6) return HIG "官道口" NOR;
  if (y >= 7 && y <= 9 && x <= 6) return HIY "吉祥镇·赌坊街" NOR;
  if (y >= 7 && y <= 9) return HIY "吉祥镇·市集" NOR;
  if (y == 10) return HIR "巷口" NOR;
  if (y == 11) return HIR "辣椒巷" NOR;
  if (y >= 12) return HIW "唐家镇·西门" NOR;
  return "街巷";
}

string region_long(int x, int y) {
  string s;

  if (y <= 3) {
    s = "一条荒废了的驿道，两旁是半人高的枯草。拂面的风里带着土腥气。\n"
        "道上没有车辙，也没有脚印——这条路已经很久没有人走过了。\n";
    if (y >= 2) s += "北边隐约横着一条大路，青石板铺的。\n";
    else s += "往南一片漆黑，来路已经看不见了。\n";
    return s;
  }

  if (y == 4 || y == 5) {
    s = "一条贯通南北的官道，青石板铺得整整齐齐，能并排走四辆马车。\n"
        "路旁立着一块界碑，碑上的字已被风雨磨平，只剩下一个「祥」字。\n";
    if (y == 5) s += "往北，隐约可见镇子的屋脊；往南是空荡荡的大路。\n";
    else s += "路侧偶有野狗跑过，见了人也不叫，只低头夹着尾巴走了。\n";
    return s;
  }

  if (y == 6) {
    return "官道在这里分出两条岔路，一条向西，一条向东，都通向吉祥镇。\n"
           "岔路口的土地庙已经塌了半边，神像的脸上落满了灰。\n";
  }

  if (y >= 7 && y <= 9 && x <= 6) {
    s = "吉祥镇的赌坊街。天还没黑，家家门前就挂上了红灯笼。\n"
        "门帘里传出骰子落碗的声响，一声接着一声，像是永远也不会停。\n";
    if (x <= 2) s += "街西头有一盏灯，比别家的都亮。\n";
    else if (x >= 5) s += "街东头人声更杂，那里通着市集。\n";
    return s;
  }

  if (y >= 7 && y <= 9) {
    s = "吉祥镇的市集。卖艺的、算命的、卖膏药的，摊子一个挨着一个。\n"
        "叫卖声很热闹，可奇怪的是——没有一个人抬眼看你。\n";
    if (x >= 13) s += "东边有一条窄巷的入口，巷口挂着成串的红辣椒。\n";
    return s;
  }

  if (y == 10) {
    return "这是从镇子通往辣椒巷的一个出口，两边都是高墙，风从巷子里灌出来，\n"
           "带着一股呛人的辣味。\n";
  }

  if (y == 11) {
    s = "一条极窄的巷子。两边的墙高得几乎看不见天，只留一线灰白。\n"
        "墙上挂满了成串的红辣椒，风一吹，辣味直往鼻子里钻。\n"
        "据说唐门的人，就住在这条巷子的尽头。\n";
    if (x <= 2) s += "巷子西头安静得反常，连风都停了。\n";
    else if (x >= 13) s += "巷子东头有一扇门，门后似乎有人在等你。\n";
    return s;
  }

  // y >= 12
  s = "唐家镇的西门。说是城门，其实只是一道岗哨。\n"
      "青石板大道笔直地伸向北面，路的尽头是一堵里许长的红墙。\n";
  if (y >= 13) s += "两个唐门弟子按着刀立在门边，目光像针一样盯过来。\n";
  else s += "墙上贴着几张通缉告示，风吹得纸角哗哗作响。\n";
  return s;
}

// ---------------------------------------------------------------
//  关键格特写
// ---------------------------------------------------------------
mapping maze_cell_desc = ([
  "3,5,0" : ({ HIG "官道·岔口" NOR,
    "官道西侧，一条羊肠小道岔进坡下。\n"
    "道口歪着一块木牌，上面的字被雨水淋花了，只余下两个字：\n\n"
    "    乱  葬\n\n"
    "小道尽头的坡上，一片乌压压的坟包。\n"
    "（往 enter 方向可下小道）\n" }),

  "7,0,0" : ({ HIC "废驿道·南头" NOR,
    "驿道到这里就到了头。南面是一道半塌的土坎，坎下黑黢黢的，看不出深浅——\n"
    "你方才就是从那里钻出来的。\n"
    "往北，枯草渐渐稀疏，隐约能看见一条横着的大路。\n" }),

  "7,2,0" : ({ HIC "废驿道·北口" NOR,
    "枯草在这里断了，前面就是官道。\n"
    "官道上车辙很深，是新压出来的——这两天，有大队人马从这条路过去了。\n" }),

  "3,8,0" : ({ HIY "吉祥镇·赌坊街" NOR,
    "赌坊的门帘是半旧的青布，掀开一条缝，里头乌烟瘴气。\n"
    "门楣上挂着一块匾，四个字：\n\n"
    "    一  掷  千  金\n\n"
    "匾上的金漆已经剥落了大半，可那个「千」字，反倒是越看越亮。\n"
    "（往 enter 方向可掀帘进去）\n" }),

  "12,8,0" : ({ HIY "吉祥镇·市集" NOR,
    "市集最热闹的地方摆着一个算命摊子。\n"
    "摊后坐着个瞎子，面前的旗子上写着「铁口直断」。\n"
    "你走过去的时候，那瞎子忽然抬起头，朝着你的方向笑了笑。\n"
    "再往东，是一道半塌的土墙，墙外堆着一大片石头。\n"
    "（往 enter 方向可出城去）\n" }),

  "7,11,0" : ({ HIR "辣椒巷" NOR,
    "巷子正中间。两边的红辣椒一直挂到头顶，像两道红色的帘子。\n"
    "地上很干净——干净得不像话。\n"
    "这么窄的巷子，这么密的辣椒，却连一片落叶都没有。\n"
    "巷子尽头有一扇黑漆木门，虚掩着。\n"
    "（往 enter 方向可推门进去）\n" }),

  "0,11,0" : ({ HIR "辣椒巷·西头" NOR,
    "巷子在这里拐了个弯，通向一片幽深的宅院。\n"
    "墙角蹲着一只黑猫，见你来了，只眯了眯眼，没有动。\n" }),

  "15,11,0" : ({ HIR "辣椒巷·东头" NOR,
    "巷子到这里就封死了，只有一扇黑漆木门。\n"
    "门上没有门环，也没有门缝。\n"
    "你若要走，只能原路回去。\n" }),

  "7,13,0" : ({ HIW "唐家镇·西门" NOR,
    "西门的岗哨前，一名唐门弟子的手一直按在刀柄上。\n"
    "他看了你一眼，把你的脸、你的手、你腰间的兵器，都看了一遍。\n"
    "然后他什么也没说，只是侧了侧身子，让开了半步。\n" }),
]);

// ---------------------------------------------------------------
void setup_room_desc(object room, int length, int width, int height, int x, int y, int z) {
  string key, sn, lg;
  mixed info;

  key = sprintf("%d,%d,%d", x, y, z);
  info = maze_cell_desc[key];

  if (arrayp(info) && sizeof(info) >= 2) {
    sn = info[0];
    lg = info[1];
  } else {
    sn = region_short(x, y);
    lg = region_long(x, y);
  }

  room->set("short", sn);
  room->set("long", lg);
  room->set("map_x", x);
  room->set("map_y", y);
  room->set("map_z", z);

  room->setup();
}

void setup_npc_obj(object room, int length, int width, int height, int x, int y, int z) {
  return;
}

int setup_entry_room() { return 1; }
int setup_exit_room() { return 1; }
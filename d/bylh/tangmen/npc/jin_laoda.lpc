// 《白玉老虎》蜀中唐门 · 金老大

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("金老大", ({ "金老大", "jin laoda", "jinlaoda" }));
  set("gender", "男性");
  set("age", 52);
  set("long",
    "这个人长得本来不好看。\n\n他的肩特别宽，骨架特别大，衣服一脱下来，只剩下一张皮包着骨头。\n\n他的脸看来好像是蓝的，就像是块已经快洗得发白的蓝布。\n\n这十年来，他差不多每隔一两个月就要挨别人一两次打——\n不过能在他手上占到便宜的人，还一个都没有。\n"
  );
  set("combat_exp", 5000000);
  set("class", "tangmen");
  create_family("唐门", 4, "客卿");
  set("attitude", "peaceful");
  set("apprentice_available", 20);
  set("ranks", ({
    "铁手学徒", "铁手门人", "铁手弟子", "横练弟子", "铁手好手",
    "唐门好手", "唐门高手", "唐门执事", "唐门香主", "唐门堂主",
    "唐门护法", "唐门长老", "执掌长老", "副堡主", "堡主",
    HIY "唐门家主" NOR
  }));
  set("rank_levels", ({
    16000, 32000, 64000, 128000, 256000, 512000, 1024000, 1536000,
    2048000, 3064000, 4096000, 5120000, 6144000, 8192000, 9999999
  }));
  set("inquiry", ([
    "拜师" :
      "唐门一辈一辈地往上走。\n想拜我，先去教头那里练出个样子 —— 投掷（throwing）过了八十级，再来。\n",
    "出师" :
      "我这身横练，是挨了十年打练出来的。\n你若能打赢我，就可以去拜更高一辈的师傅。\n",
    "大小姐" :
      "她若少一根头发，我就陪你一起死。\n",
    "唐傲" :
      "（他指着自己胸膛上一道剑痕）\n他刺了我这一剑，我根本完全没有还手的余地。\n世界上没有几个人见过那样的剑法。\n",
    "金老大" :
      "我从前有个外号叫「大力金刚神」。\n\n这十年来，我最少已经瘦了一两百斤。\n",
    "挨打" :
      "我挨了别人一掌，别人也要挨我一招。\n\n我挨他一掌虽然很不好受，他挨我那一招，却足足在床上躺了半年。\n",
  ]));

  set_skill("move", 150);
  set_skill("unarmed", 180);
  set_skill("force", 180);
  set_skill("dodge", 150);
  set_skill("parry", 180);
  set_skill("throwing", 170);
  set_skill("tangmen-anqi", 150);


  setup();
  carry_object("/d/bylh/tangmen/obj/tangmen-robe")->wear();
  carry_object("/d/bylh/tangmen/obj/tangmen-claw")->wield();
}

// 拜师：唐门弟子、男性、由教头处出师、投掷过八十级
void attempt_apprentice(object me) {
  if (me->query("class") != "tangmen") {
    command("say 唐门的门，不是随便进的。");
    return;
  }
  if (me->query("gender") != "男性") {
    command("say 我这套横练功夫，只传男弟子。");
    command("say 女弟子去找一丈红罢。");
    return;
  }
  if (!me->query_temp("won_master_jiaotou")) {
    command("say 先去练武场，赢了教头一只手，再来找我。");
    return;
  }
  if ((int)me->query_skill("throwing", 1) <= 80) {
    command("shake");
    command("say 你的手还不够快 —— 投掷至少要过八十级。");
    tell_object(me, "（需投掷（throwing）八十级以上，且已赢过唐门教头）\n");
    return;
  }
  command("pat " + me->query("id"));
  command("say 好，从今日起，你跟我练挨打。");
  command("recruit " + me->query("id"));
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "tangmen");
}

int accept_fight(object me) {
  if (me->query("class") != "tangmen") {
    command("say 外人要动手，先过唐家堡的大门。\n");
    return 0;
  }

  if (is_fighting()) {
    command("say 想倚多为胜？练武场上的木人还没打够么。\n");
    return 0;
  }

  if ((int)query("gin") * 10 >= (int)query("max_gin") * 9
    && (int)query("kee") * 10 >= (int)query("max_kee") * 9
    && (int)query("sen") * 10 >= (int)query("max_sen") * 9) {
    command("say 好 —— 你若能赢我一只手，就可以去拜更高一辈的师傅！\n");
    me->set_temp("marks/fi_jinlaoda", 1);
    return 1;
  }

  command("say 好，不过，先养好了伤再动手。\n");
  return 0;
}

void win_enemy(object loser) {
  if (loser->query_temp("marks/fi_jinlaoda")) {
    command("say 拳头还不够硬。回去再挨几年打！\n");
    loser->delete_temp("marks/fi_jinlaoda");
  }
}

void lose_enemy(object winner) {
  if (winner->query_temp("marks/fi_jinlaoda")) {
    command("say 好，你的拳头，比我的硬了。\n");
    command("say 上一辈的师傅，在唐家堡里等着你。\n");
    winner->set_temp("won_master_jinlaoda", 1);
    winner->delete_temp("marks/fi_jinlaoda");
  }
}

void init() {
  ::init();
  add_action("do_killing", "kill");
}

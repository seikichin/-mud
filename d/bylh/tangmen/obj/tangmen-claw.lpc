// 《白玉老虎》蜀中唐门 · 唐门银丝爪
//
//   唐门里有些身份的人用的家伙，爪上镶着细细的银丝。

#include <weapon.h>
#include <ansi.h>
inherit FIST;

void create() {
  set_name(HIW "唐门银丝爪" NOR, ({ "tangmen claw", "claw" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "一对钢爪，爪背上缠着细细的银丝，缠得极匀极密。\n这东西不出手则已，一出手就要见血。\n");
    set("value", 5);
    set("material", "steel");
  }
  init_fist(10);
  set("wield_msg", "$N从袖中摸出一对$n，缓缓套在指上。\n");
  set("unwield_msg", "$N将手上的$n褪下来，收进袖里。\n");
}

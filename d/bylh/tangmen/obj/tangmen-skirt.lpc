// 《白玉老虎》蜀中唐门 · 唐门罗裙
//
//   唐门女眷的衣裳。

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name("唐门罗裙", ({ "tangmen skirt", "skirt" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("material", "cloth");
    set("female_only", 1);
    set("long", "一条藕荷色的罗裙，裙边压着一道细细的银线。\n裙下藏着什么，谁也看不出来。\n");
    set("value", 5);
    set("armor_prop/armor", 3);
  }
  ::init_cloth();
}

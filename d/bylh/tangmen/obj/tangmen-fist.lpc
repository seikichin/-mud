// 《白玉老虎》蜀中唐门 · 唐门铁指套
//
//   唐门子弟练手劲用的铁指套，指节处都磨得发亮。
//   拳脚功夫，配着暗器一起使。

#include <weapon.h>
inherit FIST;

void create() {
  set_name("唐门铁指套", ({ "tangmen fist", "fist" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "一对精铁打的指套，指节处都磨得发亮。\n唐门子弟练手劲，先练这个。\n");
    set("value", 5);
    set("material", "steel");
  }
  init_fist(5);
  set("wield_msg", "$N从袖中摸出一对$n，套在指上。\n");
  set("unwield_msg", "$N将手上的$n褪下来，收进袖里。\n");
}

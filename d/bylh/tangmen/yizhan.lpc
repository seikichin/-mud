// 《白玉老虎》蜀中唐门 · 唐家堡 · 驿站

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIW "唐家堡·驿站" NOR);
  set("long", @LONG
唐家堡东南角的一处偏院。

院里停着一辆乌木马车，车帘低垂。四匹枣红马拴在廊下，
正低头嚼着草料，偶尔打个响鼻。

车辕上坐着个穿青布短打的汉子，手里捏着一条鞭子，
眯着眼 —— 也不知是真睡着了，还是在等什么人。

门边的墙上挂着一块木牌。
LONG
  );
  set("no_fly", 1);
  set("objects", ([
    __DIR__ "npc/tang_chefu" : 1,
  ]));
  set("item_desc", ([
    "墙" : "青砖砌的院墙，墙根下堆着些铡碎的草料。\n",
    "木牌" : @TEXT
唐门驿站 · 车马规条

（一）出堡远行：纹银八两。（rent mache）
（二）车出唐家堡，直往风云驿站，中途不停。
（三）本驿的车，不拉外人。
TEXT
  ]));
  set("exits", ([
    "northwest" : __DIR__ "street",
  ]));
  setup();
}

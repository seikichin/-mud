inherit ROOM;
#include <ansi.h>

void create() {
  set("short", GRN "后院" NOR);
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "mafang",
    "south" : __DIR__ "yangjia",
  ]));
  set("no_fly", 1);
  setup();
}
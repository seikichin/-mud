// 原 coor(1520,-1020,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "烟雨楼顶");
  set("long", @LONG
这里是烟雨楼的楼顶，放眼一片空阔，东西两湖如鸳鸯交颈，轻烟
拂渚，微雨欲来，晓霭迷蒙，正是历代文人骚客把酒凭栏、吊古吟咏的
好所在。
LONG );
  set("exits", ([
    "down" : __DIR__ "3/7/1",
  ]));
  set("no_fly", 1);
  setup();
}
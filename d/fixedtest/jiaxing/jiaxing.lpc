// jiaxing —— nitan d/jiaxing 固定地图映射区（vrm_fixed）
//
//   jiaxing.map         地图（方向位掩码 + [LINK] 特殊出口）
//   jiaxing-room.lpc    格房描述（改文字即可改每格 look）
//   jiaxinggate.lpc / jiaxinggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/jiaxing/jiaxing/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = jiaxing）
// 格索引 -> 原 coor： coor = (格索引 + (118,-186,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "jiaxing-room");
  set_maze_map(__DIR__ "jiaxing");
  set_maze_spacing(10);
  set_maze_owner_key("jiaxing");

  // 入口 = jnroad1（格 0,10,0），出口 = chating（格 2,7,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "jiaxinggate");
  set_link_exit_room(__DIR__ "jiaxinggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(1240);
  set_link_entry_room_y(-1810);
  set_link_entry_room_z(30);

  set_entry_short(HIW "山路" NOR);
  set_entry_desc("山路，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "茶亭" NOR);
  set_exit_desc("茶亭，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 jiaxing-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("山路");
  set_maze_room_desc("nitan d/jiaxing 映射区。");
}
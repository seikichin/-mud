// didao1 —— 由 nitan/d/mingjiao/didao1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(210,80,90)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "明教地道");
  set("long", " ");
  set("exits", ([
    "out" : __DIR__ "neishi",
  ]));
  set("no_fly", 1);
  setup();
}
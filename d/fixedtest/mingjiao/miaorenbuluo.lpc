// miaorenbuluo —— 由 nitan/d/mingjiao/miaorenbuluo.c 转换（独立房间，不在固定地图网格内）
// 原 coor(120,110,80)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "苗人部落");
  set("long", @LONG
你眼前突然一亮，原来是走进了一个苗人部落。苗人们围坐在火
堆边，面色虔诚，好象在作某种祭神仪式。几个巫士挥舞着木镗，口
中念念有词。突然，他们好象发现了你。
LONG );
  set("exits", ([
    "north" : __DIR__ "westroad2",
  ]));
  set("no_fly", 1);
  setup();
}
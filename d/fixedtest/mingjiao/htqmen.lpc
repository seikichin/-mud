inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "厚土旗门");
  set("long", @LONG
这是厚土旗的洞门，门洞里进进出出的厚土旗众，身上挂满了锹，
铲，短刀，谁也不理你。门边两面短杆镶黄边飞龙旗，绣着厚土二字。
LONG );
  set("exits", ([
    "enter" : __DIR__ "htqdating",
    "south" : __DIR__ "tohtq7",
  ]));
  set("no_fly", 1);
  setup();
}
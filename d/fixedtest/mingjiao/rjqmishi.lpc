// rjqmishi —— 由 nitan/d/mingjiao/rjqmishi.c 转换（独立房间，不在固定地图网格内）
// 原 coor(250,70,80)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "密室");
  set("long", " ");
  set("exits", ([
    "down" : __DIR__ "24/6/8",
    "south" : __DIR__ "rjqjiguan",
  ]));
  set("no_fly", 1);
  setup();
}
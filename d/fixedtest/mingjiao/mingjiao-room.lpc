//  mingjiao-room.lpc  ——  nitan d/mingjiao 映射区（43x12x11）房间模板
//  由 nitan_build.aardio 自动生成，可自由修改文字
//
//  数据表 maze_cell_desc 的键 = 格索引 ""x,y,z""（从 0 开始，与 mingjiao.map 一致）
//  值 = ({ 短描述, 长描述 })
//  改这里的文字即可直接改变对应格子的 look 结果。
//
//  原 coor 与格索引的换算： coor = (格索引 + (1,0,0)) * 10
//  一格多间房时：短描述取主房，长描述按房间拼接（源房名见行末注释）
//
//  short/long 保留 nitan 原文的 LPC 表达式（heredoc / 颜色宏），
//  因此 ANSI 颜色（HIW / HIY / NOR 等）与原文完全一致。
// ============================================================

inherit ROOM;
#include <ansi.h>

void create() {}

// 格索引 -> ({ short, long })
mapping maze_cell_desc = ([
  "12,0,0" : ({ "悬天崖", @LONG
这里山路陡峭，仅有一人多宽，路左是峭壁高耸，路右紧临万丈
深渊，实在是一夫当关、万夫莫开的险要之处。继续上攀，就要到达
明教五行旗了。紧挨路右，天然生有一块巨石，高近三丈，名为『悬
天石』，常有侠客于上远观云海。
LONG  }),  // coor(130,0,0)  shanlu3
  "12,0,1" : ({ "悬天石", " " }),  // coor(130,0,10)  xuantianshi
  "12,1,1" : ({ "青石阶", @LONG
这里山路渐宽，青石铺路，苔痕淡青，路左青松巍巍，路右藤萝
绕树，远远的，只见前方房宇依稀，赤红色旗帜招展，听说明教烈火
旗在此据守，数百年来固如磐石。
LONG  }),  // coor(130,10,10)  shanlu4
  "12,2,2" : ({ "烈火旗牌坊", @LONG
这里是昆仑山南麓的一片开阔地，四周山崖环抱，青木遮天，正
对路中的是一座大红牌坊。穿过牌坊，是一片红砖红瓦，遍插镶红团
龙旗，路边齐齐站立两排教众，整个山谷中好似烈焰蒸腾，红雾遍野，
实在是江湖中一般门派所没有的壮观景象。由此向东北折转，大路直
通锐金旗；由此向西北而行，则为巨木旗。三旗承犄角鼎立之势，以
巩固明教外围。
LONG  }),  // coor(130,20,20)  lhqpaifang
  "11,3,2" : ({ "青石大道", @LONG
这里是通往巨木旗的大道。道路开阔，大概可容十人并肩而行。
现在巨木旗是明教五旗中人数最多，机关构筑最杂的。除了守护明教
外围，还负责明教中所有房屋和栈桥的建造。
LONG  }),  // coor(120,30,20)  tojmq1
  "13,3,2" : ({ "青石大道", @LONG

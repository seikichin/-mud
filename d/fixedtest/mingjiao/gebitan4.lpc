// gebitan4 —— 由 nitan/d/mingjiao/gebitan4.c 转换（独立房间，不在固定地图网格内）
// 原 coor(80,100,80)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "戈壁滩");
  set("long", @LONG
眼前是一望无际的戈壁滩，没有路标，也没有一个行人，天显得
很高，远山披雪，苍鹰翱翔，走在这茫茫戈壁之上，你似乎迷路了。
LONG );
  set("exits", ([
    "south" : __DIR__ "8/10/8",
    "north" : __DIR__ "gebitan5",
    "east" : __DIR__ "gebitan4",
    "west" : __DIR__ "gebitan4",
  ]));
  set("no_fly", 1);
  setup();
}
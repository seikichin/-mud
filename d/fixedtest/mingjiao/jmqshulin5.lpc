// jmqshulin5 —— 由 nitan/d/mingjiao/jmqshulin5.c 转换（独立房间，不在固定地图网格内）
// 原 coor(300,60,80)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "巨木旗树林");
  set("long", @LONG
你眼前骤然一暗，朦胧中，只见左右前后，到处都是铺天盖地的
不知名的巨树，好象松柏，又似冷杉，簇在一起，密实的枝叶象一蓬
蓬巨伞恒伸向天空，遮天蔽日。你似乎迷失了方向，象没头苍蝇般到
处乱闯。
LONG );
  set("exits", ([
    "south" : __DIR__ "jmqshulin5",
    "north" : __DIR__ "jmqshulin5",
    "east" : __DIR__ "jmqshulin5",
    "west" : __DIR__ "jmqshulin6",
  ]));
  set("no_fly", 1);
  setup();
}
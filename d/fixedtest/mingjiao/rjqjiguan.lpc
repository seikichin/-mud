inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "密道");
  set("long", @LONG
这里是一条秘道的尽头，石墙之上嵌入两盏油灯，火苗幽蓝，向
北望去，黑暗中有些光亮。
LONG );
  set("exits", ([
    "north" : __DIR__ "rjqmishi",
  ]));
  set("no_fly", 1);
  setup();
}
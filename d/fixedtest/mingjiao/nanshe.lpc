// nanshe —— 由 nitan/d/mingjiao/nanshe.c 转换（独立房间，不在固定地图网格内）
// 原 coor(30,90,80)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "天门男舍");
  set("long", @LONG
走进这间男舍，一阵汗臭酒熏扑面，根本挥赶不去。几个五大三
粗汉子光脚神气赳赳，豪迈异常地喊你入席。桌上酒水淋漓，杯盘狼
籍，显然都喝得差不多了。
LONG );
  set("exits", ([
    "out" : __DIR__ "3/9/8",
  ]));
  set("no_fly", 1);
  setup();
}
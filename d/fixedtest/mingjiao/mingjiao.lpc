// mingjiao —— nitan d/mingjiao 固定地图映射区（vrm_fixed）
//
//   mingjiao.map         地图（方向位掩码 + [LINK] 特殊出口）
//   mingjiao-room.lpc    格房描述（改文字即可改每格 look）
//   mingjiaogate.lpc / mingjiaogate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/mingjiao/mingjiao/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = mingjiao）
// 格索引 -> 原 coor： coor = (格索引 + (1,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "mingjiao-room");
  set_maze_map(__DIR__ "mingjiao");
  set_maze_spacing(10);
  set_maze_owner_key("mingjiao");

  // 入口 = hsqtan6（格 36,4,7），出口 = huangtulu2（格 0,10,10）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "mingjiaogate");
  set_link_exit_room(__DIR__ "mingjiaogate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(220);
  set_link_entry_room_y(60);
  set_link_entry_room_z(120);

  set_entry_short(HIW "深潭" NOR);
  set_entry_desc("深潭，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "黄土小路" NOR);
  set_exit_desc("黄土小路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 mingjiao-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("深潭");
  set_maze_room_desc("nitan d/mingjiao 映射区。");
}
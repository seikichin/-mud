// shanpo6 —— 由 nitan/d/baihuagu/shanpo6.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-390,-370,-10)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", GRN"山谷中"NOR);
  set("long", HIY"这是一面山谷。由于山坡向南，阻住了山风，加之地下矿藏
丰富，所以地气极暖，百花先放。此处架着几个木架，托着七八
个蜂巢。但见群蜂争舞，到处都是嗡嗡声，给静谧的山谷带来了
无限生气。山谷中高树林立，还有很多灌木，想来谷中物产极多，
偶尔可见一两个挖掘草药的农人。\n"NOR);
  set("exits", ([
    "westup" : __DIR__ "5/2/1",
  ]));
  set("no_fly", 1);
  setup();
}
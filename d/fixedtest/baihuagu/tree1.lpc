// tree1 —— 由 nitan/d/baihuagu/tree1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-450,-400,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "树林");
  set("long", " ");
  set("exits", ([
    "west" : __DIR__ "tree",
    "south" : __DIR__ "tree",
    "east" : __DIR__ "tree",
    "north" : __DIR__ "tree",
  ]));
  set("no_fly", 1);
  setup();
}
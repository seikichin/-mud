// baihuagu —— 由 nitan/d/baihuagu/baihuagu.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-430,-360,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIM"百花谷内"NOR);
  set("long", HIG"只见姹紫嫣红，满山锦绣，彩蝶纷飞，群蜂轻舞。纵是宇外琼地，
世外桃源，也不过如此。\n"NOR);
  set("exits", ([
    "out" : __DIR__ "huagu7",
    "south" : __DIR__ "baihuagu1",
    "west" : __DIR__ "baihuaguroom",
    "east" : __DIR__ "baihuaguroom",
    "north" : __DIR__ "baihuaguroom",
  ]));
  set("no_fly", 1);
  setup();
}
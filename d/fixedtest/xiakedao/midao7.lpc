inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "秘密通道");
  set("long", " ");
  set("exits", ([
    "northup" : __DIR__ "midao8",
    "east" : __DIR__ "midao6",
    "out" : __DIR__ "dating",
  ]));
  set("no_fly", 1);
  setup();
}
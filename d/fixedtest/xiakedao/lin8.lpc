// lin8 —— 由 nitan/d/xiakedao/lin8.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3000,-22000,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "树林");
  set("long", @LONG
终于走出了树林，你不禁长长的松了口气。和煦的阳光照在你
的身上，使你感到无比的温暖。南边是一座高耸的石山，山上郁郁
苍苍，生满树木。
LONG );
  set("exits", ([
    "north" : __DIR__ "lin7",
    "south" : __DIR__ "shanmen",
  ]));
  set("no_fly", 1);
  setup();
}
// yongdao2 —— 由 nitan/d/xiakedao/yongdao2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3100,-22070,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "甬道");
  set("long", @LONG
这是一条长长的甬道，两边点着油灯，光线虽暗，却也可辨道
路，甬道依着山腹中天然洞穴修凿而成，此处开凿的豁然开朗，有
很多的江湖豪杰在此休息。
LONG );
  set("exits", ([
    "north" : __DIR__ "yongdao1",
    "south" : __DIR__ "shidong1",
  ]));
  set("no_fly", 1);
  setup();
}
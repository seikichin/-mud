// road3 —— 由 nitan/d/xiakedao/road3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3000,-22040,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG
这是通往山顶的小路，路旁杂草丛生，夹杂着一些不知名的野
花。四周静悄悄地没有人声。你深深吸口气，一阵山野的芬芳直入
心扉。
LONG );
  set("exits", ([
    "southup" : __DIR__ "road4",
    "northdown" : __DIR__ "road2",
  ]));
  set("no_fly", 1);
  setup();
}
// road2 —— 由 nitan/d/xiakedao/road2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3000,-22030,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG
小路曲曲折折地通向山顶，脚步声惊起一群飞鸟，扑簌簌地消
失在空中。空气中却有些腥气，路边草丛间不时传来沙沙的轻响，
可能是毒蛇，还是快点离开的好。
LONG );
  set("exits", ([
    "southup" : __DIR__ "road3",
    "northdown" : __DIR__ "road1",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "渔港");
  set("long", @LONG
这里是个小小渔港。南面海面漂浮着几艘小船，抬眼望，海天相
连，无边无际。海鸥掠过浪尖，悠悠翩然。
LONG );
  set("exits", ([
    "east" : __DIR__ "xkroad4",
  ]));
  set("no_fly", 1);
  setup();
}
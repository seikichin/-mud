inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "平原小路");
  set("long", @LONG
你走在珠江三角洲的平原小路上。此处向称鱼米之乡，有花果之
都美誉，物产丰饶，民风淳朴。
LONG );
  set("exits", ([
    "south" : __DIR__ "xkroad4",
    "north" : "/d/fixedtest/foshan/10/1/0",
  ]));
  set("no_fly", 1);
  setup();
}
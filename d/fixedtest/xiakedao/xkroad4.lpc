// 原 coor(-1400,-9000,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "南海渔村");
  set("long", @LONG
这是南海沿岸的偏僻小村，稀稀落落的几户人家。空地上晾着几
顶渔网。南面就是波涛浩淼的南海了。向西走好象还有个渔港。东面
是小村的沙滩晒网场。
LONG );
  set("exits", ([
    "south" : __DIR__ "haibin",
    "west" : __DIR__ "haigang",
    "east" : __DIR__ "xkroad5",
    "north" : __DIR__ "xkroad3",
  ]));
  set("no_fly", 1);
  setup();
}
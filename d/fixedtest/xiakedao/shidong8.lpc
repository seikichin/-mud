inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "石洞");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "shidong7",
    "south" : __DIR__ "road5",
  ]));
  set("no_fly", 1);
  setup();
}
// 原 coor(-2100,-1700,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大厅");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "mtxiaowu",
    "down" : __DIR__ "mtyadi",
  ]));
  set("no_fly", 1);
  setup();
}
// shidong4 —— 由 nitan/d/xiakedao/shidong4.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3070,-22100,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "石洞");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "yingbin",
    "south" : __DIR__ "shidong4",
    "east" : __DIR__ "shidong4",
    "west" : __DIR__ "shidong5",
  ]));
  set("no_fly", 1);
  setup();
}
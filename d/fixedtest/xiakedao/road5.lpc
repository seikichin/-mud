// road5 —— 由 nitan/d/xiakedao/road5.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3110,-22110,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG
这是侠客岛的后山，你走在一条岩石嶙峋的山道上，这是通向
侠客岛 "望云台" 的唯一路径，旁边是万丈悬崖，抬头隐约可见笼
罩在云雾中的山峰，一条山路环山而行。
LONG );
  set("exits", ([
    "southup" : __DIR__ "road6",
    "north" : __DIR__ "shidong8",
  ]));
  set("no_fly", 1);
  setup();
}
// shidong1 —— 由 nitan/d/xiakedao/shidong1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3100,-22080,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "石洞");
  set("long", @LONG
这是一个石洞，也不知走了多久，只觉越走越低，洞中出现了
流水之声，淙淙争争，清脆悦耳，如击玉磬。
LONG );
  set("exits", ([
    "south" : __DIR__ "shidong6",
    "east" : __DIR__ "dongmen",
    "north" : __DIR__ "yongdao2",
  ]));
  set("no_fly", 1);
  setup();
}
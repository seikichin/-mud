// shidong3 —— 由 nitan/d/xiakedao/shidong3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3070,-22090,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "石洞");
  set("long", @LONG
这是一个石洞，四周点着八盏油灯，使得整个房间非常明亮。
山洞中支路甚多，你可要小心，别走错了路。
LONG );
  set("exits", ([
    "north" : __DIR__ "yingbin",
    "south" : __DIR__ "shidong4",
    "east" : __DIR__ "shidong3",
    "west" : __DIR__ "shidong3",
  ]));
  set("no_fly", 1);
  setup();
}
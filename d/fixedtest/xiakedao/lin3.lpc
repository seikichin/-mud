inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "树林");
  set("long", @LONG
这是一片茂密的树林，好象被人设计了一种阵，一走进来，你仿佛迷失了方向。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "lin4",
    "west" : __DIR__ "lin2",
    "south" : __DIR__ "lin3",
    "northeast" : __DIR__ "lin3",
    "east" : __DIR__ "lin3",
    "north" : __DIR__ "lin3",
  ]));
  set("no_fly", 1);
  setup();
}
// road4 —— 由 nitan/d/xiakedao/road4.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3000,-22050,40)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG
你走在一条岩石嶙峋的山道上，左临深涧，涧水缓急，激石有
声。右边是悬崖，抬头隐约可见笼罩在云雾中的山峰，一路沿着山
潼渐行渐高。
LONG );
  set("exits", ([
    "southup" : __DIR__ "pubu",
    "northdown" : __DIR__ "road3",
  ]));
  set("no_fly", 1);
  setup();
}
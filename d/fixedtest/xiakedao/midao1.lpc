// midao1 —— 由 nitan/d/xiakedao/midao1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3090,-25000,-20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "秘密通道");
  set("long", @LONG
这是一条很长的秘密通道，也许好久没人来过了，密道中充满
了一种潮湿的气味，隐约可以感觉到四周是冰冷的石壁，你什么也
看不见，只可以靠摸索着前进。
LONG );
  set("exits", ([
    "south" : __DIR__ "midao1",
    "west" : __DIR__ "midao1",
    "east" : __DIR__ "midao2",
    "north" : __DIR__ "midao1",
  ]));
  set("no_fly", 1);
  setup();
}
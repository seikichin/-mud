// lunhuisi_road1 —— 由 nitan/d/death/lunhuisi_road1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(110,40,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIB "【轮回道】" NOR);
  set("long", " ");
  set("exits", ([
    "enter" : __DIR__ "lunhuisi",
    "west" : __DIR__ "jimiesi",
  ]));
  set("no_fly", 1);
  setup();
}
// lunhuisi —— 由 nitan/d/death/lunhuisi.c 转换（独立房间，不在固定地图网格内）
// 原 coor(100,40,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIB "【轮回司】" NOR);
  set("long", " ");
  set("exits", ([
    "out" : __DIR__ "lunhuisi_road1",
  ]));
  set("no_fly", 1);
  setup();
  set("exits/down", "/d/fixedtest/death/9/4/2");
}
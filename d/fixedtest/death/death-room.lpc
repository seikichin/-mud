// ============================================================
//  death-room.lpc  ——  nitan d/death 映射区（14x11x21）房间模板
//  由 nitan_build.aardio 自动生成，可自由修改文字
//
//  数据表 maze_cell_desc 的键 = 格索引 ""x,y,z""（从 0 开始，与 death.map 一致）
//  值 = ({ 短描述, 长描述 })
//  改这里的文字即可直接改变对应格子的 look 结果。
//
//  原 coor 与格索引的换算： coor = (格索引 + (1,0,0)) * 10
//  一格多间房时：短描述取主房，长描述按房间拼接（源房名见行末注释）
//
//  short/long 保留 nitan 原文的 LPC 表达式（heredoc / 颜色宏），
//  因此 ANSI 颜色（HIW / HIY / NOR 等）与原文完全一致。
// ============================================================

inherit ROOM;
#include <ansi.h>

void create() {}

// 格索引 -> ({ short, long })
mapping maze_cell_desc = ([
  "9,4,0" : ({ HIR "【 地 阴 】" NOR, HIR @LONG

                       地            阴

    这里便是阴间的最深处「地阴」，你面前是一个无底深渊，深渊内
侧悬浮着一块血红色的巨大晶体(jingti)，时明时暗，散发出暗淡的血
红色光芒，投射着丝丝热量。也许这就传说中的「地阴血脉」吧。

LONG NOR }),  // coor(100,40,0)  diyin
  "2,0,1" : ({ BLU "黄泉路" NOR, BLU @LONG
“人生自古谁无死”，从古至今，死一直是所有帝王将相，仁人义
士不能避免的结局。眼前就是著名的黄泉大道。就在你身边，一个个模
模糊糊的身影涌动着，耳边不乏一阵阵的啼哭之声可知韶华易逝，青春
难驻，人生在世多么的短暂，到了这个时候，却又是多么的留恋......
LONG NOR }),  // coor(30,0,10)  yellow1

// death —— nitan d/death 固定地图映射区（vrm_fixed）
//
//   death.map         地图（方向位掩码 + [LINK] 特殊出口）
//   death-room.lpc    格房描述（改文字即可改每格 look）
//   deathgate.lpc / deathgate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/death/death/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = death）
// 格索引 -> 原 coor： coor = (格索引 + (1,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "death-room");
  set_maze_map(__DIR__ "death");
  set_maze_spacing(10);
  set_maze_owner_key("death");

  // 入口 = yellow3（格 2,2,1），出口 = yinyangta18（格 13,4,20）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "deathgate");
  set_link_exit_room(__DIR__ "deathgate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(80);
  set_link_entry_room_y(50);
  set_link_entry_room_z(220);

  set_entry_short(HIW "黄泉路" NOR);
  set_entry_desc("黄泉路，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "阴阳塔" NOR);
  set_exit_desc("阴阳塔，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 death-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("黄泉路");
  set_maze_room_desc("nitan d/death 映射区。");
}
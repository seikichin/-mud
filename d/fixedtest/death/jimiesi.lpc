// jimiesi —— 由 nitan/d/death/jimiesi.c 转换（独立房间，不在固定地图网格内）
// 原 coor(120,40,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIB "【寂灭司】" NOR);
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "lunhuisi_road1",
    "west" : __DIR__ "12/4/3",
  ]));
  set("no_fly", 1);
  setup();
}
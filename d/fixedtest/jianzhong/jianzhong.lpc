// jianzhong —— nitan d/jianzhong 固定地图映射区（vrm_fixed）
//
//   jianzhong.map         地图（方向位掩码 + [LINK] 特殊出口）
//   jianzhong-room.lpc    格房描述（改文字即可改每格 look）
//   jianzhonggate.lpc / jianzhonggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/jianzhong/jianzhong/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = jianzhong）
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "jianzhong-room");
  set_maze_map(__DIR__ "jianzhong");
  set_maze_spacing(10);
  set_maze_owner_key("jianzhong");

  set_entry_dir("up");
  set_link_entry_room(__DIR__ "jianzhonggate");
  set_link_exit_room(__DIR__ "jianzhonggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-400);
  set_link_entry_room_y(-440);
  set_link_entry_room_z(20);

  set_entry_short(HIW "深谷" NOR);
  set_entry_desc("深谷，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "山谷" NOR);
  set_exit_desc("山谷，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 jianzhong-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("深谷");
  set_maze_room_desc("nitan d/jianzhong 映射区。");
}
// ============================================================
//  jianzhong-room.lpc  ——  nitan d/jianzhong 映射区（1x3x1）房间模板
//  由 nitan_build.aardio 自动生成，可自由修改文字
//
//  数据表 maze_cell_desc 的键 = 格索引 ""x,y,z""（从 0 开始，与 jianzhong.map 一致）
//  值 = ({ 短描述, 长描述 })
//  改这里的文字即可直接改变对应格子的 look 结果。
//
//  原 coor 与格索引的换算： coor = (格索引 + (-40,-45,0)) * 10
//  一格多间房时：短描述取主房，长描述按房间拼接（源房名见行末注释）
//
//  short/long 保留 nitan 原文的 LPC 表达式（heredoc / 颜色宏），
//  因此 ANSI 颜色（HIW / HIY / NOR 等）与原文完全一致。
// ============================================================

inherit ROOM;
#include <ansi.h>

void create() {}

// 格索引 -> ({ short, long })
mapping maze_cell_desc = ([
  "0,0,0" : ({ "山谷", @LONG
你沿着雕鸣声走入深谷，景致更加秀丽了。你侧耳倾听，
雕鸣声似乎就在耳边，你不禁加快了脚步。
LONG  }),  // coor(-400,-450,0)  shangu
  "0,1,0" : ({ "深谷", (@LONG
深谷中四处碧树丛生，怪石嶙峋，好一副优美的自然景致。
深谷之中，有一个大山洞出现在面前，不知道是什么前辈高人住
在里面。
LONG) + "\n\n【山洞】\n" + (@LONG
这洞里黑黝黝的，不知道里面住着什么武林异士，还是有什
么山魈木怪。是不是再往里走呢？你心里拿不定主意。
LONG) }),  // coor(-400,-440,0)  dongkou + shandong1
  "0,2,0" : ({ "深谷", (@LONG
洞后深谷中风景更是幽雅，树木苍翠，山气清佳，你信步过
去观赏景色，不知不觉中走进了树林深处。
LONG) + "\n\n【独孤求败埋骨之洞】\n" + (@LONG
这洞其实甚浅，行不到三丈，已抵尽头。洞中除了一张石桌和一
张石凳外就别无他物了。洞角有一堆乱石高起，极似一个坟墓，岩壁
上刻着三行字道：
    「纵横江湖三十余载，杀尽仇寇，败尽英雄，天下更无抗手，无
可奈何，惟隐居深谷，以雕为友。呜呼，生平求一敌手而不可得，诚
寂寥难堪也。
                                         剑魔独孤求败。」
LONG) }),  // coor(-400,-430,0)  donghou + maigu
]);

void setup_room_desc(object room, int length, int width, int height, int x, int y, int z) {
  string key;
  mixed info;

  key = sprintf("%d,%d,%d", x, y, z);
  info = maze_cell_desc[key];

  if (arrayp(info) && sizeof(info) >= 2) {
    room->set("short", info[0]);
    room->set("long", info[1]);
  } else {
    // 表里没有的格子（地图新增格）的兜底描述
    room->set("short", HIB "街巷" NOR);
    room->set("long", "空旷的街巷，看不出有什么特别之处。\n");
  }

  room->set("map_x", x);
  room->set("map_y", y);
  room->set("map_z", z);

  room->setup();
}

// 预留：按坐标放怪物 / 物品
void setup_npc_obj(object room, int length, int width, int height, int x, int y, int z) {
  return;
}

int setup_entry_room() { return 1; }
int setup_exit_room() { return 1; }
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "峭壁中");
  set("long", @LONG
峭壁半空中，向上望去，平台还很遥远，往下望去，下面
的一草一木都已变成一个个小黑点。风比峭壁底大得多，直吹
得你毛骨悚然，你开始有点后悔冒然爬这个峭壁了。
LONG );
  set("no_fly", 1);
  setup();
}
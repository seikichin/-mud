// wuxing3 —— 由 nitan/d/shaolin/wuxing3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(250,0,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIR "五行洞" NOR);
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "25/1/1",
    "west" : __DIR__ "24/1/1",
    "east" : __DIR__ "23/1/1",
    "south" : __DIR__ "wuxing2",
  ]));
  set("no_fly", 1);
  setup();
}
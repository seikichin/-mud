// shaolin —— nitan d/shaolin 固定地图映射区（vrm_fixed）
//
//   shaolin.map         地图（方向位掩码 + [LINK] 特殊出口）
//   shaolin-room.lpc    格房描述（改文字即可改每格 look）
//   shaolingate.lpc / shaolingate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/shaolin/shaolin/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = shaolin）
// 格索引 -> 原 coor： coor = (格索引 + (1,0,1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "shaolin-room");
  set_maze_map(__DIR__ "shaolin");
  set_maze_spacing(10);
  set_maze_owner_key("shaolin");

  // 入口 = zhonglou1（格 20,0,0），出口 = bamboo1（格 3,12,2）
  set_entry_dir("south");
  set_link_entry_room(__DIR__ "shaolingate");
  set_link_exit_room(__DIR__ "shaolingate2");
  set_entry_back_dir("south");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(150);
  set_link_entry_room_y(60);
  set_link_entry_room_z(130);

  set_entry_short(HIW "钟楼一层" NOR);
  set_entry_desc("钟楼一层，从这里可以进入迷宫（north）。\n");
  set_exit_short(HIY "竹林" NOR);
  set_exit_desc("竹林，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 shaolin-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("钟楼一层");
  set_maze_room_desc("nitan d/shaolin 映射区。");
}
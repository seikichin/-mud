// shulin7 —— 由 nitan/d/shaolin/shulin7.c 转换（独立房间，不在固定地图网格内）
// 原 coor(150,60,110)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "松树林");
  set("long", @LONG
你眼前骤然一黑，朦胧中，只见左右前后，到处都是铺天盖地的
松树林。几十丈高的大松树簇在一块，密实的枝叶象一蓬蓬巨伞恒伸
向天空，把阳光遮得丝毫也无。尺把厚的松针积在地上，一脚踩下去，
半天拔不出来。你似乎迷失了方向，象没头苍蝇般到处乱闯。
LONG );
  set("exits", ([
    "north" : __DIR__ "shulin6",
    "west" : __DIR__"shulin"+(random(10)+2),
    "east" : __DIR__ "shulin8",
    "south" : __DIR__"shulin"+(random(10)+2),
  ]));
  set("no_fly", 1);
  setup();
}
// ============================================================
//  shaolin-room.lpc  ——  nitan d/shaolin 映射区（29x13x11）房间模板
//  由 nitan_build.aardio 自动生成，可自由修改文字
//
//  数据表 maze_cell_desc 的键 = 格索引 ""x,y,z""（从 0 开始，与 shaolin.map 一致）
//  值 = ({ 短描述, 长描述 })
//  改这里的文字即可直接改变对应格子的 look 结果。
//
//  原 coor 与格索引的换算： coor = (格索引 + (1,0,1)) * 10
//  一格多间房时：短描述取主房，长描述按房间拼接（源房名见行末注释）
//
//  short/long 保留 nitan 原文的 LPC 表达式（heredoc / 颜色宏），
//  因此 ANSI 颜色（HIW / HIY / NOR 等）与原文完全一致。
// ============================================================

inherit ROOM;
#include <ansi.h>

void create() {}

// 格索引 -> ({ short, long })
mapping maze_cell_desc = ([
  "2,0,0" : ({ "西侧殿", @LONG
这里是西侧殿。房间四周悬挂着达摩祖师、观音大士的画像，以
及一些寺内元老的字画。地下散乱地放着许多蒲团，木鱼等。看来此
处是本派弟子打坐修行之所。几位年轻僧人正肃容入定，看来已颇得
禅宗三昧。
LONG  }),  // coor(30,0,10)  smdian2
  "3,0,0" : ({ "山门殿", @LONG
这里便是少林寺的前殿山门殿了。只见殿内青砖铺地，两侧分列
哼、哈二将。身躯雄伟，面相忿怒，头带宝冠，上半身裸露，手执金
刚杵，一鼓鼻，一张口，露牙睁目，凶猛可畏。两边各放一红木供桌，
陈列香烛，以供僧俗叩拜。自此的左右各有一间偏殿，供比丘们打坐
诵经之用。南面是一道三丈来高的朱红杉木包铜大门(gate)。
LONG  }),  // coor(40,0,10)  smdian
  "4,0,0" : ({ "东侧殿", @LONG
这里是东侧殿。房间四周悬挂着达摩祖师、观音大士的画像，以
及一些寺内元老的字画。地下散乱地放着许多蒲团，木鱼等。看来此

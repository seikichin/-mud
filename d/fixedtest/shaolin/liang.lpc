// liang —— 由 nitan/d/shaolin/liang.c 转换（独立房间，不在固定地图网格内）
// 原 coor(10,100,40)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "藏经阁房梁");
  set("long", " ");
  set("exits", ([
    "down" : __DIR__ "0/10/2",
  ]));
  set("no_fly", 1);
  setup();
}
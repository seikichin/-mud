// damodong —— 由 nitan/d/shaolin/damodong.c 转换（独立房间，不在固定地图网格内）
// 原 coor(50,120,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "达摩洞");
  set("long", @LONG
这里是达摩古洞。五百年前南天竺僧人菩提达摩来到少林寺，见
此风水宝地，就住下来广罗弟子，传授禅宗，开创少林寺佛教禅宗千
年不败之基。达摩祖师常在此面壁悟道，一坐十年，壁间隐隐似仍可
看到他面壁时的打坐姿态。除地上的几块竹片外，洞中空无一物。
LONG );
  set("exits", ([
    "out" : __DIR__ "3/12/2",
  ]));
  set("no_fly", 1);
  setup();
}
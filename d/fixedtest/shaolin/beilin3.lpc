// beilin3 —— 由 nitan/d/shaolin/beilin3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(30,10,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", NOR + WHT "地下室" NOR);
  set("long", " ");
  set("exits", ([
    "up" : __DIR__ "2/1/0",
  ]));
  set("no_fly", 1);
  setup();
}
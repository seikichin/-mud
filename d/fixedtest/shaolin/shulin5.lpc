// shulin5 —— 由 nitan/d/shaolin/shulin5.c 转换（独立房间，不在固定地图网格内）
// 原 coor(140,70,110)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "松树林");
  set("long", @LONG
地的松树林。几十丈高的大松树簇在一块，密实的枝叶象一蓬蓬
巨伞恒伸向天空，把阳光遮得丝毫也无。尺把厚的松针积在地上，一
脚踩下去，半天拔不出来。你似乎迷失了方向，象没头苍蝇般到处乱
闯。
LONG );
  set("exits", ([
    "north" : __DIR__ "shulin6",
    "west" : __DIR__"shulin"+(random(10)+2),
    "east" : __DIR__"shulin"+(random(10)+2),
    "south" : __DIR__ "12/7/10",
  ]));
  set("no_fly", 1);
  setup();
}
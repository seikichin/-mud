// ship —— 由 nitan/d/guiyun/ship.c 转换（独立房间，不在固定地图网格内）
// 原 coor(300,-610,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "战船");
  set("long", @LONG
这是一艘大渔船，船上的人白天打鱼，晚上就干些没本钱的买卖，
接济沿湖的百姓。
LONG );
  set("no_fly", 1);
  setup();
  set("exits/out", __DIR__ "jinship");
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "九宫桃花阵");
  set("long", "(无描述)");
  set("exits", ([
    "south" : __DIR__ "jiugong5",
    "east" : __DIR__ "jiugong3",
    "west" : __DIR__ "jiugong1",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "宫道");
  set("long", @LONG
这是紫禁内外城间的宫道. 平日里一些人物出入内宫, 就是走这路
的. 这宫道上每日都有大内侍卫来回巡逻, 出入可要小心. 宫道两边高
高的红墙, 正是为了拦阻入侵高手的.
LONG );
  set("exits", ([
    "east" : __DIR__ "jiao1",
    "west" : __DIR__ "wumen",
  ]));
  set("no_fly", 1);
  setup();
}
// 原 coor(-2870,7730,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "上林囿");
  set("long", @LONG
这是西苑的一片广袤的大猎场, 疾风吹劲草, 大有草枯鹰眼疾的非
凡气派.
LONG );
  set("exits", ([
    "south" : __DIR__ "lie6",
    "north" : __DIR__ "lie5",
    "east" : __DIR__ "lie6",
    "west" : __DIR__ "lie6",
  ]));
  set("no_fly", 1);
  setup();
}
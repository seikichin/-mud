inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "天中阁");
  set("long", @LONG
天中阁是中岳庙的大门，原称黄中阁。庙内有古柏三百余株，金石
碑碣百余座。庙前石翁仲，雕制古朴。南面是嵩山的出口太室阙。
LONG );
  set("exits", ([
    "south" : __DIR__ "taishique",
    "north" : __DIR__ "chongsheng",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "崇圣门");
  set("long", @LONG
崇圣门前古神库有四座镇库铁人，高达丈许，振臂握拳，怒目挺胸，
身姿雄健。向北就是中岳庙最大的殿宇中岳大殿了。
LONG );
  set("exits", ([
    "south" : __DIR__ "tianzhongge",
    "north" : __DIR__ "dadian",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "极顶山道");
  set("long", @LONG
你走在嵩山极顶山道，青松翠柏，山风岚雾，时来飘荡。远望山下
犬吠鸡啼，顿起仙凡之感。西上就是封禅台了。
LONG );
  set("exits", ([
    "eastdown" : __DIR__ "shandao7",
    "westup" : __DIR__ "fengchantai",
  ]));
  set("no_fly", 1);
  setup();
}
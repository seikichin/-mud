void create() {
  set("short", "东庭");
  set("long", @LONG
这里是一个小小庭院，院子里常有嵩山弟子结伴往来。庭院四周矮
墙下长着的小灌木里，偶尔冒出几星白色小花。鹅卵细石铺就的小路在
灌木丛和长草间穿过。
LONG );
  set("exits", ([
    "south" : __DIR__ "shuzhai",
    "north" : __DIR__ "eastpath2",
    "east" : __DIR__ "jianlu",
    "west" : __DIR__ "4/15/8",
  ]));
  set("no_fly", 1);
  setup();
}
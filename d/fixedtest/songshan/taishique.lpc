inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "太室阙");
  set("long", @LONG
嵩山古称方外，又称崇山，为五岳中的中岳，由太室少室二山沿绵
而成。汉武帝时称“嵩高”，取自诗经“嵩岳维高，峻极于天”，道教
以之为第六小洞天。阕高丈余，南面刻“中岳太室阳城”六字，篆文古
朴，苍劲有力。向西就是去少室山少林寺的路。向北一里许便是中岳庙
了。
LONG );
  set("exits", ([
    "west" : "/d/fixedtest/shaolin/12/0/0",
    "south" : "/d/fixedtest/kaifeng/2/18/0",
    "east" : "/d/fixedtest/ruzhou/0/3/0",
    "north" : __DIR__ "tianzhongge",
  ]));
  set("no_fly", 1);
  setup();
}
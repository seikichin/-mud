// yanziwu —— nitan d/yanziwu 固定地图映射区（vrm_fixed）
//
//   yanziwu.map         地图（方向位掩码 + [LINK] 特殊出口）
//   yanziwu-room.lpc    格房描述（改文字即可改每格 look）
//   yanziwugate.lpc / yanziwugate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/yanziwu/yanziwu/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = yanziwu）
// 格索引 -> 原 coor： coor = (格索引 + (74,-186,-1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "yanziwu-room");
  set_maze_map(__DIR__ "yanziwu");
  set_maze_spacing(10);
  set_maze_owner_key("yanziwu");

  // 入口 = huafang（格 52,61,0），出口 = luanyun（格 47,62,4）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "yanziwugate");
  set_link_exit_room(__DIR__ "yanziwugate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(1010);
  set_link_entry_room_y(-1530);
  set_link_entry_room_z(50);

  set_entry_short(HIW "五湖舫" NOR);
  set_entry_desc("五湖舫，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "乱云亭" NOR);
  set_exit_desc("乱云亭，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 yanziwu-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("五湖舫");
  set_maze_room_desc("nitan d/yanziwu 映射区。");
}
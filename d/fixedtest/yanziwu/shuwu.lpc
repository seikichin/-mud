// 原文件无 coor
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "翰墨书屋");
  set("long", " ");
  set("exits", ([
    "south" : __DIR__ "shangyu",
    "east" : __DIR__ "lanyue",
    "north" : __DIR__ "canheju",
  ]));
  set("no_fly", 1);
  setup();
}
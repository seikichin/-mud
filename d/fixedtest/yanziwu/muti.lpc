inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "木梯");
  set("long", @LONG
这是一座松树枝架成的木梯，垂下来通往水面。忽听得旁边柳枝
上一只小鸟 "莎莎都莎，莎莎都莎" 的叫了起来，把你吓了一跳。南
边通向船坞。
LONG );
  set("exits", ([
    "southup" : __DIR__ "bozhou",
    "eastup" : __DIR__ "qinyun",
  ]));
  set("no_fly", 1);
  setup();
}
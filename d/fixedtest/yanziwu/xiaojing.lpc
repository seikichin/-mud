inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小径");
  set("long", @LONG
这是个一条湖边的小径，西面就是一座小桥。周围湖光影天，你
不禁深吸了一口醉人的空气，陶醉于山水中。
LONG );
  set("exits", ([
    "south" : __DIR__ "xiaoting",
    "west" : __DIR__ "xiaoqiao",
  ]));
  set("no_fly", 1);
  setup();
}
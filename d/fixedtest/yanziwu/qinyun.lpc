inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "琴韵小筑");
  set("long", @LONG
这是一间小巧玲珑的房舍，颇为精雅。周围稀稀落落的四五间小
房屋，建造在一个不知是小岛还是半岛上。
LONG );
  set("exits", ([
    "south" : __DIR__ "neitang",
    "east" : __DIR__ "xiaoting",
    "westdown" : __DIR__ "muti",
  ]));
  set("no_fly", 1);
  setup();
}
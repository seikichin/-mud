inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "秋爽斋");
  set("long", @LONG
素幔低垂，设备朴素，临窗的桌上堆满卷轴，一大桶毛笔显示出
主人学识渊博。一只剑形花瓶插着几朵犁花，带来几分清新的气息。
LONG );
  set("exits", ([
    "east" : __DIR__ "canheju",
  ]));
  set("no_fly", 1);
  setup();
}
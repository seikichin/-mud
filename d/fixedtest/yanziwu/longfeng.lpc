inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "龙凤厅");
  set("long", @LONG
这是一座气势巍峨，构造宏大的大厅堂，大门前一对大石狮子张
牙舞爪，厅门上「龙凤厅」三个大字遒劲有力，气度不凡。厅中墙上
挂满名人字画，一张大八仙桌上茶具齐整，四周围着一圈檀香木大椅。
LONG );
  set("exits", ([
    "west" : __DIR__ "pindi",
    "east" : __DIR__ "lixiang",
    "south" : __DIR__ "yimen",
  ]));
  set("no_fly", 1);
  setup();
}
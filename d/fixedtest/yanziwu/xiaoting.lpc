inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "晓寒厅");
  set("long", " ");
  set("exits", ([
    "south" : __DIR__ "chufang",
    "north" : __DIR__ "xiaojing",
    "east" : __DIR__ "cuixia",
    "west" : __DIR__ "qinyun",
  ]));
  set("no_fly", 1);
  setup();
}
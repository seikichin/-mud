inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "啖糯厅");
  set("long", @LONG
这是一间雅致的大厅，厅上摆着几张紫檀木大桌。桌上银制餐具
一应俱全，桌边一溜犁花木椅。每日慕容世家很多人都在此用餐。
LONG );
  set("exits", ([
    "east" : __DIR__ "huayuan",
    "west" : __DIR__ "yimen",
  ]));
  set("no_fly", 1);
  setup();
}
// chalin3 —— 由 nitan/d/yanziwu/chalin3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1190,-1290,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "茶花林");
  set("long", @LONG
你在花林中跌跌撞撞地蹒跚而行，不知道那里是出口，来时所留神
的只是茶花，忘了记忆路径，眼见小路东一条、西一条，也不知那一条
才是来路，要回到小船停泊处却有点儿难了，于是你心想：“先走到水
边再说。”
LONG );
  set("exits", ([
    "north" : __DIR__ "46/58/1",
    "south" : __DIR__ "chalin3",
    "east" : __DIR__ "46/57/1",
    "west" : __DIR__ "47/57/1",
  ]));
  set("no_fly", 1);
  setup();
}
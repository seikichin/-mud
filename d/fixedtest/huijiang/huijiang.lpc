// huijiang —— nitan d/huijiang 固定地图映射区（vrm_fixed）
//
//   huijiang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   huijiang-room.lpc    格房描述（改文字即可改每格 look）
//   huijianggate.lpc / huijianggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/huijiang/huijiang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = huijiang）
// 格索引 -> 原 coor： coor = (格索引 + (-5008,900,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "huijiang-room");
  set_maze_map(__DIR__ "huijiang");
  set_maze_spacing(10);
  set_maze_owner_key("huijiang");

  // 入口 = damen（格 2,14,0），出口 = gebi2（格 7,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "huijianggate");
  set_link_exit_room(__DIR__ "huijianggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-50040);
  set_link_entry_room_y(9080);
  set_link_entry_room_z(40);

  set_entry_short(HIW "总舵大门" NOR);
  set_entry_desc("总舵大门，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "戈壁" NOR);
  set_exit_desc("戈壁，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 huijiang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("总舵大门");
  set_maze_room_desc("nitan d/huijiang 映射区。");
}
// 原 coor(90,-510,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "木板路");
  set("long", @LONG
这是一条用木板铺成的小道，虽然不是很长，但是却看得出铺得十
分细心，连一些细微的疏忽也注意到了。道路两旁种着一些奇花异树，
使过路人有心旷神怡的感觉。
LONG );
  set("exits", ([
    "north" : __DIR__ "xiaodao4",
    "south" : __DIR__ "muwu3",
  ]));
  set("no_fly", 1);
  setup();
}
// shishi3 —— 由 nitan/d/xiaoyao/shishi3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-50020,-21030,-40)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "石室");
  set("long", " ");
  set("exits", ([
    "south" : __DIR__ "0/2/0",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "秘密通道");
  set("long", @LONG
这是一段又长又黑的秘密通道，隐约可以感觉到四周是冰冷而坚硬
的石壁，你什么了看不清楚，只可以靠摸索着前进。
LONG );
  set("exits", ([
    "north" : __DIR__ "midao2",
    "out" : __DIR__ "shishi3",
  ]));
  set("no_fly", 1);
  setup();
}
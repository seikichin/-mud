// 原 coor(60,-510,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "酒家");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "xiaodao2",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "地下石室");
  set("long", @LONG
这里是地下石室的最下面一层了，四周是黑乎乎，说不出的阴深恐
怖，你可以闻到强烈的腐烂的东西所发出的气味。看来还是快点离开比
较好。
LONG );
  set("exits", ([
    "up" : __DIR__ "shishi4",
  ]));
  set("no_fly", 1);
  setup();
}
// 原 coor(90,-500,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "林间小道");
  set("long", @LONG
这是一条长长的林间小道，从东边一直通到西边，一眼望去，看不
到路的尽头。两旁百花争艳。令人留连忘返。
LONG );
  set("exits", ([
    "south" : __DIR__ "mubanlu",
    "north" : __DIR__ "liangong",
    "east" : __DIR__ "shulin1",
    "west" : __DIR__ "qingcaop",
  ]));
  set("no_fly", 1);
  setup();
}
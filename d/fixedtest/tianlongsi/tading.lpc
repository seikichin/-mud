// tading —— 由 nitan/d/tianlongsi/tading.c 转换（独立房间，不在固定地图网格内）
// 原 coor(10,80,10)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "塔顶");
  set("long", " ");
  set("exits", ([
    "down" : __DIR__ "1/8/0",
  ]));
  set("no_fly", 1);
  setup();
}
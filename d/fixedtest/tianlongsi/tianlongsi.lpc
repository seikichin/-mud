// tianlongsi —— nitan d/tianlongsi 固定地图映射区（vrm_fixed）
//
//   tianlongsi.map         地图（方向位掩码 + [LINK] 特殊出口）
//   tianlongsi-room.lpc    格房描述（改文字即可改每格 look）
//   tianlongsigate.lpc / tianlongsigate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/tianlongsi/tianlongsi/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = tianlongsi）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "tianlongsi-room");
  set_maze_map(__DIR__ "tianlongsi");
  set_maze_spacing(10);
  set_maze_owner_key("tianlongsi");

  // 入口 = damen（格 1,10,0），出口 = munitang（格 1,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "tianlongsigate");
  set_link_exit_room(__DIR__ "tianlongsigate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(10);
  set_link_entry_room_y(50);
  set_link_entry_room_z(20);

  set_entry_short(HIW "大门" NOR);
  set_entry_desc("大门，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "牟尼堂" NOR);
  set_exit_desc("牟尼堂，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 tianlongsi-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("大门");
  set_maze_room_desc("nitan d/tianlongsi 映射区。");
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "武昌码头");
  set("long", @LONG
武昌也是武汉的一个重镇。渡船在这里停下，走在石板搭砌的江岸，
仍然能感觉到大江的奔流。略带腥味的江边气息随风飘来。南边可见江
中一柱擎天石壁。
LONG );
  set("exits", ([
    "south" : __DIR__ "chibi",
  ]));
  set("no_fly", 1);
  setup();
}
// bishuiting —— 由 nitan/d/suzhou/bishuiting.c 转换（独立房间，不在固定地图网格内）
// 原 coor(800,-1200,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "碧水亭");
  set("long", " ");
  set("exits", ([
    "south" : __DIR__ "huzhongdao",
  ]));
  set("no_fly", 1);
  setup();
}
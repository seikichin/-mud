// 原 coor(800,-1205,0)  coor 不是 10 的倍数
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "湖中岛");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "bishuiting",
  ]));
  set("no_fly", 1);
  setup();
}
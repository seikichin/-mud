// taishan —— nitan d/taishan 固定地图映射区（vrm_fixed）
//
//   taishan.map         地图（方向位掩码 + [LINK] 特殊出口）
//   taishan-room.lpc    格房描述（改文字即可改每格 look）
//   taishangate.lpc / taishangate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/taishan/taishan/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = taishan）
// 格索引 -> 原 coor： coor = (格索引 + (2,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "taishan-room");
  set_maze_map(__DIR__ "taishan");
  set_maze_spacing(10);
  set_maze_owner_key("taishan");

  // 入口 = dongtian（格 6,30,19），出口 = yidao（格 3,0,0）
  set_entry_dir("north");
  set_link_entry_room(__DIR__ "taishangate");
  set_link_exit_room(__DIR__ "taishangate2");
  set_entry_back_dir("north");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(60);
  set_link_entry_room_y(170);
  set_link_entry_room_z(240);

  set_entry_short(HIW "东天门" NOR);
  set_entry_desc("东天门，从这里可以进入迷宫（south）。\n");
  set_exit_short(HIY "大驿道" NOR);
  set_exit_desc("大驿道，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 taishan-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("东天门");
  set_maze_room_desc("nitan d/taishan 映射区。");
}
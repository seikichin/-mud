// beihai —— nitan d/beihai 固定地图映射区（vrm_fixed）
//
//   beihai.map         地图（方向位掩码 + [LINK] 特殊出口）
//   beihai-room.lpc    格房描述（改文字即可改每格 look）
//   beihaigate.lpc / beihaigate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/beihai/beihai/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = beihai）
// 格索引 -> 原 coor： coor = (格索引 + (-20,404,-1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "beihai-room");
  set_maze_map(__DIR__ "beihai");
  set_maze_spacing(10);
  set_maze_owner_key("beihai");

  // 入口 = shiqiao（格 2,6,0），出口 = ximen（格 0,1,1）
  set_entry_dir("east");
  set_link_entry_room(__DIR__ "beihaigate");
  set_link_exit_room(__DIR__ "beihaigate2");
  set_entry_back_dir("east");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-170);
  set_link_entry_room_y(4080);
  set_link_entry_room_z(30);

  set_entry_short(HIW "石桥" NOR);
  set_entry_desc("石桥，从这里可以进入迷宫（east）。\n");
  set_exit_short(HIY "西门" NOR);
  set_exit_desc("西门，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 beihai-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("石桥");
  set_maze_room_desc("nitan d/beihai 映射区。");
}
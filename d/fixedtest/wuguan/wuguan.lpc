// wuguan —— nitan d/wuguan 固定地图映射区（vrm_fixed）
//
//   wuguan.map         地图（方向位掩码 + [LINK] 特殊出口）
//   wuguan-room.lpc    格房描述（改文字即可改每格 look）
//   wuguangate.lpc / wuguangate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/wuguan/wuguan/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = wuguan）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "wuguan-room");
  set_maze_map(__DIR__ "wuguan");
  set_maze_spacing(10);
  set_maze_owner_key("wuguan");

  // 入口 = guofu_woshi2（格 6,5,0），出口 = guofu_gate（格 3,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "wuguangate");
  set_link_exit_room(__DIR__ "wuguangate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(30);
  set_link_entry_room_y(40);
  set_link_entry_room_z(20);

  set_entry_short(HIW "休息室" NOR);
  set_entry_desc("休息室，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "郭府大门" NOR);
  set_exit_desc("郭府大门，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 wuguan-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("休息室");
  set_maze_room_desc("nitan d/wuguan 映射区。");
}
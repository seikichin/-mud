inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大渡河边");
  set("long", @LONG
大渡河是蜀中名川，河谷狭窄，水流湍急，极难渡过，只有远方
下游才有河面宽阔处，可行船渡河。此处是河谷转弯的浅滩，水流稍
缓，不过仍可见滔滔河水汹涌而去，对岸可望而不可及。南边山上有
座石城。
LONG );
  set("exits", ([
    "southup" : __DIR__ "wunong",
  ]));
  set("no_fly", 1);
  setup();
}
// smallboat —— 由 nitan/d/dali/smallboat.c 转换（独立房间，不在固定地图网格内）
// 原文件无 coor
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小船");
  set("long", @LONG
你坐在一条小船里，扳动铁桨用力划着，正在瀑布前的湍急水流
中逆水而上。
LONG );
  set("no_fly", 1);
  setup();
}
// [nitan-auto] 由原档补回的额外函数（恢复离开房间的行为）
void init()
{
        object me;
        me=this_player();
        remove_call_out("moveon");
        call_out("moveon", 10, me);
}

void moveon(object me)
{
        tell_object(me, "你用力划了一会儿，小船到了水流浅缓的溪流，你靠岸下船。\n");
        me->move("/d/fixedtest/dali/yideng4");
}
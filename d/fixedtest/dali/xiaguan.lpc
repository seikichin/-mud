// xiaguan —— 由 nitan/d/dali/xiaguan.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-19170,-6830,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "下关城");
  set("long", @LONG
下关城，又名龙尾城，为阁罗凤所筑，唐代已极繁荣。城区萦抱
苍山南麓数里，洱水绕城南而过，端的风景如画。此去南边不远即是
大理城，东面有太和城，另有道路通向西北。此附近居民以乌夷、台
夷为主，也有少量摆夷。
LONG );
  set("exits", ([
    "northeast" : __DIR__ "0/15/2",
    "northwest" : __DIR__ "cangshanzhong",
    "south" : __DIR__ "ershuiqiao",
  ]));
  set("no_fly", 1);
  setup();
}
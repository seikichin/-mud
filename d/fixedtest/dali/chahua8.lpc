inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "茶花园后门");
  set("long", @LONG
大理茶花冠绝天下，镇南王府的茶花自然更非凡品。你站在茶花
园后门口，对着满园春色，不禁大喜过望。东边就进园了，西面是一
条石铺甬道。
LONG );
  set("exits", ([
    "east" : __DIR__ "chahua7",
    "west" : __DIR__ "yongdao2",
  ]));
  set("no_fly", 1);
  setup();
}
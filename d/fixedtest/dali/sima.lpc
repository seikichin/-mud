inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "司马堂");
  set("long", @LONG
这里是大理国司马堂。大理东北强宋，西北吐蕃，历年来边疆宁
靖，皆司马劳顿之功。盖吐蕃垂涎大理已久，每每强辞胁迫，大理不
得不重兵于西北。
LONG );
  set("exits", ([
    "west" : __DIR__ "zonglichu",
  ]));
  set("no_fly", 1);
  setup();
}
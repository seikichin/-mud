inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "茶花园");
  set("long", @LONG
大理茶花冠绝天下，镇南王府的茶花自然更非凡品。你站在茶花
园中，北面是一座小山，山上栽满了常青乔木。地上长草委地，密密
层层的。东面有一个小小庭院，西边望去仍是一片万紫千红。
LONG );
  set("exits", ([
    "west" : __DIR__ "chahua8",
    "east" : __DIR__ "chahua10",
    "northup" : __DIR__ "chahua9",
    "south" : __DIR__ "chahua6",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "司空堂");
  set("long", @LONG
这里是大理国司空堂。堂内无余物，四壁却堆满了书籍。想来主
人爱书如命，即便工余亦手不释卷。
LONG );
  set("exits", ([
    "south" : __DIR__ "zonglichu",
  ]));
  set("no_fly", 1);
  setup();
}
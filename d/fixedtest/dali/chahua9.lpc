inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "茶花园");
  set("long", @LONG
大理茶花冠绝天下，镇南王府的茶花自然更非凡品。你站在茶花
园的最高处，低头看去，满园春色，尽在目下。西望亭台楼阁，错落
有秩。
LONG );
  set("exits", ([
    "southdown" : __DIR__ "chahua7",
  ]));
  set("no_fly", 1);
  setup();
}
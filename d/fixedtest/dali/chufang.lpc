inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "厨房");
  set("long", @LONG
这是镇南王府的厨房，中央有个大桌子，周围则放着几个圆凳，
这里是段家弟子用餐的地方。
LONG );
  set("exits", ([
    "east" : __DIR__ "tingfang",
  ]));
  set("no_fly", 1);
  setup();
}
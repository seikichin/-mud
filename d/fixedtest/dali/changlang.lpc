inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "长廊");
  set("long", @LONG
这里是镇南王府的长廊，两边都是大圆柱。边上假山小湖应有尽
有，显得十分秀丽。北面是一座大建筑，南边是一个小庭院。
LONG );
  set("exits", ([
    "south" : __DIR__ "tingyuan",
    "north" : __DIR__ "tingfang",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "茶花园门");
  set("long", @LONG
大理茶花冠绝天下，镇南王府的茶花自然更非凡品。你站在茶花
园口，对着满园春色，不禁大喜过望。东边就进园了，北边是一个库
房。南边是一栋厢房，那里是休息的地方。
LONG );
  set("exits", ([
    "west" : __DIR__ "tingyuan",
    "south" : __DIR__ "xiuxishi",
    "east" : __DIR__ "chahua2",
    "north" : __DIR__ "bingqiku",
  ]));
  set("no_fly", 1);
  setup();
}
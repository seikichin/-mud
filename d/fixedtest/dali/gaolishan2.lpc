// gaolishan2 —— 由 nitan/d/dali/gaolishan2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-19230,-6890,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "高黎山密林");
  set("long", @LONG
高黎山上地势险恶、树大林深，附近几乎毫无人烟。地处高山四
季皆寒，熊虎等猛兽时常出没，只有勇敢的猎人才敢上这里来。东面
下山即是泸水谷地。
LONG );
  set("exits", ([
    "east" : __DIR__ "gaolishan1",
  ]));
  set("no_fly", 1);
  setup();
}
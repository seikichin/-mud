// yideng11 —— 由 nitan/d/dali/yideng11.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-38000,-80000,500)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "庙内厢房");
  set("long", @LONG
这里是庙的东厢房，有小沙弥奉上香茶待客。庙宇看来虽小，里
边却甚进深，一条青石铺的小径穿进后面的一座竹林，竹林绿荫森森，
幽静无比，令人烦俗尽消。竹林中隐着三间石屋。
LONG );
  set("exits", ([
    "north" : __DIR__ "yideng12",
    "out" : __DIR__ "yideng9",
  ]));
  set("no_fly", 1);
  setup();
}
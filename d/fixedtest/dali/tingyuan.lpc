// tingyuan —— 由 nitan/d/dali/tingyuan.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-19101,-6861,-1)  coor 不是 10 的倍数
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "庭院");
  set("long", @LONG
这里是镇南王府的庭院，中间一个小水潭，边上种着许多不知名
的花，几只喜鹊在花丛中蹦来跳去，花丛边有片小竹林，竹影下放着
石桌石凳，经常有人在这下棋。
LONG );
  set("exits", ([
    "south" : __DIR__ "shirenfang",
    "north" : __DIR__ "changlang",
    "east" : __DIR__ "chahua1",
    "west" : __DIR__ "shijing",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "走廊");
  set("long", @LONG
这是一条长长的走廊，通向各个客人的寝室。到了二楼，毛
毡已经换成纯白，两侧木壁上或刻有花鸟鱼虫，或挂了些许时人
的字画，每隔七八步，就有一处香台，缕缕青烟从铜鹤嘴里游出，
闻之精神一振。
LONG );
  set("exits", ([
    "enter" : __DIR__ "guibingshi1",
    "east" : __DIR__ "zoulang4",
    "west" : __DIR__ "zoulang1",
  ]));
  set("no_fly", 1);
  setup();
}
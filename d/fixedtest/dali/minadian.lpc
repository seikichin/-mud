// minadian —— 由 nitan/d/dali/minadian.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-19200,-6850,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "蜜纳甸");
  set("long", @LONG
这里是乌夷分支乌蒙族阔部聚居的镇子，阔部领蜜纳甸和阔州。
附近有溪流汇入泸水，灌溉颇便利，因而农业相对谷中其他地区较发
达。镇中尽是些简陋的民居，也无甚客商过往。
LONG );
  set("exits", ([
    "southwest" : __DIR__ "zhenxiong",
    "west" : __DIR__ "gelucheng",
  ]));
  set("no_fly", 1);
  setup();
}
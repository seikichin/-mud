// cuiping2 —— 由 nitan/d/hengshan/cuiping2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-10,3180,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "翠屏山道");
  set("long", @LONG
你爬在翠屏山道上，树木遮天，难见天日。山林静谧，隐隐晨钟轻
敲，一切尘俗尽皆洗尽，山深有静气，恒山本色。
LONG );
  set("exits", ([
    "eastdown" : __DIR__ "cuiping1",
    "eastup" : __DIR__ "xuankong1",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "官道");
  set("long", @LONG
这里是一条尘土飞扬的大官道，它是连接汝州的主干道。官
道很是宽广，足可容得下十马并驰。
LONG );
  set("exits", ([
    "east" : __DIR__ "3/0/0",
    "west" : __DIR__ "shang_road1",
  ]));
  set("no_fly", 1);
  setup();
}
// ruzhou —— nitan d/ruzhou 固定地图映射区（vrm_fixed）
//
//   ruzhou.map         地图（方向位掩码 + [LINK] 特殊出口）
//   ruzhou-room.lpc    格房描述（改文字即可改每格 look）
//   ruzhougate.lpc / ruzhougate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/ruzhou/ruzhou/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = ruzhou）
// 格索引 -> 原 coor： coor = (格索引 + (-678,183,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "ruzhou-room");
  set_maze_map(__DIR__ "ruzhou");
  set_maze_spacing(10);
  set_maze_owner_key("ruzhou");

  // 入口 = shang_huating（格 4,9,0），出口 = xiaozheng（格 2,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "ruzhougate");
  set_link_exit_room(__DIR__ "ruzhougate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-6750);
  set_link_entry_room_y(1880);
  set_link_entry_room_z(30);

  set_entry_short(HIW "花亭" NOR);
  set_entry_desc("花亭，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "汝州小镇" NOR);
  set_exit_desc("汝州小镇，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 ruzhou-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("花亭");
  set_maze_room_desc("nitan d/ruzhou 映射区。");
}
// eyutan2 —— 由 nitan/d/jueqing/eyutan2.c 转换（独立房间，不在固定地图网格内）
// 原文件无 coor
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "鄂鱼潭中");
  set("long", " ");
  set("no_fly", 1);
  setup();
}
// [nitan-auto] 由原档补回的额外函数（恢复离开房间的行为）
void init()
{       
        add_action("do_swim", ({ "swim", "you" }));
}

int do_swim(string arg)
{
        object me = this_player();
        object ob;

        if (! arg || arg != "bank" )
                return notify_fail("你要往哪儿游？\n");

        if (! ob = find_object(__DIR__"eyutan1"))
                ob = load_object(__DIR__"eyutan1");

        if (me->is_busy())
                return notify_fail("你现在正忙着呢！\n");

        if (me->is_fighting())
                return notify_fail("你还是先把你面前这个家伙解决了再说。\n");

        tell_object(me, HIY "你使尽所有力气向岸边游去…\n" NOR);
        tell_room(ob, HIC + me->name() + "游了上来。\n" NOR, me);
        me->move(ob);

        return 1;
}
// 原 coor(220,0,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "鄂鱼潭对岸");
  set("long", " ");
  set("exits", ([
    "enter" : __DIR__ "21/0/2",
  ]));
  set("no_fly", 1);
  setup();
}
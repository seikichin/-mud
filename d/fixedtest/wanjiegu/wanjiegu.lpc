// wanjiegu —— nitan d/wanjiegu 固定地图映射区（vrm_fixed）
//
//   wanjiegu.map         地图（方向位掩码 + [LINK] 特殊出口）
//   wanjiegu-room.lpc    格房描述（改文字即可改每格 look）
//   wanjiegugate.lpc / wanjiegugate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/wanjiegu/wanjiegu/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = wanjiegu）
// 格索引 -> 原 coor： coor = (格索引 + (1,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "wanjiegu-room");
  set_maze_map(__DIR__ "wanjiegu");
  set_maze_spacing(10);
  set_maze_owner_key("wanjiegu");

  // 入口 = riverside4（格 7,3,0），出口 = shan_road2（格 2,1,3）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "wanjiegugate");
  set_link_exit_room(__DIR__ "wanjiegugate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(90);
  set_link_entry_room_y(30);
  set_link_entry_room_z(50);

  set_entry_short(HIW "江边小路" NOR);
  set_entry_desc("江边小路，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "山路" NOR);
  set_exit_desc("山路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 wanjiegu-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("江边小路");
  set_maze_room_desc("nitan d/wanjiegu 映射区。");
}
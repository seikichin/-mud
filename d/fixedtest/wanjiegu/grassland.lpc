// 原 coor(120,0,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "草地");
  set("long", @LONG
这是一大片草地，前面一排松树挡住了去路。只见一株大松上削
下了丈许长、尺许宽的一片，漆着白漆，写着九个大字，『姓段者入
此谷杀无赦』。树上挂着一个铁锤。
LONG );
  set("exits", ([
    "enter" : __DIR__ "15/1/0",
  ]));
  set("no_fly", 1);
  setup();
  set("exits/north", "/d/fixedtest/wanjiegu/11/1/0");
}
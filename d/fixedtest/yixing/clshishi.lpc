// 原 coor(309,-991,-1)  coor 不是 10 的倍数
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "石室");
  set("long", @LONG
昏暗的石屋没有窗户，乃是长乐帮私设的刑堂及囚室。周围摆放
着几件刑具，墙上有些新旧不一的血痕，令人不寒而栗。室内甚是潮
湿，头顶不时滴下水珠。
LONG );
  set("exits", ([
    "west" : __DIR__ "clyongdao",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "走廊");
  set("long", @LONG
宽敞的走廊人来人往，再向内便是总舵的内宅了。西面是间干杂活
的柴房，向东有个小小的亭子。一些日常守卫的帮众警惕地注视着每个
人。
LONG );
  set("exits", ([
    "north" : __DIR__ "clzoulang2",
    "south" : __DIR__ "cldating",
    "east" : __DIR__ "clbajiaoting",
    "west" : __DIR__ "clchaifang",
  ]));
  set("no_fly", 1);
  setup();
}
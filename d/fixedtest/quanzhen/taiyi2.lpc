// taiyi2 —— 由 nitan/d/quanzhen/taiyi2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3190,180,40)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "太乙池");
  set("long", " ");
  set("no_fly", 1);
  setup();
}
// [nitan-auto] 由原档补回的额外函数（恢复离开房间的行为）
void init()
{
        add_action("do_climb", "climb");
        add_action("do_swim", "swim");
}

int do_climb(string arg)
{
        object me = this_player(); 
        int c_exp;
        c_exp=me->query("combat_exp");
        if( !arg || arg != "up")
        {
                write("那个方向没法爬。\n");
                return 1;
        }

        message_vision("$N在太乙池中往岸上爬了上去。\n", me);
        me->move("/d/fixedtest/quanzhen/0/19/7");
        message_vision("$N从太乙池中爬了上去。\n", me);
        return 1;
}

int do_swim()
{
        int c_exp,c_skill;
        object me = this_player();

        c_exp=me->query("combat_exp");
        c_skill=me->query_skill("jinyan-gong",1);
        if( me->query("qi")<10 )
                me->unconcious();
        else if( me->query_family() == "全真教" )
        {
                me->receive_damage("qi",10);
                if (((c_skill*c_skill*c_skill/10)< c_exp) && (c_skill < 51))
                        me->improve_skill("jinyan-gong", (int)me->query_skill("jinyan-gong", 1));
                message_vision("$N在太乙池中划了划水，用力游了起来。\n", me);
        }
        return 1;
}
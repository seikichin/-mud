// quanzhen —— nitan d/quanzhen 固定地图映射区（vrm_fixed）
//
//   quanzhen.map         地图（方向位掩码 + [LINK] 特殊出口）
//   quanzhen-room.lpc    格房描述（改文字即可改每格 look）
//   quanzhengate.lpc / quanzhengate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/quanzhen/quanzhen/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = quanzhen）
// 格索引 -> 原 coor： coor = (格索引 + (-319,-1,1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "quanzhen-room");
  set_maze_map(__DIR__ "quanzhen");
  set_maze_spacing(10);
  set_maze_owner_key("quanzhen");

  // 入口 = xiaolu11（格 53,15,16），出口 = shanlu1（格 4,1,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "quanzhengate");
  set_link_exit_room(__DIR__ "quanzhengate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-2920);
  set_link_entry_room_y(90);
  set_link_entry_room_z(220);

  set_entry_short(HIW "后山小路" NOR);
  set_entry_desc("后山小路，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "山路" NOR);
  set_exit_desc("山路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 quanzhen-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("后山小路");
  set_maze_room_desc("nitan d/quanzhen 映射区。");
}
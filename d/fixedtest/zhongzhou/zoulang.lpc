inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "走廊");
  set("long", @LONG
这是衙门大堂后面的走廊，走廊西面有一小石拱门，里面
是一个小花园，花丛中有两个花匠正在修剪花草。北面走廊的
尽头的门开着，不知是不是就是师爷处.
LONG );
  set("exits", ([
    "north" : __DIR__ "zoulang1",
    "east" : __DIR__ "0/7/0",
    "west" : __DIR__ "huayuan",
  ]));
  set("no_fly", 1);
  setup();
}
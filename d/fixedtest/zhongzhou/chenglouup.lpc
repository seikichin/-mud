inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "城楼二层");
  set("long", @LONG
一登上城楼，城外西面的一大片的开阔地尽收眼底，要是
在这里布上弩兵，要是有谁想攻进城来简直比登天还难。
LONG );
  set("exits", ([
    "down" : __DIR__ "chenglou",
  ]));
  set("no_fly", 1);
  setup();
}
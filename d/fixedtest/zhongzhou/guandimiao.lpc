// 原 coor(-9070,-980,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "破庙");
  set("long", @LONG
这是小巷中的一座破庙，许多残破的青砖散落在地下，从
墙洞中露出的一根大柱子已看不出本来的颜色，几个叫花子懒
散的躺在门口。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "xiaoxiang1",
    "enter" : __DIR__ "inpomiao",
  ]));
  set("no_fly", 1);
  setup();
}
// huayuan —— 由 nitan/d/zhongzhou/huayuan.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-9070,-970,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小花园");
  set("long", @LONG
这是县太爷府前的小花园，花草树木，鸟语花香。好一个
悠闲的地方。透过一簇牡丹花，北面就是县太爷的府邸。西面
的厢房略微陈旧一点。可能是府内下人的屋子。
LONG );
  set("exits", ([
    "north" : __DIR__ "taiyefu",
    "east" : __DIR__ "zoulang",
    "west" : __DIR__ "xiaren",
  ]));
  set("no_fly", 1);
  setup();
}
void create() {
  set("short", "西郊");
  set("long", @LONG
这是中原第一府「中州府」的郊外。这儿离中州不远，治
安也还说得过去。西面是洛阳城方向，东边通向中州府。
LONG );
  set("exits", ([
    "east" : __DIR__ "chenglou",
    "west" : "/d/fixedtest/luoyang/hulaoguan",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "密室");
  set("long", @LONG
这是个阴暗的密室，墙上的油灯发出昏暗的黄光。
LONG );
  set("exits", ([
    "up" : __DIR__ "5/8/5",
  ]));
  set("no_fly", 1);
  setup();
}
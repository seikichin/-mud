// men2 —— 由 nitan/d/lingjiu/men2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(40,100,50)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "书房大门");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "shufang",
    "west" : __DIR__ "4/9/5",
  ]));
  set("no_fly", 1);
  setup();
}
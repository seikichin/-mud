// midao12 —— 由 nitan/d/lingjiu/midao12.c 转换（独立房间，不在固定地图网格内）
// 原 coor(70,80,60)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "密道");
  set("long", " ");
  set("exits", ([
    "west" : __DIR__ "mishi1",
    "north" : __DIR__ "2/3/6",
    "east" : __DIR__ "2/3/6",
    "south" : __DIR__ "4/3/6",
  ]));
  set("no_fly", 1);
  setup();
}
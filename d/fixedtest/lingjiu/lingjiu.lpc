// lingjiu —— nitan d/lingjiu 固定地图映射区（vrm_fixed）
//
//   lingjiu.map         地图（方向位掩码 + [LINK] 特殊出口）
//   lingjiu-room.lpc    格房描述（改文字即可改每格 look）
//   lingjiugate.lpc / lingjiugate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/lingjiu/lingjiu/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = lingjiu）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "lingjiu-room");
  set_maze_map(__DIR__ "lingjiu");
  set_maze_spacing(10);
  set_maze_owner_key("lingjiu");

  // 入口 = midao4（格 6,10,1），出口 = shanjiao（格 6,1,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "lingjiugate");
  set_link_exit_room(__DIR__ "lingjiugate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(50);
  set_link_entry_room_y(60);
  set_link_entry_room_z(90);

  set_entry_short(HIW "密道" NOR);
  set_entry_desc("密道，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "缥缈峰山脚" NOR);
  set_exit_desc("缥缈峰山脚，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 lingjiu-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("密道");
  set_maze_room_desc("nitan d/lingjiu 映射区。");
}
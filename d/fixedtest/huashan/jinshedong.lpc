// jinshedong —— 由 nitan/d/huashan/jinshedong.c 转换（独立房间，不在固定地图网格内）
// 原文件无 coor
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIY "金蛇洞" NOR);
  set("long", " ");
  set("no_fly", 1);
  setup();
}
// [nitan-auto] 由原档补回的额外函数（恢复离开房间的行为）
void init()
{
        add_action("do_climb", "climb");
        add_action("do_ba", "ba");
        add_action("do_wa", "wa");
}


string look_sword()
{
        /*
        object ob;
  
        if (! ob = find_object(SWORD))
                ob = load_object(SWORD);

        if (! environment(ob))
        {
              destruct(ob);
              return HIG "一柄形状奇特的剑。\n" NOR;
        }
        else if (query("sword_count") > 0)
        */
        if (query("sword_count") > 0)
                return HIG "一柄形状奇特的剑。\n" NOR;

        return "你要看什么？\n";
}


int do_climb(string arg)
{
        object me = this_player();

        if (me->is_busy() || me->is_fighting())
               return notify_fail("等你忙完了再说吧！\n");

        message_vision(HIG "$N" HIG "拉着青藤爬上悬崖……\n", me);
                
        me->move("/d/huashan/chaoyang");

        me->start_busy(2);

        return 1;          
}

void reset()
{
        set("book_count", 1);
        set("sword_count", 1);
        ::reset();
}
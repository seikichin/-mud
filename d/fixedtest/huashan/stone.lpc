// stone —— 由 nitan/d/huashan/stone.c 转换（独立房间，不在固定地图网格内）
// 原文件无 coor
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "巨石上");
  set("long", " ");
  set("no_fly", 1);
  setup();
}
// [nitan-auto] 由原档补回的额外函数（恢复离开房间的行为）
void init()
{
        add_action("do_jump", "jump");
}

int do_jump()
{
        object me = this_player();

        if (me->is_busy() || me->is_fighting())
              return notify_fail("你忙完了再说吧！\n");

        message_vision(HIG "$N" HIG "纵身跳上瀑布 ……\n", me);

        me->move("/d/fixedtest/huashan/2/11/0");

        return 1;
}
// 原 coor(60,40,130)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "厨房");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "5/5/13",
  ]));
  set("no_fly", 1);
  setup();
}
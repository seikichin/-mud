inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "古隆中");
  set("long", @LONG
这是一个小村庄，但见四周群山环抱，松柏参天，溪流萦绕，景色
秀丽。相传诸葛亮幼年失去双亲，十七岁上随叔父诸葛玄来到这里隐居，
躬耕苦读。
LONG );
  set("exits", ([
    "west" : __DIR__ "shennongjia",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "南河桥");
  set("long", @LONG
这里是成都西门外南河桥。府河和南河夹城流过，呵护着这个天
府之国的首府之地。河水清新碧透。东面是西城门，往西就是浣花溪
了。
LONG );
  set("exits", ([
    "east" : __DIR__ "westgate",
    "west" : __DIR__ "path1",
  ]));
  set("no_fly", 1);
  setup();
}
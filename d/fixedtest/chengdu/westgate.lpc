inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "西门");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "0/3/0",
    "west" : __DIR__ "nanheqiaow",
  ]));
  set("no_fly", 1);
  setup();
}
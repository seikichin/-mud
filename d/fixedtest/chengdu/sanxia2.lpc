// 原 coor(-15050,-1830,-40)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "巫峡");
  set("long", @LONG
这里是长江三峡中的巫峡，也是最大最美的一个峡谷，神女峰高
高的耸立在江边，远远看去，由如一为亭亭玉立的少女，两岸风景美
不胜收。
LONG );
  set("exits", ([
    "east" : __DIR__ "sanxia1",
    "west" : __DIR__ "sanxia3",
  ]));
  set("no_fly", 1);
  setup();
}
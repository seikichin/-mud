// 原 coor(-15080,-1830,-40)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "蜀道");
  set("long", @LONG
你走在以险著称天下的蜀道上，从这里向西越过高山，就可以进
入四川盆地了，东边是去风景优美的三峡。道路十分崎岖，时而左转
时而上山，时而又要穿过森林。
LONG );
  set("exits", ([
    "east" : __DIR__ "baidicheng",
    "west" : __DIR__ "shudao12",
  ]));
  set("no_fly", 1);
  setup();
}
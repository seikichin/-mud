inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "货仓");
  set("long", @LONG
福威镖局武功并无出色之处，但福字当头，和黑白两道均极交好，
从未失镖。顾主的货物在这里堆积如山。镖局的伙计们正在手忙脚乱的
往镖车上装载货物。虽然每个伙计都已尽力而为，但还是忙不过来。
LONG );
  set("exits", ([
    "north" : __DIR__ "biaojuzf",
    "west" : __DIR__ "biaojudy",
  ]));
  set("no_fly", 1);
  setup();
}
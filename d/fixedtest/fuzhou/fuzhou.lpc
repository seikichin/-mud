// fuzhou —— nitan d/fuzhou 固定地图映射区（vrm_fixed）
//
//   fuzhou.map         地图（方向位掩码 + [LINK] 特殊出口）
//   fuzhou-room.lpc    格房描述（改文字即可改每格 look）
//   fuzhougate.lpc / fuzhougate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/fuzhou/fuzhou/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = fuzhou）
// 格索引 -> 原 coor： coor = (格索引 + (-10,-623,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "fuzhou-room");
  set_maze_map(__DIR__ "fuzhou");
  set_maze_spacing(10);
  set_maze_owner_key("fuzhou");

  // 入口 = majiu（格 3,7,0），出口 = puxian（格 2,0,0）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "fuzhougate");
  set_link_exit_room(__DIR__ "fuzhougate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-60);
  set_link_entry_room_y(-6190);
  set_link_entry_room_z(30);

  set_entry_short(HIW "马厩" NOR);
  set_entry_desc("马厩，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "莆仙平原" NOR);
  set_exit_desc("莆仙平原，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 fuzhou-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("马厩");
  set_maze_room_desc("nitan d/fuzhou 映射区。");
}
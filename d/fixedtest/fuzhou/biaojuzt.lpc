inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "正厅");
  set("long", @LONG
这里是福威镖局的正厅，几只太师椅一字排开，正中央坐着总镖头，
手持烟袋杆正在闭目沉思。墙上挂着几幅字画和一把宝剑。
LONG );
  set("exits", ([
    "south" : __DIR__ "biaojudy",
    "west" : __DIR__ "biaojunz",
    "east" : __DIR__ "biaojuzf",
    "north" : __DIR__ "biaojuhy",
  ]));
  set("no_fly", 1);
  setup();
}
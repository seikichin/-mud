// 原 coor(-110,-6170,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "西湖");
  set("long", @LONG
福州西湖原为灌溉疏浚之利而掘，汇一郭之水以为滋农时。而今，
春水环绿岛，长柳戏游鱼，已有十分景致。
LONG );
  set("exits", ([
    "south" : __DIR__ "xixiaojie",
  ]));
  set("no_fly", 1);
  setup();
}
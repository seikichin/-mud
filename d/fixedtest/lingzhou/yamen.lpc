inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "衙门");
  set("long", @LONG
这是灵州府衙所在地，黑色大门平时紧紧闭着，门前四个身着皂服
的衙役没精打采的拄着水火棍站着。边上有个大鼓。
LONG );
  set("exits", ([
    "south" : __DIR__ "6/6/1",
  ]));
  set("no_fly", 1);
  setup();
}
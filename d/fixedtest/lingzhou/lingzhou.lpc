// lingzhou —— nitan d/lingzhou 固定地图映射区（vrm_fixed）
//
//   lingzhou.map         地图（方向位掩码 + [LINK] 特殊出口）
//   lingzhou-room.lpc    格房描述（改文字即可改每格 look）
//   lingzhougate.lpc / lingzhougate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/lingzhou/lingzhou/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = lingzhou）
// 格索引 -> 原 coor： coor = (格索引 + (-633,286,-1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "lingzhou-room");
  set_maze_map(__DIR__ "lingzhou");
  set_maze_spacing(10);
  set_maze_owner_key("lingzhou");

  // 入口 = hougong（格 6,13,1），出口 = kongdi（格 10,10,1）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "lingzhougate");
  set_link_exit_room(__DIR__ "lingzhougate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-6275);
  set_link_entry_room_y(2945);
  set_link_entry_room_z(30);

  set_entry_short(HIW "后宫" NOR);
  set_entry_desc("后宫，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "林中空地" NOR);
  set_exit_desc("林中空地，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 lingzhou-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("后宫");
  set_maze_room_desc("nitan d/lingzhou 映射区。");
}
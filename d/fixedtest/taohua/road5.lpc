inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "洞口");
  set("long", @LONG
这是一条后山上的一个小山洞。洞口很小，但能容一个人
钻进去。里面黑黝黝的什么也看不见。
LONG );
  set("exits", ([
    "enter" : __DIR__ "2/7/0",
    "west" : __DIR__ "2/7/0",
  ]));
  set("no_fly", 1);
  setup();
}
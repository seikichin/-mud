// neidong —— 由 nitan/d/taohua/neidong.c 转换（独立房间，不在固定地图网格内）
// 原文件无 coor
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "清音洞");
  set("long", @LONG
这是清音洞内洞，潮湿异常，洞顶水珠颗颗坠下，滴在地面的小水洼
中，叮咚做响。这里光线太暗，大概需要火折照明。
LONG );
  set("exits", ([
    "north" : __DIR__ "neidong",
    "west" : __DIR__ "neidong",
    "east" : __DIR__ "neidong",
    "south" : __DIR__ "neidong",
  ]));
  set("no_fly", 1);
  setup();
}
// [nitan-auto] 由原档补回的额外函数（恢复离开房间的行为）
void init()
{
        add_action("do_use","use");
}

int do_use(string arg)
{
        object me = this_player();

        if (! arg || arg == "") 
                return 0;
                
        if (! present("fire", me))  
                return 0;
                
        if (arg == "fire") 
        {
                tell_object(me, "借着火光映照，你走出洞外。\n");
                     me->move("/d/fixedtest/taohua/6/3/2");
        }
        return 1;
}

int valid_leave(object me, string dir)
{
        int kar;

        kar=80-me->query("kar");

        if (random(kar) == 1) 
        {
                tell_object(me, "你走得精疲力尽，终于到了洞外。\n");
                me->move("/d/fixedtest/taohua/6/3/2");
                return 1;
        }

        return ::valid_leave(me,dir);
}
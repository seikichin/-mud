inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "桃花山庄正门");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "tingzi",
    "east" : __DIR__ "0/6/0",
    "south" : __DIR__ "qianyuan",
  ]));
  set("no_fly", 1);
  setup();
}
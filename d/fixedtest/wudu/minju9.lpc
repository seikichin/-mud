// 原 coor(80,90,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "供桌下");
  set("long", @LONG
你现在蜷缩在低矮的供桌下面，四周到处都是灰尘和蜘蛛
网，稍一抬头就会碰到桌面。这张桌子的四周都被肮脏的布帘
挡住了，你看不到外面的情况，别人也发现不了你。 
LONG );
  set("exits", ([
    "out" : __DIR__ "7/9/0",
  ]));
  set("no_fly", 1);
  setup();
}
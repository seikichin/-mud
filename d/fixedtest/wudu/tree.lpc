// tree —— 由 nitan/d/wudu/tree.c 转换（独立房间，不在固定地图网格内）
// 原 coor(80,40,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "榕树上");
  set("long", @LONG
这里是大榕树的顶端，四周是浓密的枝叶和湿漉漉的苔藓。
突然间一阵微风吹来，树叶发出唰啦啦的声音。从上面望下去
你只觉得一阵眼晕，心想还是赶快下去吧。
LONG );
  set("exits", ([
    "down" : __DIR__ "8/4/2",
  ]));
  set("no_fly", 1);
  setup();
}
// xiaolu —— 由 nitan/d/wudu/xiaolu.c 转换（独立房间，不在固定地图网格内）
// 原 coor(170,30,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小路");
  set("long", @LONG
这是一条小路向东南延伸，四周尽是花香鸟语，空气顿时
清新了许多。前面有一座小小的山冈。
LONG );
  set("exits", ([
    "northwest" : __DIR__ "17/2/3",
    "southup" : __DIR__ "18/3/3",
  ]));
  set("no_fly", 1);
  setup();
}
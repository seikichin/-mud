// minju8 —— 由 nitan/d/wudu/minju8.c 转换（独立房间，不在固定地图网格内）
// 原 coor(40,110,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "灶房");
  set("long", @LONG
这是一个简陋的灶房，四壁都被烟火熏的黑糊糊的，灶台旁的墙
上贴着一张发黄的黄裱纸，旁边挂着一些风干的兽肉。灶台铁锅旁的
水缸上摆着几只粗瓷大碗，屋的一角堆着一大堆麦秸。 
LONG );
  set("exits", ([
    "east" : __DIR__ "4/10/0",
  ]));
  set("no_fly", 1);
  setup();
}
// xiaodian —— 由 nitan/d/wudu/xiaodian.c 转换（独立房间，不在固定地图网格内）
// 原 coor(180,10,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "路边小店");
  set("long", @LONG
这里是一家山野小店，仅仅供应一些食物和时鲜山货。这里行人
稀少，大概一天也没几个人路过这里，老板娘把店开在这里恐怕是要
赔了。店内进是一间客房，行人累了可以进去休息。
LONG );
  set("exits", ([
    "east" : __DIR__ "17/1/3",
    "west" : __DIR__ "neijin",
  ]));
  set("no_fly", 1);
  setup();
}
// xuanminggu —— nitan d/xuanminggu 固定地图映射区（vrm_fixed）
//
//   xuanminggu.map         地图（方向位掩码 + [LINK] 特殊出口）
//   xuanminggu-room.lpc    格房描述（改文字即可改每格 look）
//   xuanminggugate.lpc / xuanminggugate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/xuanminggu/xuanminggu/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = xuanminggu）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "xuanminggu-room");
  set_maze_map(__DIR__ "xuanminggu");
  set_maze_spacing(10);
  set_maze_owner_key("xuanminggu");

  // 入口 = xiaolu1（格 7,0,0），出口 = xuanmingfeng（格 0,7,4）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "xuanminggugate");
  set_link_exit_room(__DIR__ "xuanminggugate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(40);
  set_link_entry_room_y(40);
  set_link_entry_room_z(60);

  set_entry_short(HIW "小路" NOR);
  set_entry_desc("小路，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "玄冥峰" NOR);
  set_exit_desc("玄冥峰，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 xuanminggu-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("小路");
  set_maze_room_desc("nitan d/xuanminggu 映射区。");
}
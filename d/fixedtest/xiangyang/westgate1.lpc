// 原 coor(-7860,-770,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "白虎内门");
  set("long", " ");
  set("exits", ([
    "southup" : __DIR__ "wallw2",
    "east" : __DIR__ "westjie3",
    "northup" : __DIR__ "wallw1",
    "west" : __DIR__ "westgate2",
  ]));
  set("no_fly", 1);
  setup();
}
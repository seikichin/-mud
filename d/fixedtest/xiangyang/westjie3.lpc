// westjie3 —— 由 nitan/d/xiangyang/westjie3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-7850,-770,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "西大街");
  set("long", @LONG
这是一条宽阔的青石街道，向东西两头延伸。西面是白虎内门，
东边是一个大十字街口，只见人来人往，络绎不绝。南边是大校场。
北面是襄阳城的西兵营，隐隐能听见里面传来的宋兵的操练声。
LONG );
  set("exits", ([
    "north" : __DIR__ "bingying4",
    "south" : __DIR__ "dajiaochang",
    "east" : __DIR__ "0/4/0",
    "west" : __DIR__ "westgate1",
  ]));
  set("no_fly", 1);
  setup();
}
// 原 coor(-7830,-820,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "草地");
  set("long", @LONG
这是襄阳城外的草地。蒙古兵进犯以来，这里的百姓全进城了，
这里几十里都没了人烟。
LONG );
  set("exits", ([
    "east" : __DIR__ "southgate2",
  ]));
  set("no_fly", 1);
  setup();
}
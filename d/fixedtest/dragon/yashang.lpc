// yashang —— 由 nitan/d/dragon/yashang.c 转换（独立房间，不在固定地图网格内）
// 原 coor(150,0,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "叠嶂峰");
  set("long", "[1;32m这里群峰叠嶂，都是一根而出，看似群峰，也难说清究竟该\n"
"有多少。然而，山峰虽众，却唯此一峰独尊。一株奇异的小草长在山峰绝\n"
"高之处，瑞气祥云皆由此而来。\n");
  set("exits", ([
    "down" : __DIR__ "13/0/1",
  ]));
  set("no_fly", 1);
  setup();
}
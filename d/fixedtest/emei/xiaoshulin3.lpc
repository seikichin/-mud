inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小树林");
  set("long", @LONG
这是峨嵋山金顶华藏庵外的一片小树林。林中没有路，但地上依
稀有些足迹，似乎刚有人走过。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "xiaoshulin4",
    "north" : __DIR__ "xiaoshulin2",
  ]));
  set("no_fly", 1);
  setup();
}
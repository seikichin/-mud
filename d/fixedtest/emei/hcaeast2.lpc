inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "华藏庵东廊");
  set("long", @LONG
这里是峨嵋华藏庵东廊。走廊往南通往斋堂，北通往广场。
LONG );
  set("exits", ([
    "north" : __DIR__ "hcaeast1",
    "south" : __DIR__ "hcazhaitang",
  ]));
  set("no_fly", 1);
  setup();
}
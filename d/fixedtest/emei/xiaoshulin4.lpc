inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小树林");
  set("long", @LONG
这是峨嵋山金顶华藏庵外的一片小树林。北边是峨嵋派女弟子们
的寝宫的窗户，窗下好像蹲着一个人。
LONG );
  set("exits", ([
    "northwest" : __DIR__ "xiaoshulin3",
    "north" : __DIR__ "qinggong",
  ]));
  set("no_fly", 1);
  setup();
}
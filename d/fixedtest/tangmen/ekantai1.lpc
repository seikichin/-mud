// ekantai1 —— 由 nitan/d/tangmen/ekantai1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(60,70,50)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "东较武场看台");
  set("long", "这是唐门的东较武场看台。虽然对于看比武大赛来说，这里不是最佳\n"
"的位置，但是这里是喝彩声最响的地方。因为聚在这里的，通常是唐门的\n"
"晚辈弟子，最随便，最冲动，也最有激情。南面，是东较武场的中间看台。\n");
  set("exits", ([
    "south" : __DIR__ "6/6/4",
  ]));
  set("no_fly", 1);
  setup();
}
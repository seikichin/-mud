// tjpuzi —— 由 nitan/d/tangmen/tjpuzi.c 转换（独立房间，不在固定地图网格内）
// 原 coor(180,20,40)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "唐家铺子");
  set("long", "这是唐门世家的杂货铺，大箱小箱堆满了一地，都是一些日常用品。\n"
"唐掌柜正精神抖擞地注意着过往行人。据说这儿是唐门的一个情报点，有\n"
"许多重要的情报是从这儿出去的。门口挂着一个幌子（sign）。\n");
  set("exits", ([
    "south" : __DIR__ "17/1/4",
  ]));
  set("no_fly", 1);
  setup();
}
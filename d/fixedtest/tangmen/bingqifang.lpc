// bingqifang —— 由 nitan/d/tangmen/bingqifang.c 转换（独立房间，不在固定地图网格内）
// 原 coor(60,90,50)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "兵器房");
  set("long", "这里是蜀中唐门的兵器房，房间很大却充满了一股萧杀之气，靠墙摆\n"
"放着几个兵器架，其中一个架子上面摆放着一些唐门秘制的暗器和兵器，\n"
"其它的几个架子上则是江湖中常用的兵器。\n");
  set("exits", ([
    "south" : __DIR__ "6/8/4",
  ]));
  set("no_fly", 1);
  setup();
}
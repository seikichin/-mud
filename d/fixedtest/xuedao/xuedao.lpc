// xuedao —— nitan d/xuedao 固定地图映射区（vrm_fixed）
//
//   xuedao.map         地图（方向位掩码 + [LINK] 特殊出口）
//   xuedao-room.lpc    格房描述（改文字即可改每格 look）
//   xuedaogate.lpc / xuedaogate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/xuedao/xuedao/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = xuedao）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "xuedao-room");
  set_maze_map(__DIR__ "xuedao");
  set_maze_spacing(10);
  set_maze_owner_key("xuedao");

  // 入口 = nroad7（格 2,9,1），出口 = nroad4（格 0,5,1）
  set_entry_dir("east");
  set_link_entry_room(__DIR__ "xuedaogate");
  set_link_exit_room(__DIR__ "xuedaogate2");
  set_entry_back_dir("east");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(40);
  set_link_entry_room_y(50);
  set_link_entry_room_z(60);

  set_entry_short(HIW "山路" NOR);
  set_entry_desc("山路，从这里可以进入迷宫（east）。\n");
  set_exit_short(HIY "雪山山路" NOR);
  set_exit_desc("雪山山路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 xuedao-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("山路");
  set_maze_room_desc("nitan d/xuedao 映射区。");
}
// yidao1 —— 由 nitan/d/city2/yidao1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(120,0,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "城外驿道");
  set("long", @LONG
这里是通往大宋京城的驿道，由于连年来战火不止，显得格外地
荒凉，不时有来往的马匹飞奔而过，溅起一土尘烟，沿途不时有土匪
大盗出现，还是少作停留的好。
LONG );
  set("exits", ([
    "east" : "/d/fixedtest/xiangyang/westgate2",
    "west" : __DIR__ "yidao2",
  ]));
  set("no_fly", 1);
  setup();
}
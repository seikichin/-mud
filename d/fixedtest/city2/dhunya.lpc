// dhunya —— 由 nitan/d/city2/dhunya.c 转换（独立房间，不在固定地图网格内）
// 原 coor(0,0,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIB"断魂崖"NOR);
  set("long", @LONG
这里就是天险断魂崖了，是扼守南北的交通必经之路，历来为兵
家必争之地，由山顶币制而下，只有一条狭窄的羊肠小道，两面则是
万丈深渊，看来断肠二字，名不虚传。
LONG );
  set("exits", ([
    "east" : __DIR__ "shanlu3",
    "south" : __DIR__ "shanlu2",
  ]));
  set("no_fly", 1);
  setup();
}
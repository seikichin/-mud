// yidao2 —— 由 nitan/d/city2/yidao2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(110,0,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "城外驿道");
  set("long", @LONG
这里是通往大宋京城的驿道，由于连年来战火不止，显得格外地
荒凉，不时有来往的马匹飞奔而过，溅起一土尘烟，沿途不时有土匪
大盗出现，还是少作停留的好。
LONG );
  set("exits", ([
    "east" : __DIR__ "yidao2",
    "west" : __DIR__ "yidao2",
  ]));
  set("no_fly", 1);
  setup();
}
// [nitan-auto] 由原档补回的额外函数（恢复离开房间的行为）
void init()
{
        object me=this_player();

        if (! me->is_busy())
                me->start_busy(random(2));

        tell_object(me,YEL"你快马加鞭，一路飞驰在驿道上......\n"NOR);
}

int valid_leave(object me,string dir)
{
        object dadao,*env;
        int i,flag;
        int n;
  
        /*
        env=all_inventory(environment(me));   
        n = sizeof(filter_array(env, (: $1->query("id") == "jiangyang dadao" :)));
        flag=0;

        for(i=0;i<sizeof(env);i++)
        {
                if( objectp(env[i]) && env[i]->query("id") == "jiangyang dadao"
                &&  env[i]->query("killer") == me->query("id") )
                        flag=1;
        }

        if( me->query_temp("warquest/purchase") && n < 20 && random(12)>10 )
        {
                dadao=new(__DIR__"npc/dadao");
                dadao->set_from_me(me);
                dadao->set_temp("warquest/party", "meng");
                dadao->move(environment(me));
                dadao->kill_ob(me);
                me->kill_ob(dadao);
                return notify_fail("忽然从路边丛林中杀出一路人马！\n");
        } else
        if(flag)
                return notify_fail("江阳大盗挡住了你的去路。\n");
        */

        if( dir == "east" )
                me->add_temp("yidao/mark_steps", -random(2));
        if(  dir == "west" )
                me->add_temp("yidao/mark_steps", random(2));

        if( me->query_temp("yidao/mark_steps")>11 )
        {
                me->move("/d/fixedtest/city2/8/0/0");
                me->delete_temp("yidao");
                tell_object(me,YEL"一路风尘仆仆之后，汴梁已经近在眼前了......\n"NOR);
                return 0;
        } 

        if( me->query_temp("yidao/mark_steps")<-11 )
        {
                me->move(__DIR__"yidao1");
                me->delete_temp("yidao");
                tell_object(me,YEL"一路风尘仆仆之后，襄阳已经近在眼前了......\n"NOR); 
                return 0;
        }
        
        if (! me->is_busy())
                me->start_busy(random(2));

        tell_object(me,YEL"你快马加鞭，一路飞驰在驿道上......\n"NOR);
        return 0;
        
        return ::valid_leave(me,dir);
}
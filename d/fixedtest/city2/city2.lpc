// city2 —— nitan d/city2 固定地图映射区（vrm_fixed）
//
//   city2.map         地图（方向位掩码 + [LINK] 特殊出口）
//   city2-room.lpc    格房描述（改文字即可改每格 look）
//   city2gate.lpc / city2gate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/city2/city2/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = city2）
// 格索引 -> 原 coor： coor = (格索引 + (2,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "city2-room");
  set_maze_map(__DIR__ "city2");
  set_maze_spacing(10);
  set_maze_owner_key("city2");

  // 入口 = cddian（格 8,13,0），出口 = yidao3（格 8,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "city2gate");
  set_link_exit_room(__DIR__ "city2gate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(70);
  set_link_entry_room_y(70);
  set_link_entry_room_z(20);

  set_entry_short(HIW "承德殿" NOR);
  set_entry_desc("承德殿，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "城外驿道" NOR);
  set_exit_desc("城外驿道，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 city2-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("承德殿");
  set_maze_room_desc("nitan d/city2 映射区。");
}
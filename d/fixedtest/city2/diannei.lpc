// diannei —— 由 nitan/d/city2/diannei.c 转换（独立房间，不在固定地图网格内）
// 原 coor(110,130,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIY"承德殿内"NOR);
  set("long", @LONG
这里是承德殿内，也是大宋皇帝和文武百官议事的地方，殿内金
碧辉煌，煞是雄伟壮观，大殿的正中央的龙椅上端坐的是宋徽宗，两
面分立着众宫女太监，文武百官依品次排列左右。
LONG );
  set("exits", ([
    "out" : __DIR__ "8/13/0",
  ]));
  set("no_fly", 1);
  setup();
}
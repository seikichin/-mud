// yaowang —— nitan d/yaowang 固定地图映射区（vrm_fixed）
//
//   yaowang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   yaowang-room.lpc    格房描述（改文字即可改每格 look）
//   yaowanggate.lpc / yaowanggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/yaowang/yaowang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = yaowang）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "yaowang-room");
  set_maze_map(__DIR__ "yaowang");
  set_maze_spacing(10);
  set_maze_owner_key("yaowang");

  // 入口 = zhuang3（格 13,7,0），出口 = lcd01（格 15,4,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "yaowanggate");
  set_link_exit_room(__DIR__ "yaowanggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(160);
  set_link_entry_room_y(100);
  set_link_entry_room_z(80);

  set_entry_short(HIW "梅花桩一" NOR);
  set_entry_desc("梅花桩一，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "泥泞小路" NOR);
  set_exit_desc("泥泞小路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 yaowang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("梅花桩一");
  set_maze_room_desc("nitan d/yaowang 映射区。");
}
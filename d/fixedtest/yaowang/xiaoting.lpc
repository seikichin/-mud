// xiaoting —— 由 nitan/d/yaowang/xiaoting.c 转换（独立房间，不在固定地图网格内）
// 原 coor(240,0,10)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "书房内厅");
  set("long", @LONG
这里是书房内厅，靠墙放着一排书架，窗前的小几上一个小
书童正在其间抄写着什么。
LONG );
  set("exits", ([
    "out" : __DIR__ "25/0/0",
  ]));
  set("no_fly", 1);
  setup();
}
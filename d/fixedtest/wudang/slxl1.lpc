// slxl1 —— 由 nitan/d/wudang/slxl1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-330,-180,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "松林小路");
  set("long", @LONG
这是山脚松林中的小路，两边长满参天的红松树，只能看见一线
天空。路旁有道士在奋力砍树。西边通向密林深处，东边可回大道。
LONG );
  set("exits", ([
    "east" : __DIR__ "wdroad10",
    "west" : __DIR__ "slxl2",
  ]));
  set("no_fly", 1);
  setup();
}
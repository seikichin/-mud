// tyroad6 —— 由 nitan/d/wudang/tyroad6.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-320,-300,50)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "崎岖山路");
  set("long", " ");
  set("exits", ([
    "westup" : __DIR__ "tyroad5",
    "southdown" : __DIR__ "tyroad7",
  ]));
  set("no_fly", 1);
  setup();
}
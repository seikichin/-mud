// caolianfang —— 由 nitan/d/wudang/caolianfang.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-390,-300,100)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "操练房");
  set("long", @LONG
这是二楼操练房上，四面八方都是打斗声，武当弟子来去匆匆，
都在忙着操练。
LONG );
  set("exits", ([
    "eastdown" : __DIR__ "xilang",
    "west" : __DIR__ "caolian3",
    "north" : __DIR__ "caolian2",
    "south" : __DIR__ "caolian1",
  ]));
  set("no_fly", 1);
  setup();
}
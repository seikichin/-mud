void create() {
  set("short", "青石大道");
  set("long", @LONG
你走在一条青石大道上，北边隐约可见到扬州城的南城墙。
此处往东南望去，可以看到一个市镇。
LONG );
  set("exits", ([
    "north" : __DIR__ "wdroad1",
    "west" : "/d/fixedtest/hudie/shanbi",
    "southeast" : "/d/fixedtest/yixing/0/2/0",
    "south" : __DIR__ "wdroad3",
  ]));
  set("no_fly", 1);
  setup();
}
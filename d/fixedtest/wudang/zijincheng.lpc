// zijincheng —— 由 nitan/d/wudang/zijincheng.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-350,-430,180)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "紫金城");
  set("long", @LONG
这是守护金殿的紫金城墙，周长三里，城墙由花岗石依山势砌成，
东西北城门均面临绝壁，南门为上下路口，气势壮观。
LONG );
  set("exits", ([
    "south" : __DIR__ "jindian",
    "north" : __DIR__ "jinding",
  ]));
  set("no_fly", 1);
  setup();
}
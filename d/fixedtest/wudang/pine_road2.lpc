inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "松林小路");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "pine_road",
    "south" : __DIR__ "pine_forest1",
  ]));
  set("no_fly", 1);
  setup();
}
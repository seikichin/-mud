// ============================================================
//  wudang-room.lpc  ——  nitan d/wudang 映射区（4x6x4）房间模板
//  由 nitan_build.aardio 自动生成，可自由修改文字
//
//  数据表 maze_cell_desc 的键 = 格索引 ""x,y,z""（从 0 开始，与 wudang.map 一致）
//  值 = ({ 短描述, 长描述 })
//  改这里的文字即可直接改变对应格子的 look 结果。
//
//  原 coor 与格索引的换算： coor = (格索引 + (-37,-34,9)) * 10
//  一格多间房时：短描述取主房，长描述按房间拼接（源房名见行末注释）
//
//  short/long 保留 nitan 原文的 LPC 表达式（heredoc / 颜色宏），
//  因此 ANSI 颜色（HIW / HIY / NOR 等）与原文完全一致。
// ============================================================

inherit ROOM;
#include <ansi.h>


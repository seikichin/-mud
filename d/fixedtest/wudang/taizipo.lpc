// taizipo —— 由 nitan/d/wudang/taizipo.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-370,-240,60)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "太子坡");
  set("long", @LONG
此处地处坡陀之隘，形势险要，相传净乐国太子少年真武入山修
道时，曾在此留住读书，故名叫太子坡，好象一朵出水芙蓉，涌出绿
波，瓣萼历历可数。远处峰回路转，忽明忽灭尽在云雾之中。
LONG );
  set("exits", ([
    "northdown" : __DIR__ "shanlu1",
    "east" : __DIR__ "fuzhenguan",
    "southdown" : __DIR__ "shiliang",
  ]));
  set("no_fly", 1);
  setup();
}
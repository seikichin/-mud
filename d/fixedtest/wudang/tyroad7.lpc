// 原 coor(-320,-310,40)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "崎岖山路");
  set("long", " ");
  set("exits", ([
    "northup" : __DIR__ "tyroad6",
    "eastdown" : __DIR__ "tyroad8",
  ]));
  set("no_fly", 1);
  setup();
}
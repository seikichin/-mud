inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "青石大道");
  set("long", @LONG
你走在一条青石大道上，四周静悄悄的。
LONG );
  set("exits", ([
    "north" : __DIR__ "wdroad2",
    "south" : __DIR__ "wdroad4",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "桃园");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "gyroad1",
    "west" : __DIR__ "tyroad12",
  ]));
  set("no_fly", 1);
  setup();
}
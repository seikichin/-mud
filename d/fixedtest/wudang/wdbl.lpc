// wdbl —— 由 nitan/d/wudang/wdbl.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-370,-210,50)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "武当柏林");
  set("long", @LONG
你穿行在一片茂密的柏林中，阴森郁翠，怪石嶙峋，草深没人。
不时地有兔子从你的身边飞跑而过。
LONG );
  set("exits", ([
    "southup" : __DIR__ "haohanpo",
    "northdown" : __DIR__ "yuzhengong",
  ]));
  set("no_fly", 1);
  setup();
}
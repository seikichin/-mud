// mozhenjing —— 由 nitan/d/wudang/mozhenjing.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-360,-230,50)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "磨针井");
  set("long", @LONG
相传当年真武进山修炼，日久思归，偶遇一老妇持铁杵研磨。问
磨杵为何？答以磨针。又问铁杵岂能磨针？答云功到自然成。真武由
此醒悟，终于修炼成仙。后人因建磨针井道观以为纪念。殿前立大铁
杵一根，殿旁有老母亭，亭正中有井。
LONG );
  set("exits", ([
    "west" : __DIR__ "shanlu1",
  ]));
  set("no_fly", 1);
  setup();
}
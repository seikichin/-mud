// 原 coor(-390,-290,100)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "北间操练房");
  set("long", @LONG
这里摆满了大刀长剑、沙袋绑腿等，是武当弟子日常练功的地方。
LONG );
  set("exits", ([
    "south" : __DIR__ "caolianfang",
  ]));
  set("no_fly", 1);
  setup();
}
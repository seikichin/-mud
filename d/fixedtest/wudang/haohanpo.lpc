// haohanpo —— 由 nitan/d/wudang/haohanpo.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-370,-220,60)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "好汉坡");
  set("long", @LONG
此处连绵十几里山势陡峭，名为好汉坡，山路两旁种满了细竹，
翠色横空景象怡人，不知不觉让你忘记爬坡的疲劳。坡顶有一座回龙
观，是展望岳顶的最佳去处，但见天柱峰青紫插天，如在眼前，而相
去实际上还有五十里。
LONG );
  set("exits", ([
    "southdown" : __DIR__ "shanlu1",
    "northdown" : __DIR__ "wdbl",
  ]));
  set("no_fly", 1);
  setup();
}
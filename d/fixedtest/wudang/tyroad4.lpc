// 原 coor(-330,-290,70)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "崎岖山路");
  set("long", " ");
  set("exits", ([
    "westup" : __DIR__ "tyroad3",
    "southdown" : __DIR__ "tyroad5",
  ]));
  set("no_fly", 1);
  setup();
}
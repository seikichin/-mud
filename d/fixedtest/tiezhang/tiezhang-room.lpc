LONG  }),  // coor(0,120,90)  xzfeng
  "6,12,9" : ({ HIR "拇指峰" NOR, " " }),  // coor(60,120,90)  mzfeng
  "3,19,9" : ({ "山路", @LONG
你走在一条崎岖的山路上，道旁山峰壁立，长草过腰，中间一条羊肠小
路，仅容一人勉强过去。
LONG  }),  // coor(30,190,90)  shanlu-9
  "3,20,10" : ({ HIR "中指峰" NOR, @LONG
这里就是铁掌山的最高峰——中指峰。由于山势太高，峰顶仍存有大量
的积雪，白雪皑皑，在阳光的照射下，泛起一片耀眼的银光。纵目远眺，湘
西几百里景色尽收眼底，泸溪，辰溪如两条玉带，从山下缓缓流过。远处那
条白色的亮线，就是湘西的大江——沅江。
LONG  }),  // coor(30,200,100)  zzfeng
]);

void setup_room_desc(object room, int length, int width, int height, int x, int y, int z) {
  string key;
  mixed info;

  key = sprintf("%d,%d,%d", x, y, z);
  info = maze_cell_desc[key];

  if (arrayp(info) && sizeof(info) >= 2) {
    room->set("short", info[0]);
    room->set("long", info[1]);
  } else {
    // 表里没有的格子（地图新增格）的兜底描述
    room->set("short", HIB "街巷" NOR);
    room->set("long", "空旷的街巷，看不出有什么特别之处。\n");
  }

  room->set("map_x", x);
  room->set("map_y", y);
  room->set("map_z", z);

  room->setup();
}

// 预留：按坐标放怪物 / 物品
void setup_npc_obj(object room, int length, int width, int height, int x, int y, int z) {
  return;
}

int setup_entry_room() { return 1; }
int setup_exit_room() { return 1; }
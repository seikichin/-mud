// tiezhang —— nitan d/tiezhang 固定地图映射区（vrm_fixed）
//
//   tiezhang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   tiezhang-room.lpc    格房描述（改文字即可改每格 look）
//   tiezhanggate.lpc / tiezhanggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/tiezhang/tiezhang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = tiezhang）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "tiezhang-room");
  set_maze_map(__DIR__ "tiezhang");
  set_maze_spacing(10);
  set_maze_owner_key("tiezhang");

  // 入口 = shijie-3（格 10,5,4），出口 = zzfeng（格 3,20,10）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "tiezhanggate");
  set_link_exit_room(__DIR__ "tiezhanggate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(50);
  set_link_entry_room_y(100);
  set_link_entry_room_z(120);

  set_entry_short(HIW "石阶" NOR);
  set_entry_desc("石阶，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "中指峰" NOR);
  set_exit_desc("中指峰，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 tiezhang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("石阶");
  set_maze_room_desc("nitan d/tiezhang 映射区。");
}
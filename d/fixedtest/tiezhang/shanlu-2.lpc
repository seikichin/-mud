// shanlu-2 —— 由 nitan/d/tiezhang/shanlu-2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(30,40,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG
你走在一条崎岖的山路上，道旁山峰壁立，长草过腰，中间一条羊肠小
路，仅容一人勉强过去。
LONG );
  set("exits", ([
    "south" : "/d/fixedtest/tiezhang/3/3/2",
    "north" : "/d/fixedtest/tiezhang/3/5/2",
  ]));
  set("no_fly", 1);
  setup();
}
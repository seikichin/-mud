// hudie —— nitan d/hudie 固定地图映射区（vrm_fixed）
//
//   hudie.map         地图（方向位掩码 + [LINK] 特殊出口）
//   hudie-room.lpc    格房描述（改文字即可改每格 look）
//   hudiegate.lpc / hudiegate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/hudie/hudie/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = hudie）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "hudie-room");
  set_maze_map(__DIR__ "hudie");
  set_maze_spacing(10);
  set_maze_owner_key("hudie");

  // 入口 = shufang（格 4,8,0），出口 = huacong1（格 1,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "hudiegate");
  set_link_exit_room(__DIR__ "hudiegate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(20);
  set_link_entry_room_y(50);
  set_link_entry_room_z(30);

  set_entry_short(HIW "书房" NOR);
  set_entry_desc("书房，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "花丛中" NOR);
  set_exit_desc("花丛中，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 hudie-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("书房");
  set_maze_room_desc("nitan d/hudie 映射区。");
}
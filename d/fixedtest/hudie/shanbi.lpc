// shanbi —— 由 nitan/d/hudie/shanbi.c 转换（独立房间，不在固定地图网格内）
// 原 coor(80,-170,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山壁");
  set("long", " ");
  set("exits", ([
    "east" : "/d/fixedtest/wudang/wdroad2",
  ]));
  set("no_fly", 1);
  setup();
  set("exits/right", "/d/fixedtest/hudie/1/0/0");
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "居庸关");
  set("long", " ");
  set("exits", ([
    "south" : __DIR__ "nroad2",
    "north" : "/d/fixedtest/mobei/7/0/0",
    "east" : __DIR__ "badaling",
    "west" : __DIR__ "changcheng1",
  ]));
  set("no_fly", 1);
  setup();
}
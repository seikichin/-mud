// nansilou —— 由 nitan/d/changcheng/nansilou.c 转换（独立房间，不在固定地图网格内）
// 原 coor(2000,5000,100)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "南四楼");
  set("long", WHT@LONG
一旦爬上十分陡峭的南四楼，你终于知道了“不到长城非好汉”的
况味了。疲惫之余，临风怡然远眺，东边是三十里长的关沟，似乎近在
咫尺。南面群山万壑之外，就是京城了。
LONG NOR);
  set("exits", ([
    "eastdown" : __DIR__ "changcheng22",
    "northdown" : __DIR__ "beisilou",
  ]));
  set("no_fly", 1);
  setup();
}
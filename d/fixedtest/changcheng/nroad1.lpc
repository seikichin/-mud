// 原 coor(-190,4500,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大驿道");
  set("long", @LONG
你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的、行商
的、赶着大车的马夫、大多数人都是向南去京城，熙熙攘攘，非常热闹。
不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁是整整
齐齐的杨树林。从这里远远的就可以望见北京城的北城门。
LONG );
  set("exits", ([
    "north" : __DIR__ "nroad2",
    "south" : "/d/fixedtest/beijing/4/14/0",
  ]));
  set("no_fly", 1);
  setup();
}
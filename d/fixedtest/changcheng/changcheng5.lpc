// changcheng5 —— 由 nitan/d/changcheng/changcheng5.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-4000,5000,80)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "长城");
  set("long", WHT @LONG
这里就是举世闻名的──长城。站在长城上，你可以看到四周群山
环绕，山上可以看见不少矮矮的灌木丛，但有的地方已经露出了一片片
的黄土地，举目望去，你脚下的长城顺着山脊象一条巨龙般蜿蜒的向东
和向西延伸出去。从这里向东你隐隐约约可以看到东边似乎有一座很大
的关卡。
LONG NOR);
  set("exits", ([
    "eastdown" : "/d/fixedtest/changcheng/changcheng4",
    "west" : "/d/fixedtest/changcheng/changcheng6",
  ]));
  set("no_fly", 1);
  setup();
}
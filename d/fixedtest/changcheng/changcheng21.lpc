// changcheng21 —— 由 nitan/d/changcheng/changcheng21.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-17000,9000,90)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "长城");
  set("long", WHT@LONG
由于长期受到风沙的侵蚀，不少城墙已经倒塌。墙角的黄沙中有许
多从城墙上掉下来的青砖。前面不远处就是长城的终点──嘉峪关。由
于这里是西域通往关内的必经之路，所以人也多了起来。只见许多碧眼
金发的商人带着他们的商队匆匆向离去。
LONG NOR);
  set("exits", ([
    "southwest" : __DIR__ "jiayuguan",
    "east" : __DIR__ "changcheng20",
  ]));
  set("no_fly", 1);
  setup();
}
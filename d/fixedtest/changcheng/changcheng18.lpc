// changcheng18 —— 由 nitan/d/changcheng/changcheng18.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-14000,11000,90)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "长城");
  set("long", WHT @LONG
你已经绕过了倒塌的城墙，又回到了长城上。站在坚实的城砖上，
你高兴的唱起歌来“万里长城永不倒。。。。。。”，歌声在空旷的山
上传了很远，很远。
LONG NOR);
  set("exits", ([
    "southwest" : __DIR__ "changcheng19",
    "eastdown" : __DIR__ "changcheng17",
  ]));
  set("no_fly", 1);
  setup();
}
// shanmen —— 由 nitan/d/huangshan/shanmen.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-600,-1110,-20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "黄山山门");
  set("long", @LONG
这是一座石雕门坊，过了山门后，便是黄山，这里地属丘陵，古代
称为黔山，因山色黝黑，远望如黛得名，后因唐明皇听信“黄帝在此飞
升”，所以改为黄山。连绵百里，群峰无数，引来无数游人。过山门后，
便是温泉。
LONG );
  set("exits", ([
    "northup" : __DIR__ "1/0/2",
    "southwest" : "/d/fixedtest/henshan/13/4/1",
  ]));
  set("no_fly", 1);
  setup();
}
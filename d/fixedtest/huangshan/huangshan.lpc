// huangshan —— nitan d/huangshan 固定地图映射区（vrm_fixed）
//
//   huangshan.map         地图（方向位掩码 + [LINK] 特殊出口）
//   huangshan-room.lpc    格房描述（改文字即可改每格 look）
//   huangshangate.lpc / huangshangate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/huangshan/huangshan/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = huangshan）
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "huangshan-room");
  set_maze_map(__DIR__ "huangshan");
  set_maze_spacing(10);
  set_maze_owner_key("huangshan");

  set_entry_dir("up");
  set_link_entry_room(__DIR__ "huangshangate");
  set_link_exit_room(__DIR__ "huangshangate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-585);
  set_link_entry_room_y(-1030);
  set_link_entry_room_z(30);

  set_entry_short(HIW "采石峰" NOR);
  set_entry_desc("采石峰，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "三叠泉" NOR);
  set_exit_desc("三叠泉，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 huangshan-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("采石峰");
  set_maze_room_desc("nitan d/huangshan 映射区。");
}
// 原 coor(40,60,110)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "天香堂偏厅");
  set("long", @LONG
偏厅布置的颇为优雅，丝毫没有正厅上的严肃气氛。一张红木大
桌边上有个书柜，柜里摆了各式各样的书。墙上挂着几幅字画。
LONG );
  set("exits", ([
    "east" : __DIR__ "4/6/11",
  ]));
  set("no_fly", 1);
  setup();
}
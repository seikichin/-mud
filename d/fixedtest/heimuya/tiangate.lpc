// tiangate —— 由 nitan/d/heimuya/tiangate.c 转换（独立房间，不在固定地图网格内）
// 原 coor(50,60,100)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "天香堂大门");
  set("long", @LONG
这是日月神教下第四大堂天香堂的大门，门前摆放着两座石狮，
镇守着朱漆大门。大门两旁站着数名轻装女子，单手持着长鞭，警惕
地注视着周围的一切。
LONG );
  set("exits", ([
    "north" : __DIR__ "tianroad2",
    "south" : __DIR__ "4/7/10",
  ]));
  set("no_fly", 1);
  setup();
}
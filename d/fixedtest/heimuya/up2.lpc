// 原 coor(110,30,70)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "悬崖");
  set("long", " ");
  set("exits", ([
    "westdown" : __DIR__ "9/3/6",
  ]));
  set("no_fly", 1);
  setup();
  set("exits/enter", __DIR__"basket");
}
// up3 —— 由 nitan/d/heimuya/up3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(120,30,80)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "悬崖");
  set("long", " ");
  set("exits", ([
    "westdown" : __DIR__ "up2",
  ]));
  set("no_fly", 1);
  setup();
  set("exits/enter", __DIR__"basket");
}
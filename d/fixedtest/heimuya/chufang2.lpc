// chufang2 —— 由 nitan/d/heimuya/chufang2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(0,50,100)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "厨房");
  set("long", " ");
  set("exits", ([
    "west" : __DIR__ "0/5/10",
  ]));
  set("no_fly", 1);
  setup();
}
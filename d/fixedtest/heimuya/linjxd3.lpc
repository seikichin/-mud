// linjxd3 —— 由 nitan/d/heimuya/linjxd3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(40,80,100)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "林间小道");
  set("long", @LONG
你走在一条阴暗的林间小道上，两旁是阴森森的树林。一阵阵风
吹过树梢，发出沙沙的响声，令你不寒而栗。
LONG );
  set("exits", ([
    "west" : __DIR__ "1/9/10",
    "north" : __DIR__ "linjxd2",
    "east" : __DIR__ "1/9/10",
    "south" : __DIR__ "2/9/10",
  ]));
  set("no_fly", 1);
  setup();
}
// shanlu2 —— 由 nitan/d/heizhao/shanlu2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-4000,-1500,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "密林矮树");
  set("long", @LONG
往前苦苦走了二里有余，但见黑森森的四下里都是树木，一入
林中，再也无法直行，林中小路东盘西曲，密林中难辨方向，忙跃
上树去眺望，无论你往那边望，都找不到出路。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "shanlu2",
    "south" : __DIR__ "shanlu2",
    "northwest" : __DIR__ "shanlu2",
    "west" : __DIR__ "shanlu2",
    "southwest" : __DIR__ "shanlu2",
    "northeast" : __DIR__ "shanlu2",
    "east" : __DIR__ "shanlu1",
    "north" : __DIR__ "shanlu2",
  ]));
  set("no_fly", 1);
  setup();
}
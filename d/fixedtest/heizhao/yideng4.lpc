// yideng4 —— 由 nitan/d/heizhao/yideng4.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-38000,-80000,100)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山腰");
  set("long", @LONG
这里是山的半腰，眼前景色如画，清溪潺潺，水流平稳之极，几
似定住不动。那溪水宽约丈许，两旁垂柳拂水，绿柳之间夹植着无数
桃树，若在春日桃花盛开之时，想见一片锦绣，繁华耀眼。这时虽无
桃花，但水边生满一丛丛白色小花，芳香馥郁，绿柳丛间时有飞鸟鸣
啭。山边一条手臂粗细的长藤，沿峰而上。仰头上望，见山峰的上半
截隐入云雾之中，不知峰顶究有多高。
LONG );
  set("exits", ([
    "down" : __DIR__ "8/20/3",
    "up" : __DIR__ "yideng5",
  ]));
  set("no_fly", 1);
  setup();
}
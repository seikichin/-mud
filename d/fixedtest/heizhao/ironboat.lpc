inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "铁舟");
  set("long", @LONG
这是一艘黑黝黝的小船，舟中放着两柄铁桨，铁舟很小至多只
能乘坐二人。
LONG );
  set("exits", ([
    "out" : __DIR__ "8/23/2",
    "south" : __DIR__ "8/22/2",
  ]));
  set("no_fly", 1);
  setup();
}
// 原 coor(-10770,1920,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "长安西城门");
  set("long", @LONG
长安城的西城门。这里的护城河既深又阔，而且城高墙厚，有一
夫当关，万夫莫开之势，城内还驻扎了两营士兵，远看军营延绵，旌
旗似海，颇具慑人之势，仰望城楼，只见城楼高处满布哨兵，剑拔驽
张，士气昂扬。
LONG );
  set("exits", ([
    "east" : __DIR__ "0/4/0",
    "west" : __DIR__ "road7",
  ]));
  set("no_fly", 1);
  setup();
}
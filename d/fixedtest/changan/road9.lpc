void create() {
  set("short", "官道");
  set("long", @LONG
一条青石铺就的官道，向北通往兰州，往东南则到达长安。道路两
旁是一片茂密的树林。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "road8",

#include <ansi.h>

void create() {
  set("short", "群玉楼密室");
  set("long", @LONG
屋子里面布置得简单而富有情趣。房间很宽敞，悬挂着几盆花花
草草，红绿相间，疏密有致，令人赏心悦目。屋子里一个十来岁的小
姑娘正哭个不停，旁边站了四个打手。
LONG );

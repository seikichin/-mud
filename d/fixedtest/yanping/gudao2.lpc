// gudao2 —— 由 nitan/d/yanping/gudao2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1200,-6300,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "闽赣古道");
  set("long", @LONG
福建境内数不尽的山坎相连。密林幽谷相继，终日不见天光。山中
毒虫猛兽出没无常，行路艰辛。
LONG );
  set("exits", ([
    "eastdown" : __DIR__ "gudao3",
    "westdown" : __DIR__ "gudao1",
  ]));
  set("no_fly", 1);
  setup();
}
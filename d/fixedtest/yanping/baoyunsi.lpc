// 原 coor(1480,-6230,40)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "宝云寺");
  set("long", @LONG
宝云寺位于九峰山上，始建于唐朝龙纪元年，原名南峰普济院，元
代改称“三寺”，遂有“三寺云深”景名。寺庙宏伟富丽，金碧辉煌，
寺旁古木参天，夕云起处，若隐若现。
LONG );
  set("exits", ([
    "northdown" : __DIR__ "9fengshan",
  ]));
  set("no_fly", 1);
  setup();
}
// yidao2 —— 由 nitan/d/yanping/yidao2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1500,-6100,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "闽浙驿道");
  set("long", @LONG
自古入闽无敞途。往来货运全靠肩挑背扛，逶迤入闽，车马不通。
古驿道沿建溪溪流南下，经此一个高坡逶迤而上，眼前林海如浪，远处
云雾笼罩，好一个风光所在。站在山顶隘口，远眺延平街市，双溪拱饶
直如棋盘一般。
LONG );
  set("exits", ([
    "southup" : __DIR__ "gubao",
    "northdown" : __DIR__ "yidao1",
  ]));
  set("no_fly", 1);
  setup();
}
// yanping —— nitan d/yanping 固定地图映射区（vrm_fixed）
//
//   yanping.map         地图（方向位掩码 + [LINK] 特殊出口）
//   yanping-room.lpc    格房描述（改文字即可改每格 look）
//   yanpinggate.lpc / yanpinggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/yanping/yanping/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = yanping）
// 格索引 -> 原 coor： coor = (格索引 + (142,-619,1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "yanping-room");
  set_maze_map(__DIR__ "yanping");
  set_maze_spacing(10);
  set_maze_owner_key("yanping");

  // 入口 = fengguanyan（格 10,3,0），出口 = road2（格 6,0,0）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "yanpinggate");
  set_link_exit_room(__DIR__ "yanpinggate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(1490);
  set_link_entry_room_y(-6150);
  set_link_entry_room_z(60);

  set_entry_short(HIW "凤冠岩" NOR);
  set_entry_desc("凤冠岩，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "卵石道" NOR);
  set_exit_desc("卵石道，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 yanping-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("凤冠岩");
  set_maze_room_desc("nitan d/yanping 映射区。");
}
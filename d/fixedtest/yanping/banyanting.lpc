// banyanting —— 由 nitan/d/yanping/banyanting.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1500,-6120,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "半岩亭");
  set("long", " ");
  set("exits", ([
    "northup" : __DIR__ "gubao",
    "southdown" : __DIR__ "3800kan",
  ]));
  set("no_fly", 1);
  setup();
}
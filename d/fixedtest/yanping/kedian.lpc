// 原 coor(1490,-4000,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山野客店");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "erbapu",
  ]));
  set("no_fly", 1);
  setup();
}
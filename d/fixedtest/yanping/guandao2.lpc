// guandao2 —— 由 nitan/d/yanping/guandao2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1700,-6300,10)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "官道");
  set("long", @LONG
你走在闽江北岸大官道上。福建境内无山不青，无水不翠，山陡林
深少行人，官道在群峰边下延伸，山林里面时常有尖利的啼叫声起，不
禁让你惴惴。
LONG );
  set("exits", ([
    "eastdown" : __DIR__ "guandao1",
    "northwest" : __DIR__ "milin",
  ]));
  set("no_fly", 1);
  setup();
}
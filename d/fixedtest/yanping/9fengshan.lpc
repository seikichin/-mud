// 9fengshan —— 由 nitan/d/yanping/9fengshan.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1480,-6220,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "九峰山");
  set("long", @LONG
九峰山隔西溪与府城相望。因九峰重叠居周遭诸峰之冠，故名。山
上环境幽静，树木苍郁。“九峰月朗”为延平八景之一。宋代的大儒李
侗、朱熹曾在这里讲学，赞美九峰景致为“九朵芙蓉”、“九叠翠屏”。
LONG );
  set("exits", ([
    "northdown" : __DIR__ "fuqiao2",
    "southup" : __DIR__ "baoyunsi",
    "east" : __DIR__ "shuyuan",
  ]));
  set("no_fly", 1);
  setup();
}
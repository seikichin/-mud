// gudao3 —— 由 nitan/d/yanping/gudao3.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1300,-6300,10)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "闽赣古道");
  set("long", @LONG
福建境内数不尽的山坎相连。密林幽谷相继，终日不见天光。山中
毒虫猛兽出没无常，行路艰辛。路边有一年轻汉子倚在树上，眯着眼打
量着你。
LONG );
  set("exits", ([
    "westup" : __DIR__ "gudao2",
    "northeast" : __DIR__ "gudao4",
  ]));
  set("no_fly", 1);
  setup();
}
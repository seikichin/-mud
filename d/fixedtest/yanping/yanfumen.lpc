// yanfumen —— 由 nitan/d/yanping/yanfumen.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1500,-3000,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "延福门");
  set("long", @LONG
延福门就是大水门了，门前龙津渡便可放舟直通省城福州。延平府
人烟稠密，廛市繁华，龙蟠虎踞，自古以来为“兵权谋家必争”。
    驻足城头延福楼，但见“孤城削壁全临水，八面无山不到楼。”周
遭山势壁立，深湍饶郭，易守难攻，其势占溪山之雄，当水陆之会，为
入闽之襟喉，省城之屏障，向有“铜延平、铁邵武”之誉，故关防严密
不轻怠。隆武天子以国姓爷食栗此方，赐封延平郡王。
LONG );
  set("exits", ([
    "north" : __DIR__ "10/1/0",
    "southeast" : __DIR__ "longjindu",
    "west" : __DIR__ "6/0/0",
  ]));
  set("no_fly", 1);
  setup();
}
// youlang —— 由 nitan/d/yanping/youlang.c 转换（独立房间，不在固定地图网格内）
// 原 coor(1450,-6150,30)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "十里游廊");
  set("long", @LONG
十里游廊穿行于溪源峡谷中。游廊风光漪丽，景色秀美。两岸石壁
对立，怪石嶙峋；峰回路转，山曲水迂；千屏万嶂，绵延起伏；树木森
郁，古藤缠绕。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "6/3/2",
    "northwest" : __DIR__ "0/6/2",
  ]));
  set("no_fly", 1);
  setup();
}
// shiliang —— nitan d/shiliang 固定地图映射区（vrm_fixed）
//
//   shiliang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   shiliang-room.lpc    格房描述（改文字即可改每格 look）
//   shilianggate.lpc / shilianggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/shiliang/shiliang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = shiliang）
// 格索引 -> 原 coor： coor = (格索引 + (159,-199,-1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "shiliang-room");
  set_maze_map(__DIR__ "shiliang");
  set_maze_spacing(10);
  set_maze_owner_key("shiliang");

  // 入口 = shufang（格 4,7,1），出口 = fang1（格 0,5,1）
  set_entry_dir("east");
  set_link_entry_room(__DIR__ "shilianggate");
  set_link_exit_room(__DIR__ "shilianggate2");
  set_entry_back_dir("east");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(1610);
  set_link_entry_room_y(-1870);
  set_link_entry_room_z(40);

  set_entry_short(HIW "书房" NOR);
  set_entry_desc("书房，从这里可以进入迷宫（east）。\n");
  set_exit_short(HIY "侧房" NOR);
  set_exit_desc("侧房，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 shiliang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("书房");
  set_maze_room_desc("nitan d/shiliang 映射区。");
}
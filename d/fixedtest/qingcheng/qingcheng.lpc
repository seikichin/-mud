// qingcheng —— nitan d/qingcheng 固定地图映射区（vrm_fixed）
//
//   qingcheng.map         地图（方向位掩码 + [LINK] 特殊出口）
//   qingcheng-room.lpc    格房描述（改文字即可改每格 look）
//   qingchenggate.lpc / qingchenggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/qingcheng/qingcheng/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = qingcheng）
// 格索引 -> 原 coor： coor = (格索引 + (-811,-95,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "qingcheng-room");
  set_maze_map(__DIR__ "qingcheng");
  set_maze_spacing(10);
  set_maze_owner_key("qingcheng");

  // 入口 = qcroad1（格 6,0,0），出口 = chufang（格 2,12,9）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "qingchenggate");
  set_link_exit_room(__DIR__ "qingchenggate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-8080);
  set_link_entry_room_y(-880);
  set_link_entry_room_z(110);

  set_entry_short(HIW "青石大道" NOR);
  set_entry_desc("青石大道，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "厨房" NOR);
  set_exit_desc("厨房，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 qingcheng-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("青石大道");
  set_maze_room_desc("nitan d/qingcheng 映射区。");
}
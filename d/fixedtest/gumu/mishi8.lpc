// mishi8 —— 由 nitan/d/gumu/mishi8.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3000,0,100)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "密室");
  set("long", @LONG
这里是古墓中的密室，四周密不透风，你只能借着墙上昏暗的灯光
来勉强分辨方向。墙是用整块的青石砌合起来的，接合的甚是完美，你
难以从中找出一丝缝隙。密室中摆放着一些简单的家居用具，原来这是
古墓派祖师林朝英的居室。
LONG );
  set("exits", ([
    "out" : "/d/fixedtest/city/7/7/0",
    "west" : __DIR__ "mishi7",
  ]));
  set("no_fly", 1);
  setup();
}
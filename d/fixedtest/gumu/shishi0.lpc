// shishi0 —— 由 nitan/d/gumu/shishi0.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3220,-40,80)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIB"石室"NOR);
  set("long", " ");
  set("exits", ([
    "out" : __DIR__ "shishi1",
  ]));
  set("no_fly", 1);
  setup();
  set("exits/up", "/d/fixedtest/gumu/2/2/12");
}
// shishi5 —— 由 nitan/d/gumu/shishi5.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3200,-40,80)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIB"石室"NOR);
  set("long", @LONG
你突然觉得眼前一亮，前方石室透过来一丝微弱的光，给了你一丝
希望。但还是只听见远远传来你脚步的回音，空荡荡的感觉使你心中只
有恐惧，甚至忘记孤独。四周如此寂然无声。只能靠摸索前行。
LONG );
  set("exits", ([
    "enter" : __DIR__ "lingshi",
    "west" : __DIR__ "shishi4",
  ]));
  set("no_fly", 1);
  setup();
}
// shishi6 —— 由 nitan/d/gumu/shishi6.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3000,-40,60)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIC"石室"NOR);
  set("long", " ");
  set("exits", ([
    "up" : __DIR__ "shiguan",
  ]));
  set("no_fly", 1);
  setup();
}
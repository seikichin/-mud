inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "后山小路");
  set("long", @LONG
走出十余里，已经到无量山峰的后山，只听得水声淙淙，前面有
条山溪。寻声来到溪旁，溪水清澈异常，远近地下撒满枯枝，脚步走
动，格格做响。
LONG );
  set("exits", ([
    "northup" : "/d/fixedtest/xiaoyao/pubu",
    "south" : __DIR__ "road5",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "刘府西厢房");
  set("long", @LONG
这儿是西厢房，这儿整理得干干净净，窗外露出点绿绿的枝叶，
家具上一尘不染，地上铺着很大块的青砖，一点灰尘也不沾。刘府的
小孩们不知在这里悄悄说着什么。
LONG );
  set("exits", ([
    "east" : __DIR__ "liufudating",
  ]));
  set("no_fly", 1);
  setup();
}
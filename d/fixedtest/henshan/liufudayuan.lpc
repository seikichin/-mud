inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "刘府大院");
  set("long", @LONG
刘府大院里现在挤着很多江湖豪客，原来今天是刘正风金盆洗手
的好日子。刘老爷子在衡阳人缘很好，来捧场的自然不少，大院里已
摆了很多张桌子，杯筷往来，很是热闹。但见他们一个个都神情异常，
今天这里像是出了什么事情。
LONG );
  set("exits", ([
    "out" : __DIR__ "9/4/1",
    "north" : __DIR__ "liufudating",
  ]));
  set("no_fly", 1);
  setup();
}
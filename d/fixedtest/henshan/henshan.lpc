// henshan —— nitan d/henshan 固定地图映射区（vrm_fixed）
//
//   henshan.map         地图（方向位掩码 + [LINK] 特殊出口）
//   henshan-room.lpc    格房描述（改文字即可改每格 look）
//   henshangate.lpc / henshangate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/henshan/henshan/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = henshan）
// 格索引 -> 原 coor： coor = (格索引 + (-699,-573,-1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "henshan-room");
  set_maze_map(__DIR__ "henshan");
  set_maze_spacing(10);
  set_maze_owner_key("henshan");

  // 入口 = wangyuetai（格 6,25,4），出口 = hsroad2（格 13,4,1）
  set_entry_dir("west");
  set_link_entry_room(__DIR__ "henshangate");
  set_link_exit_room(__DIR__ "henshangate2");
  set_entry_back_dir("west");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-6920);
  set_link_entry_room_y(-5600);
  set_link_entry_room_z(90);

  set_entry_short(HIW "望月台" NOR);
  set_entry_desc("望月台，从这里可以进入迷宫（west）。\n");
  set_exit_short(HIY "黄土路" NOR);
  set_exit_desc("黄土路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 henshan-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("望月台");
  set_maze_room_desc("nitan d/henshan 映射区。");
}
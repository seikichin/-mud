inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "刘府大厅");
  set("long", @LONG
刘府大厅里异常冷清。大厅正中放着一张茶几，上面铺了锦缎。
只见旁边一只金光灿烂、径长尺半的黄金盆子却被打翻在地上。看来
这里像是发生过打斗。
LONG );
  set("exits", ([
    "south" : __DIR__ "liufudayuan",
    "east" : __DIR__ "liufueast",
    "west" : __DIR__ "liufuwest",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "草庵");
  set("long", @LONG
寺内有著名的摩尼石像。它面庞圆阔，眉弯隆起，散发披肩，身着
宽袍僧衣，双手掌心向上置于膝上，神态庄严，别具风采。庵前约四米
处，巨石鹘立，中刻明教咒语，劝念：『清净光明，大力智慧，无上至
真，摩尼光佛』。
LONG );
  set("exits", ([
    "out" : __DIR__ "1/4/1",
  ]));
  set("no_fly", 1);
  setup();
}
// quanzhou —— nitan d/quanzhou 固定地图映射区（vrm_fixed）
//
//   quanzhou.map         地图（方向位掩码 + [LINK] 特殊出口）
//   quanzhou-room.lpc    格房描述（改文字即可改每格 look）
//   quanzhougate.lpc / quanzhougate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/quanzhou/quanzhou/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = quanzhou）
// 格索引 -> 原 coor： coor = (格索引 + (-94,-778,-1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "quanzhou-room");
  set_maze_map(__DIR__ "quanzhou");
  set_maze_spacing(10);
  set_maze_owner_key("quanzhou");

  // 入口 = shanlu3（格 4,22,0），出口 = gushaota（格 6,0,1）
  set_entry_dir("north");
  set_link_entry_room(__DIR__ "quanzhougate");
  set_link_exit_room(__DIR__ "quanzhougate2");
  set_entry_back_dir("north");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-890);
  set_link_entry_room_y(-7640);
  set_link_entry_room_z(50);

  set_entry_short(HIW "山路" NOR);
  set_entry_desc("山路，从这里可以进入迷宫（north）。\n");
  set_exit_short(HIY "姑嫂塔" NOR);
  set_exit_desc("姑嫂塔，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 quanzhou-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("山路");
  set_maze_room_desc("nitan d/quanzhou 映射区。");
}
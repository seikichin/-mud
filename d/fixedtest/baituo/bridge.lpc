inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小桥");
  set("long", @LONG
这是一座小竹桥，白驼山上的冰雪融化形成一条清澈的小溪，从
桥下缓缓流过。不时有顽皮的小鱼跃出水面，在阳光下划出一条银白
色的弧线。
LONG );
  set("exits", ([
    "east" : __DIR__ "xijie",
    "north" : __DIR__ "guangchang",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "水池");
  set("long", @LONG
一潭清澈的池水，由蛇谷山麓间的流水积蓄而成，是谷中动物的
重要水源，许多飞禽走兽都在这里饮水。
LONG );
  set("exits", ([
    "south" : __DIR__ "shegu12",
  ]));
  set("no_fly", 1);
  setup();
}
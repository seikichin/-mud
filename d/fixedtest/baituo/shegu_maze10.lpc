// shegu_maze10 —— 由 nitan/d/baituo/shegu_maze10.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-49980,20190,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "蛇谷荒地");
  set("long", @LONG
这里是蛇谷深处，草木大多枯黄凋敝，极是荒僻。四下幽暗寂静，
山谷中微风时起，带来阵阵草木腐败的气味。地上偶尔出现一些小动
物的骸骨，不知是被什麽毒蛇猛兽吃掉了。
LONG );
  set("exits", ([
    "southwest" : __DIR__ "5/17/2",
    "northeast" : __DIR__ "shegu_maze8",
    "northwest" : __DIR__ "2/21/2",
    "southeast" : __DIR__ "6/19/2",
  ]));
  set("no_fly", 1);
  setup();
}
// baituo —— nitan d/baituo 固定地图映射区（vrm_fixed）
//
//   baituo.map         地图（方向位掩码 + [LINK] 特殊出口）
//   baituo-room.lpc    格房描述（改文字即可改每格 look）
//   baituogate.lpc / baituogate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/baituo/baituo/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = baituo）
// 格索引 -> 原 coor： coor = (格索引 + (-5001,1999,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "baituo-room");
  set_maze_map(__DIR__ "baituo");
  set_maze_spacing(10);
  set_maze_owner_key("baituo");

  // 入口 = shegu_maze4（格 2,21,2），出口 = caoping（格 4,0,1）
  set_entry_dir("north");
  set_link_entry_room(__DIR__ "baituogate");
  set_link_exit_room(__DIR__ "baituogate2");
  set_entry_back_dir("north");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-49970);
  set_link_entry_room_y(20110);
  set_link_entry_room_z(60);

  set_entry_short(HIW "蛇谷荒地" NOR);
  set_entry_desc("蛇谷荒地，从这里可以进入迷宫（north）。\n");
  set_exit_short(HIY "草坪" NOR);
  set_exit_desc("草坪，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 baituo-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("蛇谷荒地");
  set_maze_room_desc("nitan d/baituo 映射区。");
}
// shegu23 —— 由 nitan/d/baituo/shegu23.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-50030,20200,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "蛇谷树林");
  set("long", " ");
  set("exits", ([
    "southwest" : __DIR__ "shegu30",
    "northeast" : __DIR__ "shegu24",
    "southeast" : __DIR__ "shegu22",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "蛇谷树林");
  set("long", @LONG
这是白驼山的蛇谷之中，林木葱郁，草丛中不时响起沙沙之声，
似乎有什麽在草里来回窜动。
LONG );
  set("exits", ([
    "west" : __DIR__ "shegu11",
    "northeast" : __DIR__ "shegu9",
  ]));
  set("no_fly", 1);
  setup();
}
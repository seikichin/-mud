inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "蛇谷树林");
  set("long", @LONG
这是白驼山的蛇谷之中，林木葱郁，草丛中不时响起沙沙之声，
似乎有什麽在草里来回窜动。北面传来一阵淡淡的凉意。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "shegu11",
    "north" : __DIR__ "shegu_pool",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "戈壁");
  set("long", @LONG
这里是临近沙漠的戈壁滩，荒无人烟。东边是一望无际的大沙漠，
西北方可以看见一座小镇。
LONG );
  set("exits", ([
    "east" : "/d/fixedtest/xingxiu/xingxiugate",
    "northwest" : __DIR__ "dongjie",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山壁");
  set("long", @LONG
这是白驼山的蛇谷之中，附近紧邻山壁，到处都是石砾。石壁上
稀稀疏疏地长着几棵小树，风吹过来，不时有一些小石头从壁上滑落
下来。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "shegu24",
  ]));
  set("no_fly", 1);
  setup();
}
// gaoli —— nitan d/gaoli 固定地图映射区（vrm_fixed）
//
//   gaoli.map         地图（方向位掩码 + [LINK] 特殊出口）
//   gaoli-room.lpc    格房描述（改文字即可改每格 look）
//   gaoligate.lpc / gaoligate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/gaoli/gaoli/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = gaoli）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "gaoli-room");
  set_maze_map(__DIR__ "gaoli");
  set_maze_spacing(10);
  set_maze_owner_key("gaoli");

  // 入口 = shaoqia（格 21,9,1），出口 = beifenghuotai（格 6,18,2）
  set_entry_dir("south");
  set_link_entry_room(__DIR__ "gaoligate");
  set_link_exit_room(__DIR__ "gaoligate2");
  set_entry_back_dir("south");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(110);
  set_link_entry_room_y(90);
  set_link_entry_room_z(60);

  set_entry_short(HIW "哨卡" NOR);
  set_entry_desc("哨卡，从这里可以进入迷宫（north）。\n");
  set_exit_short(HIY "北烽火台" NOR);
  set_exit_desc("北烽火台，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 gaoli-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("哨卡");
  set_maze_room_desc("nitan d/gaoli 映射区。");
}
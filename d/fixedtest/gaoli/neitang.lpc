// 原 coor(90,80,20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "内堂");
  set("long", @LONG
这里是武士行馆的内堂，梁间有一块匾，上写着一个大大的「武」
字，堂上布置肃穆，两壁悬着长剑，腰刀。地下没有桌椅，地上放着几
个蒲团。
LONG );
  set("exits", ([
    "out" : __DIR__ "9/8/1",
  ]));
  set("no_fly", 1);
  setup();
}
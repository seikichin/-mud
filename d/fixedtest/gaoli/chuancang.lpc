// 原 coor(130,0,10)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "船舱");
  set("long", @LONG
这里是战船的船舱。这里现在没有什么人。桌子上放着一杯茶，还
有些温热，看来这里的人刚出去不久。旁边还有一张图纸，似乎是关于
海战部署的图纸。
LONG );
  set("exits", ([
    "out" : __DIR__ "12/0/1",
  ]));
  set("no_fly", 1);
  setup();
}
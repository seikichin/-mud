// 原 coor(-2010,520,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "广场");
  set("long", @LONG
广场占地甚大，部置严谨。往西过去可达黄河帮的「侠义厅」。
周围则是些房舍，供帮众居住。
LONG );
  set("exits", ([
    "east" : __DIR__ "huanghegate",
    "west" : __DIR__ "xiayiting",
  ]));
  set("no_fly", 1);
  setup();
}
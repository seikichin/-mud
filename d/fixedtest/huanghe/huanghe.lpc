// huanghe —— nitan d/huanghe 固定地图映射区（vrm_fixed）
//
//   huanghe.map         地图（方向位掩码 + [LINK] 特殊出口）
//   huanghe-room.lpc    格房描述（改文字即可改每格 look）
//   huanghegate.lpc / huanghegate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/huanghe/huanghe/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = huanghe）
// 格索引 -> 原 coor： coor = (格索引 + (-101,30,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "huanghe-room");
  set_maze_map(__DIR__ "huanghe");
  set_maze_spacing(10);
  set_maze_owner_key("huanghe");

  // 入口 = tiandi4（格 82,21,0），出口 = shulin6（格 60,10,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "huanghegate");
  set_link_exit_room(__DIR__ "huanghegate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-600);
  set_link_entry_room_y(500);
  set_link_entry_room_z(20);

  set_entry_short(HIW "田地" NOR);
  set_entry_desc("田地，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "树林" NOR);
  set_exit_desc("树林，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 huanghe-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("田地");
  set_maze_room_desc("nitan d/huanghe 映射区。");
}
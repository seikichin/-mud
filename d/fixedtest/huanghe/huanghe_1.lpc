// huanghe_1 —— 由 nitan/d/huanghe/huanghe_1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-1000,800,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "黄河");
  set("long", @LONG
黄河沿蒙古高原南边向东流淌，遇太行山脉的阻拦，便转头南下，
形成晋陕的分界。东北方向好象有个渡口。
LONG );
  set("exits", ([
    "west" : __DIR__ "hetao",
    "south" : __DIR__ "1/40/0",
  ]));
  set("no_fly", 1);
  setup();
}
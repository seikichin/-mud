// huanghe8 —— 由 nitan/d/huanghe/huanghe8.c 转换（独立房间，不在固定地图网格内）
// 原 coor(800,1200,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "黄河入海口");
  set("long", @LONG
黄河流经青藏高原、黄土高原、华北平原，总长一万零九百里，
在这里汇入大海。
LONG );
  set("exits", ([
    "southwest" : __DIR__ "huanghe7",
  ]));
  set("no_fly", 1);
  setup();
}
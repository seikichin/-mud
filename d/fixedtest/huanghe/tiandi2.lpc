// tiandi2 —— 由 nitan/d/huanghe/tiandi2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-300,500,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "田地");
  set("long", @LONG
这里林木渐渐稀疏，不远处有一些村庄，炊烟袅袅升起。村庄周围
是一块块的田地，田里有一些正在耕作的农人。
LONG );
  set("exits", ([
    "southwest" : __DIR__ "61/10/0",
    "east" : __DIR__ "80/20/0",
  ]));
  set("no_fly", 1);
  setup();
}
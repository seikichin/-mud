// huangtu —— 由 nitan/d/huanghe/huangtu.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-3000,500,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "黄土高原");
  set("long", @LONG
黄河像一把厉刃将黄土高原切开。无数条小溪流夹带着泥沙汇入黄
河，形成千沟万壑。沟壑之间的一块块平地叫做台塬。黄河沿蒙古高原
南边向东流淌，遇太行山脉的阻拦，便转头南下，形成晋陕的分界。
LONG );
  set("exits", ([
    "southwest" : __DIR__ "huanghe_2",
    "northeast" : __DIR__ "hetao",
  ]));
  set("no_fly", 1);
  setup();
}
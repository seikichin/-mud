// hetao —— 由 nitan/d/huanghe/hetao.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-2000,800,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "河套");
  set("long", @LONG
常言到“黄河九害，富了一套”。河套地区灌溉系统发达，土地肥
沃，是种庄稼的好地方。
LONG );
  set("exits", ([
    "southwest" : __DIR__ "huangtu",
    "east" : __DIR__ "huanghe_1",
    "west" : "/d/fixedtest/yongdeng/qingcheng",
  ]));
  set("no_fly", 1);
  setup();
}
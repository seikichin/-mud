// shulin2 —— 由 nitan/d/huanghe/shulin2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-220,100,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "树林");
  set("long", @LONG
树林里光线暗淡，只能听见头顶上传来一些鸟儿的啼鸣。偶尔从茂
密的叶间透过的一线光伴着落叶在飞舞。朽木腐烂的气味和身后传来野
兽的啸声使人不觉犹豫了前进的脚步。
LONG );
  set("exits", ([
    "east" : __DIR__ "shulin1",
    "north" : __DIR__ "79/0/0",
  ]));
  set("no_fly", 1);
  setup();
}
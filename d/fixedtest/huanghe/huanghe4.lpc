// 原 coor(150,520,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "黄河岸边");
  set("long", @LONG
这里是黄河岸边。黄河流淌到这里，已经泥沙浑浊了。黄色的河水
在河床里翻滚着，咆哮着，卷起一个个巨大的漩涡。黄河在这里由於受
到东面泰山的阻挡，转而向北。
LONG );
  set("exits", ([
    "northeast" : __DIR__ "huanghe5",
    "west" : __DIR__ "huanghe3",
  ]));
  set("no_fly", 1);
  setup();
}
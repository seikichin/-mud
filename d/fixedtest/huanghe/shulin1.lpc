// shulin1 —— 由 nitan/d/huanghe/shulin1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-210,100,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "树林");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "80/0/0",
    "east" : __DIR__ "caodi2",
    "west" : __DIR__ "shulin2",
  ]));
  set("no_fly", 1);
  setup();
}
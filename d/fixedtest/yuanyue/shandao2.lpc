// shandao2 —— 由 nitan/d/yuanyue/shandao2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-590,180,60)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山道");
  set("long", @LONG
你走在去圆月山庄的山道上，一抬头，又可看见几个或是蜈蚣状，
或是老鹰状的风筝高高飞舞在蓝天白云中。山风徐徐，白云悠悠，不
觉感觉悠闲自得。往北面探头望去，已可隐约看见圆月山庄的铜漆大
门。
LONG );
  set("exits", ([
    "south" : __DIR__ "shandao1",
    "north" : __DIR__ "damen",
  ]));
  set("no_fly", 1);
  setup();
}
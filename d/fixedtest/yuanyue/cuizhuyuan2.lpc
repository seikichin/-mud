// 原 coor(-610,210,80)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "翠竹园");
  set("long", @LONG
『有竹无肉轩』四周就是翠竹园，这里种满了竹，每到风清月白
的夏夜，圆月山庄的历代主人们便会来此，一把竹椅，一壶清茶，听
那海浪般的竹涛声，可惜柳若松很久已经没这个兴致了，倒是会时常
和他的兄弟们砍竹卖钱换酒，年复一年，翠竹园中的竹子也越来越少。
LONG );
  set("exits", ([
    "north" : __DIR__ "1/0/0",
  ]));
  set("no_fly", 1);
  setup();
}
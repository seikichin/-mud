// gu2 —— 由 nitan/d/yuanyue/gu2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(110,10,10)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "桥上");
  set("long", @LONG
小桥上，朱栏低垂，垂柳下，少女轻笑。小溪缓缓流过，几尾金
色鲤鱼越水而出。
LONG );
  set("exits", ([
    "east" : __DIR__ "gu1",
    "westdown" : __DIR__ "gu3",
  ]));
  set("no_fly", 1);
  setup();
}
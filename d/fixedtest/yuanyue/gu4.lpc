inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小径");
  set("long", " ");
  set("exits", ([
    "westdown" : __DIR__ "gu5",
    "eastup" : __DIR__ "gu3",
  ]));
  set("no_fly", 1);
  setup();
}
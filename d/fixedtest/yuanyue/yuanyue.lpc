// yuanyue —— nitan d/yuanyue 固定地图映射区（vrm_fixed）
//
//   yuanyue.map         地图（方向位掩码 + [LINK] 特殊出口）
//   yuanyue-room.lpc    格房描述（改文字即可改每格 look）
//   yuanyuegate.lpc / yuanyuegate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/yuanyue/yuanyue/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = yuanyue）
// 格索引 -> 原 coor： coor = (格索引 + (-62,22,8)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "yuanyue-room");
  set_maze_map(__DIR__ "yuanyue");
  set_maze_spacing(10);
  set_maze_owner_key("yuanyue");

  // 入口 = shandong1（格 1,8,0），出口 = liyuan（格 5,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "yuanyuegate");
  set_link_exit_room(__DIR__ "yuanyuegate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-590);
  set_link_entry_room_y(260);
  set_link_entry_room_z(100);

  set_entry_short(HIW "金冠巨蟒洞" NOR);
  set_entry_desc("金冠巨蟒洞，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "梨园" NOR);
  set_exit_desc("梨园，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 yuanyue-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("金冠巨蟒洞");
  set_maze_room_desc("nitan d/yuanyue 映射区。");
}
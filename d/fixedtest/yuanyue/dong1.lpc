// 原 coor(140,0,10)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山隙中");
  set("long", @LONG
这里阴森黝暗，伸手不见五指，又极潮湿，仅容一人通过。向前
方望去，却不知有多深远。
LONG );
  set("exits", ([
    "west" : __DIR__ "gu",
    "eastup" : __DIR__ "dong0",
  ]));
  set("no_fly", 1);
  setup();
}
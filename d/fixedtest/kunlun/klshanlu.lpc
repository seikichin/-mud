// klshanlu —— 由 nitan/d/kunlun/klshanlu.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-120000,30000,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "昆仑山麓");
  set("long", " ");
  set("exits", ([
    "southwest" : __DIR__ "kunlun1",
    "east" : __DIR__ "shankou",
    "northup" : __DIR__ "shanmen",
  ]));
  set("no_fly", 1);
  setup();
}
// shanlu1 —— 由 nitan/d/kunlun/shanlu1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-80000,5000,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "西域山路");
  set("long", " ");
  set("exits", ([
    "westup" : __DIR__ "shanlu2",
    "east" : __DIR__ "shanlu",
  ]));
  set("no_fly", 1);
  setup();
}
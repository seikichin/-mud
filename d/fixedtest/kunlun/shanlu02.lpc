// 原 coor(-119990,40010,70)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "盘山路");
  set("long", " ");
  set("exits", ([
    "northup" : __DIR__ "shanlu03",
    "southdown" : __DIR__ "shanlu01",
  ]));
  set("no_fly", 1);
  setup();
}
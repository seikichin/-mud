// 原 coor(-110000,30000,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "昆仑山垭口");
  set("long", " ");
  set("exits", ([
    "enter" : "/d/fixedtest/llszhuang/4/0/0",
    "southeast" : __DIR__ "kekexili",
    "west" : __DIR__ "klshanlu",
  ]));
  set("no_fly", 1);
  setup();
}
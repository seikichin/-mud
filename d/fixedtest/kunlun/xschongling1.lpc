// 原 coor(-90050,20010,60)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "雪山丛林");
  set("long", @LONG
这是一个很大的丛林，树木枝叶上挂满了冰雪，雪白的一大片，奇
美无比。丛林向山上延伸，直至山顶。在丛林中微露出一条小道，依稀
可认，你走在小道上，雪地中留下一行长长的足印。
LONG );
  set("exits", ([
    "westup" : __DIR__ "xuanya",
    "southdown" : __DIR__ "xschongling",
  ]));
  set("no_fly", 1);
  setup();
}
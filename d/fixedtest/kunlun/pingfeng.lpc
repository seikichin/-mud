// 原 coor(-119990,40050,90)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "石屏风");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "3/0/0",
    "south" : __DIR__ "guangchang",
  ]));
  set("no_fly", 1);
  setup();
}
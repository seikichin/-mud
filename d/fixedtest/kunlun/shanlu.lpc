// shanlu —— 由 nitan/d/kunlun/shanlu.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-70000,5000,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "西域山路");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "zhenyuanqiao",
    "west" : __DIR__ "shanlu1",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "广场西");
  set("long", " ");
  set("exits", ([
    "southeast" : __DIR__ "shanlu04",
    "east" : __DIR__ "guangchang",
  ]));
  set("no_fly", 1);
  setup();
}
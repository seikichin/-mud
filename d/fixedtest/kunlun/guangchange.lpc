inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "广场东");
  set("long", " ");
  set("exits", ([
    "southwest" : __DIR__ "shanlu04",
    "west" : __DIR__ "guangchang",
  ]));
  set("no_fly", 1);
  setup();
}
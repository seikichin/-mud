// 原 coor(-98000,20050,40)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山沟");
  set("long", @LONG
山壁之下的一条小山沟，往西是一片稍矮的山壁，其余三面山壁直
接云天。这里绿草丛生，有许多雪中之鸡出没其中。
LONG );
  set("exits", ([
    "westup" : __DIR__ "shanbi",
  ]));
  set("no_fly", 1);
  setup();
}
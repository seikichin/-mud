// 原 coor(-120000,35000,50)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "昆仑派山门");
  set("long", " ");
  set("exits", ([
    "southdown" : __DIR__ "klshanlu",
    "eastup" : __DIR__ "shanlu01",
  ]));
  set("no_fly", 1);
  setup();
}
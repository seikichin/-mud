// kekexili —— 由 nitan/d/kunlun/kekexili.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-100000,20000,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "可可西里山");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "bayankala",
    "northwest" : __DIR__ "shankou",
    "north" : __DIR__ "xuedi",
  ]));
  set("no_fly", 1);
  setup();
}
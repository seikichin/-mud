// bayankala —— 由 nitan/d/kunlun/bayankala.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-90000,10000,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "巴颜喀拉山");
  set("long", " ");
  set("exits", ([
    "southdown" : __DIR__ "shanlu2",
    "northwest" : __DIR__ "hmszroad1",
    "west" : __DIR__ "kekexili",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大广场");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "pingfeng",
    "west" : __DIR__ "guangchangw",
    "east" : __DIR__ "guangchange",
    "south" : __DIR__ "shanlu04",
  ]));
  set("no_fly", 1);
  setup();
}
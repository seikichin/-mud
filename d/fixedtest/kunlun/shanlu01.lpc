// 原 coor(-119990,40000,60)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "昆仑山路");
  set("long", " ");
  set("exits", ([
    "northup" : __DIR__ "shanlu02",
    "westdown" : __DIR__ "shanmen",
  ]));
  set("no_fly", 1);
  setup();
}
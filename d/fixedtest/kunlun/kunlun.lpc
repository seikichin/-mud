// kunlun —— nitan d/kunlun 固定地图映射区（vrm_fixed）
//
//   kunlun.map         地图（方向位掩码 + [LINK] 特殊出口）
//   kunlun-room.lpc    格房描述（改文字即可改每格 look）
//   kunlungate.lpc / kunlungate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/kunlun/kunlun/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = kunlun）
// 格索引 -> 原 coor： coor = (格索引 + (-12002,4006,9)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "kunlun-room");
  set_maze_map(__DIR__ "kunlun");
  set_maze_spacing(10);
  set_maze_owner_key("kunlun");

  // 入口 = shanlin6（格 3,8,0），出口 = conglinggu（格 3,7,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "kunlungate");
  set_link_exit_room(__DIR__ "kunlungate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-119990);
  set_link_entry_room_y(40120);
  set_link_entry_room_z(130);

  set_entry_short(HIW "云杉林" NOR);
  set_entry_desc("云杉林，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "葱岭谷" NOR);
  set_exit_desc("葱岭谷，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 kunlun-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("云杉林");
  set_maze_room_desc("nitan d/kunlun 映射区。");
}
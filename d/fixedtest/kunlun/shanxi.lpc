// shanxi —— 由 nitan/d/kunlun/shanxi.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-90040,10010,40)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山溪边");
  set("long", @LONG
这里是一条小溪。昆仑山终年积雪，在烈日照射下，部分冰雪融化
成水，而汇成小溪，溪水向下而流，不知其流向何方。往西而上是一个
大丛林。
LONG );
  set("exits", ([
    "westup" : __DIR__ "xschongling",
    "eastup" : __DIR__ "hmszhuang",
  ]));
  set("no_fly", 1);
  setup();
}
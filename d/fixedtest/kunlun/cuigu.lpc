// cuigu —— 由 nitan/d/kunlun/cuigu.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-100000,20050,40)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIG"翠谷"NOR);
  set("long", " ");
  set("exits", ([
    "eastup" : __DIR__ "shanbi",
    "south" : __DIR__ "xianjing",
    "west" : __DIR__ "pubu",
  ]));
  set("no_fly", 1);
  setup();
}
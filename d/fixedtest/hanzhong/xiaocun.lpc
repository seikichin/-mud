// 原 coor(-12260,830,10)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小村庄");
  set("long", @LONG
这是一片小村庄，隐藏在一个小山坳里。这里的居民们都很少到
城里去，虽然离武功镇不过是五、六里的山路，他们宁愿秉承着男耕
女纺织、日出而作日落而歇的老传统。日子虽然清贫，却还算逍遥。
LONG );
  set("exits", ([
    "northwest" : __DIR__ "guchang",
    "southdown" : __DIR__ "shanlu",
  ]));
  set("no_fly", 1);
  setup();
}
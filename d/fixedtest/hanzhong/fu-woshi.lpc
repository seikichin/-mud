// 原 coor(-12240,760,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "卧室");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "fu-houyuan",
  ]));
  set("no_fly", 1);
  setup();
  set("exits/down", __DIR__"fu-midao");
}
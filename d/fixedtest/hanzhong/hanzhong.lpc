// hanzhong —— nitan d/hanzhong 固定地图映射区（vrm_fixed）
//
//   hanzhong.map         地图（方向位掩码 + [LINK] 特殊出口）
//   hanzhong-room.lpc    格房描述（改文字即可改每格 look）
//   hanzhonggate.lpc / hanzhonggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/hanzhong/hanzhong/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = hanzhong）
// 格索引 -> 原 coor： coor = (格索引 + (-1225,78,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "hanzhong-room");
  set_maze_map(__DIR__ "hanzhong");
  set_maze_spacing(10);
  set_maze_owner_key("hanzhong");

  // 入口 = guandao1（格 4,3,0），出口 = fu-zhangfang（格 0,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "hanzhonggate");
  set_link_exit_room(__DIR__ "hanzhonggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-12230);
  set_link_entry_room_y(810);
  set_link_entry_room_z(30);

  set_entry_short(HIW "官道" NOR);
  set_entry_desc("官道，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "帐房" NOR);
  set_exit_desc("帐房，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 hanzhong-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("官道");
  set_maze_room_desc("nitan d/hanzhong 映射区。");
}
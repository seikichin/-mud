inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "密室");
  set("long", @LONG
这里是一间密室，四周散布着几条带血的鞭子，还有一些各
种各样的刑具。看来传说果然不虚，这侯员外果真是个鱼肉乡里
的恶霸。
LONG );
  set("exits", ([
    "northwest" : __DIR__ "fu-midao",
    "up" : __DIR__ "fu-woshi",
  ]));
  set("no_fly", 1);
  setup();
}
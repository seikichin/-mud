// 固定地下城测试：引擎（inherit vrm_fixed）
// 地图文件同目录 fixed1.map；入口 /d/fixedtest/gate（down）→ /d/fixedtest/fixed1/pub/entry

inherit "/std/room/vrm_fixed";
#include <ansi.h>;

void create() {
  set_inherit_room("/std/room/vrm_fixed_room");
  set_maze_map(__DIR__ "fixed1");
  set_maze_spacing(1);
  set_maze_owner_key("pub");   // 全服共用一处：房间名固定为 .../pub/...

  // 入口在迷宫北侧；外面从 down 进来，回程走 up
  set_entry_dir("north");
  set_link_entry_dir("down");
  set_entry_back_dir("up");
  set_link_entry_room("/d/fixedtest/gate");

  set_link_exit_room("/d/fixedtest/gate");
  set_exit_back_dir("up");

  set_link_entry_room_x(0);
  set_link_entry_room_y(0);
  set_link_entry_room_z(0);

  set_entry_short(HIW "地宫入口" NOR);
  set_entry_desc(@LONG
    一道半开的石门，门楣上刻着模糊的古字，黑雾从门缝里渗出来。
LONG
  );

  set_exit_short(HIY "地宫深处" NOR);
  set_exit_desc(@LONG
    石室尽头立着一座残破的石台，台上空无一物。
LONG
  );

  set_maze_room_short(HIB "石室" NOR);
  set_maze_room_desc(@LONG
    四面都是青石砌成的墙，墙角生着暗绿的苔藓。
LONG
  );
}

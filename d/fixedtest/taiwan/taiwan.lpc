// taiwan —— nitan d/taiwan 固定地图映射区（vrm_fixed）
//
//   taiwan.map         地图（方向位掩码 + [LINK] 特殊出口）
//   taiwan-room.lpc    格房描述（改文字即可改每格 look）
//   taiwangate.lpc / taiwangate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/taiwan/taiwan/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = taiwan）
// 格索引 -> 原 coor： coor = (格索引 + (249,-707,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "taiwan-room");
  set_maze_map(__DIR__ "taiwan");
  set_maze_spacing(10);
  set_maze_owner_key("taiwan");

  // 入口 = jilonggang（格 6,10,0），出口 = dagougang（格 2,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "taiwangate");
  set_link_exit_room(__DIR__ "taiwangate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(2520);
  set_link_entry_room_y(-7010);
  set_link_entry_room_z(30);

  set_entry_short(HIW "鸡笼港" NOR);
  set_entry_desc("鸡笼港，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "打狗港" NOR);
  set_exit_desc("打狗港，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 taiwan-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("鸡笼港");
  set_maze_room_desc("nitan d/taiwan 映射区。");
}
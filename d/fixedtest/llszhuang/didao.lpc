// didao —— 由 nitan/d/llszhuang/didao.c 转换（独立房间，不在固定地图网格内）
// 原 coor(110,10,10)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "地道");
  set("long", "黑漆漆的地道，你不知道要爬多久才能出去。\n");
  set("exits", ([
    "up" : __DIR__ "didao1",
  ]));
  set("no_fly", 1);
  setup();
}
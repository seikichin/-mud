// llszhuang —— nitan d/llszhuang 固定地图映射区（vrm_fixed）
//
//   llszhuang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   llszhuang-room.lpc    格房描述（改文字即可改每格 look）
//   llszhuanggate.lpc / llszhuanggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/llszhuang/llszhuang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = llszhuang）
// 格索引 -> 原 coor： coor = (格索引 + (0,1,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "llszhuang-room");
  set_maze_map(__DIR__ "llszhuang");
  set_maze_spacing(10);
  set_maze_owner_key("llszhuang");

  // 入口 = lou0（格 15,0,1），出口 = shishi（格 14,0,1）
  set_entry_dir("north");
  set_link_entry_room(__DIR__ "llszhuanggate");
  set_link_exit_room(__DIR__ "llszhuanggate2");
  set_entry_back_dir("north");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(90);
  set_link_entry_room_y(50);
  set_link_entry_room_z(100);

  set_entry_short(HIW "接 天 楼" NOR);
  set_entry_desc("接 天 楼，从这里可以进入迷宫（north）。\n");
  set_exit_short(HIY "石室" NOR);
  set_exit_desc("石室，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 llszhuang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("接 天 楼");
  set_maze_room_desc("nitan d/llszhuang 映射区。");
}
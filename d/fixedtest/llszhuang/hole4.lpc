inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "洞穴");
  set("long", "山岩下秘洞，曲折深邃，有如诸葛武侯之八卦迷阵一般，幽谜繁复处\n"
"尤有过之。越是深入越是阴湿黝暗，到后来竟已难见五指。但这里远处似\n"
"乎透过一点灯光。\n");
  set("no_fly", 1);
  setup();
}

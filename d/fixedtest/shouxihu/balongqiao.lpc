inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "八龙桥");
  set("long", @LONG
吹台和小金山之间是一段柳岸长堤，长堤中段架有两侧雕塑八龙头
花岗岩桥，这就是八龙桥。
LONG );
  set("exits", ([
    "southup" : __DIR__ "changchunling",
    "north" : __DIR__ "chuitai",
  ]));
  set("no_fly", 1);
  setup();
}
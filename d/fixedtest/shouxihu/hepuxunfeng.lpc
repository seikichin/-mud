// hepuxunfeng —— 由 nitan/d/shouxihu/hepuxunfeng.c 转换（独立房间，不在固定地图网格内）
// 原 coor(2,39,0)  coor 不是 10 的倍数
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "荷浦熏风");
  set("long", @LONG
荷浦熏风位于长堤春柳东岸。为清乾隆布政使衔江春所筑家园，故
称“江园”。乾隆高宗南巡时赐名净香园。园内有清华堂、青雨廊、杏
花春雨之堂，又有怡性堂、翠玲珑馆及涵虚阁。涵虚阁外，构小亭置四
屏风，嵌“荷浦熏风”四字。此处前湖后浦，分种红、白荷花。夏日临
湖小憩，熏风拂面，令人呼吸清凉，热念顿消。
    江园内飞甍反宇，五色填漆，一片金碧，照耀湖山，每当夕阳西下，
殿角铃声与画船箫鼓辄相应答。
LONG );
  set("exits", ([
    "north" : __DIR__ "siqiaoyanyu",
  ]));
  set("no_fly", 1);
  setup();
}
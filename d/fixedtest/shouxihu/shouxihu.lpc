// shouxihu —— nitan d/shouxihu 固定地图映射区（vrm_fixed）
//
//   shouxihu.map         地图（方向位掩码 + [LINK] 特殊出口）
//   shouxihu-room.lpc    格房描述（改文字即可改每格 look）
//   shouxihugate.lpc / shouxihugate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/shouxihu/shouxihu/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = shouxihu）
// 格索引 -> 原 coor： coor = (格索引 + (-6,5,-1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "shouxihu-room");
  set_maze_map(__DIR__ "shouxihu");
  set_maze_spacing(10);
  set_maze_owner_key("shouxihu");

  // 入口 = pingtai3（格 5,5,0），出口 = ouyangci（格 2,13,3）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "shouxihugate");
  set_link_exit_room(__DIR__ "shouxihugate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-10);
  set_link_entry_room_y(120);
  set_link_entry_room_z(40);

  set_entry_short(HIW "乱石平台" NOR);
  set_entry_desc("乱石平台，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "欧阳祠" NOR);
  set_exit_desc("欧阳祠，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 shouxihu-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("乱石平台");
  set_maze_room_desc("nitan d/shouxihu 映射区。");
}
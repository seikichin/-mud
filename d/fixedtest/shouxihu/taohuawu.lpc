inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "桃花坞");
  set("long", " ");
  set("exits", ([
    "northwest" : __DIR__ "5/0/1",
    "southdown" : __DIR__ "pingtai",
    "south" : __DIR__ "changdi2",
    "west" : __DIR__ "yinxie",
    "east" : __DIR__ "chunboqiao",
    "north" : __DIR__ "xiaohongqiao",
  ]));
  set("no_fly", 1);
  setup();
}
// pk —— nitan d/pk 固定地图映射区（vrm_fixed）
//
//   pk.map         地图（方向位掩码 + [LINK] 特殊出口）
//   pk-room.lpc    格房描述（改文字即可改每格 look）
//   pkgate.lpc / pkgate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/pk/pk/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = pk）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "pk-room");
  set_maze_map(__DIR__ "pk");
  set_maze_spacing(10);
  set_maze_owner_key("pk");

  // 入口 = turen6（格 3,2,0），出口 = turen11（格 1,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "pkgate");
  set_link_exit_room(__DIR__ "pkgate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(30);
  set_link_entry_room_y(20);
  set_link_entry_room_z(20);

  set_entry_short(HIW "毒人场" NOR);
  set_entry_desc("毒人场，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "诛人场" NOR);
  set_exit_desc("诛人场，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 pk-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("毒人场");
  set_maze_room_desc("nitan d/pk 映射区。");
}
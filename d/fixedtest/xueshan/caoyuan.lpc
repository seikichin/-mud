inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "草原");
  set("long", @LONG
这里是雪山脚下的一片草原。北面是起伏的群山，山顶上积着终年
不化的雪。西边有一条土路。
LONG );
  set("exits", ([
    "northeast" : "/d/fixedtest/xingxiu/0/3/0",
    "west" : __DIR__ "tulu1",
  ]));
  set("no_fly", 1);
  setup();
}
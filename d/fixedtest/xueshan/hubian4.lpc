inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "湖边小路");
  set("long", @LONG
这是圣湖边的小路。路侧长草没足, 青绿可喜。
LONG );
  set("exits", ([
    "south" : __DIR__ "hubian3",
    "north" : __DIR__ "shanjiao",
  ]));
  set("no_fly", 1);
  setup();
}
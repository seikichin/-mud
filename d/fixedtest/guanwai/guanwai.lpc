// guanwai —— nitan d/guanwai 固定地图映射区（vrm_fixed）
//
//   guanwai.map         地图（方向位掩码 + [LINK] 特殊出口）
//   guanwai-room.lpc    格房描述（改文字即可改每格 look）
//   guanwaigate.lpc / guanwaigate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/guanwai/guanwai/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = guanwai）
// 格索引 -> 原 coor： coor = (格索引 + (394,911,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "guanwai-room");
  set_maze_map(__DIR__ "guanwai");
  set_maze_spacing(10);
  set_maze_owner_key("guanwai");

  // 入口 = xuedi1（格 7,13,0），出口 = laolongtou（格 1,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "guanwaigate");
  set_link_exit_room(__DIR__ "guanwaigate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(3990);
  set_link_entry_room_y(9190);
  set_link_entry_room_z(30);

  set_entry_short(HIW "雪地" NOR);
  set_entry_desc("雪地，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "老龙头" NOR);
  set_exit_desc("老龙头，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 guanwai-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("雪地");
  set_maze_room_desc("nitan d/guanwai 映射区。");
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "静修室");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "houyuan",
  ]));
  set("no_fly", 1);
  setup();
  set("exits/south", __DIR__"xiuxishi");
  set("exits/north", __DIR__"xiuxishi");
}
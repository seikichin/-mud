inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "鹿鸣峰");
  set("long", @LONG
龙门峰西侧是鹿鸣峰。鹿鸣峰又称芝盘峰，因峰上有一草
甸子，形圆如盖，有热气从地下冒出，每到严冬，其它峰均积
雪甚厚，唯鹿鸣峰依然植物茂盛，且盛产芝草，鹿多居之。常
有鹤、雀、雕、燕飞落其上，有鹿鸣翠谷，雕飞芝盖之称。
LONG );
  set("exits", ([
    "northdown" : __DIR__ "famu",
    "east" : __DIR__ "longmen",
    "south" : __DIR__ "baiyun",
  ]));
  set("no_fly", 1);
  setup();
}
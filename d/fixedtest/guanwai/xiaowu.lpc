inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小茅屋");
  set("long", @LONG
这是一座用长白山松木垒成的小屋，屋内打扫的很干净。剥离的
墙壁上挂满了兽皮和雪橇，一张小小的桌旁坐着一个虬髯大汉。北面
看来一扇小门，后面似乎别有洞天。
LONG );
  set("exits", ([
    "north" : __DIR__ "houyuan",
    "south" : __DIR__ "xiaoyuan",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "练功房");
  set("long", @LONG
这里是练功房，屋中立着一些练武者常用的木人。东面似乎还有
一间房子。
LONG );
  set("exits", ([
    "south" : __DIR__ "liangongs",
    "east" : __DIR__ "liangonge",
    "west" : __DIR__ "houyuan",
  ]));
  set("no_fly", 1);
  setup();
}
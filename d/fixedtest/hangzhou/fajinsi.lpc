// fajinsi —— 由 nitan/d/hangzhou/fajinsi.c 转换（独立房间，不在固定地图网格内）
// 原 coor(750,-2090,40)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "法净寺");
  set("long", @LONG
法净寺依山而立，寺前小溪流水。进香的游客不时的进进出出。
南上往上天竺。朝北是下山的路。
LONG );
  set("exits", ([
    "southup" : __DIR__ "shanlu3",
    "northdown" : __DIR__ "shanlu2",
  ]));
  set("no_fly", 1);
  setup();
}
// shanlu2 —— 由 nitan/d/hangzhou/shanlu2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(750,-2080,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG
走在这条不是很宽的山路上，只见两旁峰峦秀丽，景色怡人。一
条小溪在路边潺潺流过，溪畔有一农家。山村小景，使人有退隐江湖
之意。南上便到了中天竺。北下就是下天竺。
LONG );
  set("exits", ([
    "southup" : __DIR__ "fajinsi",
    "northdown" : __DIR__ "fajingsi",
  ]));
  set("no_fly", 1);
  setup();
}
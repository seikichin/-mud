// tulu1 —— 由 nitan/d/hangzhou/tulu1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(750,-2070,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "土路");
  set("long", " ");
  set("exits", ([
    "southwest" : __DIR__ "1/0/4",
    "northeast" : __DIR__ "0/5/0",
  ]));
  set("no_fly", 1);
  setup();
}
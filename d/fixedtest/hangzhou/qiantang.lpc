// 原 coor(770,-2120,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "钱塘江畔");
  set("long", @LONG
钱塘江，每年八月十八是观潮的好日子。“八月十八潮，壮观天
下无”。潮水来时“远若素练横江，声如金鼓；近则亘如山岳，奋如
雷霆”，刹那间，漫江沸腾，泼涛万顷，潮高丈馀，万马奔腾，真有
“涛来势转雄，猎猎驾长风。雷震云霓里，山飞霜雪中”的壮丽气势。
西上月轮山便到了六和塔。
LONG );
  set("exits", ([
    "eastdown" : "/d/fixedtest/binghuo/qiantang",
    "westup" : __DIR__ "liuheta",
    "north" : __DIR__ "1/0/0",
  ]));
  set("no_fly", 1);
  setup();
}
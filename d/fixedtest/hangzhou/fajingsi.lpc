// 原 coor(750,-2070,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "法镜寺");
  set("long", @LONG
法镜寺建在小溪旁，格外的幽雅。进香的游客不时的进进出出。
南上往中天竺。朝北是下山的路。
LONG );
  set("exits", ([
    "southup" : __DIR__ "shanlu2",
    "northdown" : __DIR__ "shanlu1",
  ]));
  set("no_fly", 1);
  setup();
}
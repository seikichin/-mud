// faxisi —— 由 nitan/d/hangzhou/faxisi.c 转换（独立房间，不在固定地图网格内）
// 原 coor(750,-2110,60)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "法喜寺");
  set("long", @LONG
法喜寺是天竺三寺中最敞朗深幽的一座。进香的游客不时的进进
出出。往东可达龙井，朝北是下山的路。
LONG );
  set("exits", ([
    "eastdown" : __DIR__ "0/0/5",
    "northdown" : __DIR__ "shanlu3",
  ]));
  set("no_fly", 1);
  setup();
}
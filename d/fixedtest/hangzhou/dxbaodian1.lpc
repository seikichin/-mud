inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大雄宝殿");
  set("long", @LONG
天王殿後是另一座高达三十几米的大殿。匾上写着“大雄宝殿”。
殿前有两座八角九层石塔。往南又进了天王殿。
LONG );
  set("exits", ([
    "enter" : __DIR__ "dxbaodian2",
    "south" : __DIR__ "tianwangdian",
  ]));
  set("no_fly", 1);
  setup();
}
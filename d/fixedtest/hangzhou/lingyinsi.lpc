inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "灵隐寺");
  set("long", @LONG
灵隐寺又名云林寺，寺前有清澈的小溪，溪旁建有冷泉亭和赫雷
亭。天王殿举目可见，殿外有两座经幢。往南便回到大道。
LONG );
  set("exits", ([
    "enter" : __DIR__ "tianwangdian",
    "west" : __DIR__ "lengquanting",
    "south" : __DIR__ "road1",
  ]));
  set("no_fly", 1);
  setup();
}
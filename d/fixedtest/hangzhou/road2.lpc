// road2 —— 由 nitan/d/hangzhou/road2.c 转换（独立房间，不在固定地图网格内）
// 原 coor(750,-2050,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "青石大道");
  set("long", @LONG
大道上游人，或步行，或乘轿，或骑马。个个喜气洋洋的来游西
边是灵隐寺和飞来峰。往南是上天竺。
LONG );
  set("exits", ([
    "southwest" : __DIR__ "road1",
    "northeast" : __DIR__ "0/7/0",
    "southup" : __DIR__ "shanlu1",
  ]));
  set("no_fly", 1);
  setup();
}
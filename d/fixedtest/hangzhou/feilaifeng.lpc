// feilaifeng —— 由 nitan/d/hangzhou/feilaifeng.c 转换（独立房间，不在固定地图网格内）
// 原 coor(740,-2070,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "飞来峰");
  set("long", @LONG
飞来峰又名灵鹫峰。沿着盘山小道往上走，只见溪盘岩石壁间雕
着一尊袒腹露胸，喜笑自若的弥勒佛。旁边是一座气魄雄伟的多闻天
王。北边是下山的路。小路往上延伸向东西两边。
LONG );
  set("exits", ([
    "eastup" : __DIR__ "qinglindong",
    "westup" : __DIR__ "longhongdong",
    "north" : __DIR__ "road1",
  ]));
  set("no_fly", 1);
  setup();
}
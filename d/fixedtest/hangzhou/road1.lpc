    "south" : __DIR__ "feilaifeng",
    "northeast" : __DIR__ "road2",
    "northwest" : "/d/fixedtest/jiaxing/1/8/0",
    "north" : __DIR__ "lingyinsi",
  ]));
  set("no_fly", 1);
  setup();
}
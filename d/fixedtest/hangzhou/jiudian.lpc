// jiudian —— 由 nitan/d/hangzhou/jiudian.c 转换（独立房间，不在固定地图网格内）
// 原 coor(3890,-1800,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "酒店");
  set("long", " ");
  set("exits", ([
    "west" : __DIR__ "village",
  ]));
  set("no_fly", 1);
  setup();
}
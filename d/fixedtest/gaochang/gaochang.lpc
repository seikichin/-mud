// gaochang —— nitan d/gaochang 固定地图映射区（vrm_fixed）
//
//   gaochang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   gaochang-room.lpc    格房描述（改文字即可改每格 look）
//   gaochanggate.lpc / gaochanggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/gaochang/gaochang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = gaochang）
// 格索引 -> 原 coor： coor = (格索引 + (-3651,1000,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "gaochang-room");
  set_maze_map(__DIR__ "gaochang");
  set_maze_spacing(10);
  set_maze_owner_key("gaochang");

  // 入口 = eroom3（格 2,7,3），出口 = wroom1（格 0,5,3）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "gaochanggate");
  set_link_exit_room(__DIR__ "gaochanggate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-36500);
  set_link_entry_room_y(10060);
  set_link_entry_room_z(50);

  set_entry_short(HIW "东大殿" NOR);
  set_entry_desc("东大殿，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "西大殿" NOR);
  set_exit_desc("西大殿，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 gaochang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("东大殿");
  set_maze_room_desc("nitan d/gaochang 映射区。");
}
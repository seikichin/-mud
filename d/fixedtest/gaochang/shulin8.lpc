// 原文件无 coor
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "高昌迷宫");
  set("long", @LONG
这是条黑沈沈的长甬道，甬道前出现了三条岔道。迷宫之
内并无足迹指引，你不知道要往哪条路走。俯身细看，见左首
右首和前方三条路上都有淡淡的足迹。你似乎迷失了方向，象
没头苍蝇般到处乱闯。
LONG );
  set("exits", ([
    "north" : __DIR__"shulin" + (random(10) + 2),
    "south" : __DIR__"shulin" + (random(10) + 2),
    "east" : __DIR__ "shulin14",
    "west" : __DIR__ "shulin7",
  ]));
  set("no_fly", 1);
  setup();
}
// wuyi —— nitan d/wuyi 固定地图映射区（vrm_fixed）
//
//   wuyi.map         地图（方向位掩码 + [LINK] 特殊出口）
//   wuyi-room.lpc    格房描述（改文字即可改每格 look）
//   wuyigate.lpc / wuyigate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/wuyi/wuyi/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = wuyi）
// 格索引 -> 原 coor： coor = (格索引 + (132,-505,1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "wuyi-room");
  set_maze_map(__DIR__ "wuyi");
  set_maze_spacing(10);
  set_maze_owner_key("wuyi");

  // 入口 = shuiliandong（格 8,17,0），出口 = wuyigong（格 8,5,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "wuyigate");
  set_link_exit_room(__DIR__ "wuyigate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(1370);
  set_link_entry_room_y(-4960);
  set_link_entry_room_z(60);

  set_entry_short(HIW "水帘洞" NOR);
  set_entry_desc("水帘洞，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "武夷宫" NOR);
  set_exit_desc("武夷宫，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 wuyi-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("水帘洞");
  set_maze_room_desc("nitan d/wuyi 映射区。");
}
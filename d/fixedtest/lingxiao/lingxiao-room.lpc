// ============================================================
//  lingxiao-room.lpc  ——  nitan d/lingxiao 映射区（12x13x10）房间模板
//  由 nitan_build.aardio 自动生成，可自由修改文字
//
//  数据表 maze_cell_desc 的键 = 格索引 ""x,y,z""（从 0 开始，与 lingxiao.map 一致）
//  值 = ({ 短描述, 长描述 })
//  改这里的文字即可直接改变对应格子的 look 结果。
//
//  原 coor 与格索引的换算： coor = (格索引 + (0,0,0)) * 10
//  一格多间房时：短描述取主房，长描述按房间拼接（源房名见行末注释）
//
//  short/long 保留 nitan 原文的 LPC 表达式（heredoc / 颜色宏），
//  因此 ANSI 颜色（HIW / HIY / NOR 等）与原文完全一致。
// ============================================================

inherit ROOM;
#include <ansi.h>

void create() {}

// 格索引 -> ({ short, long })
mapping maze_cell_desc = ([
  "10,0,0" : ({ "山路", " " }),  // coor(100,0,0)  boot
  "9,0,1" : ({ "山路", @LONG
从这里开始，就是上凌宵城的山路了。抬头一望，雪峰高插
云霄，看不见顶，自己站立之处，仅仅是在山脚高一点，却已有
点“高处不胜寒”之感了。一路行来，虽还在山脚，却已感觉到
寒气逼人，路旁的树上，全挂满了白雪冰凌，一阵冷风吹来，已
让人缩头笼手。
LONG  }),  // coor(90,0,10)  sroad1
  "9,1,2" : ({ "山路", @LONG
这时雪更大些了，使得地上盖上了厚厚的一层。正值朝阳初
出，从山顶倒挂下来的冰川，由于太阳光的折射和发射，整个冰
层都变成浅蓝色的透明体，那些末曾凝结的雪花，在阳光底下，
泛出霞辉丽彩，奇妙得难以形容。山路也渐渐不平坦起来，走一
步跌三步，联想到古诗所说：“去时雪满天山路”，也不过如此
吧。
LONG  }),  // coor(90,10,20)  sroad2
  "9,2,3" : ({ "山路", @LONG
山行崎岖，这里已是雪山之上，朔风飞扬，黄云盖天。愈上
愈高，山势也愈来愈险，俯览群山，片片浮白，在云气弥漫之下，
恍如云海中星罗棋布的岛屿。这时已是正午时分，但寒气却愈来
愈浓。四周白茫茫的一片，惟有无边飞雪，纷纷扬扬从空中撒将
下来。
LONG  }),  // coor(90,20,30)  sroad3
  "10,2,4" : ({ "山路", @LONG

// lingxiao —— nitan d/lingxiao 固定地图映射区（vrm_fixed）
//
//   lingxiao.map         地图（方向位掩码 + [LINK] 特殊出口）
//   lingxiao-room.lpc    格房描述（改文字即可改每格 look）
//   lingxiaogate.lpc / lingxiaogate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/lingxiao/lingxiao/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = lingxiao）
// 格索引 -> 原 coor： coor = (格索引 + (0,0,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "lingxiao-room");
  set_maze_map(__DIR__ "lingxiao");
  set_maze_spacing(10);
  set_maze_owner_key("lingxiao");

  // 入口 = cheng（格 4,11,6），出口 = wallw3（格 0,0,7）
  set_entry_dir("north");
  set_link_entry_room(__DIR__ "lingxiaogate");
  set_link_exit_room(__DIR__ "lingxiaogate2");
  set_entry_back_dir("north");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(60);
  set_link_entry_room_y(60);
  set_link_entry_room_z(110);

  set_entry_short(HIW "居室" NOR);
  set_entry_desc("居室，从这里可以进入迷宫（north）。\n");
  set_exit_short(HIY "城头" NOR);
  set_exit_desc("城头，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 lingxiao-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("居室");
  set_maze_room_desc("nitan d/lingxiao 映射区。");
}
// caoyuan10 —— 由 nitan/d/hasake/caoyuan10.c 转换（独立房间，不在固定地图网格内）
// 原 coor(60,20,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大草原");
  set("long", @LONG
你走进了这遍绵绵不绝的大草原，脚下是寸厚的青草，软绵绵的还真
不好走，看来买匹马来代步到是的好主意。
LONG );
  set("exits", ([
    "north" : __DIR__ "caoyuan9",
    "west" : __DIR__ "1/0/0",
    "east" : __DIR__ "6/2/0",
    "south" : __DIR__ "7/6/0",
  ]));
  set("no_fly", 1);
  setup();
}
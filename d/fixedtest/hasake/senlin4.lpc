// senlin4 —— 由 nitan/d/hasake/senlin4.c 转换（独立房间，不在固定地图网格内）
// 原 coor(20,40,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "针叶林");
  set("long", @LONG
这是极西天山脚下的一片针叶林，林中鸟兽成群，满地铺盖着厚厚一
层松针。西北方的一座高耸的山脉便是天山了，山上终年积雪，山下却是
绿树成荫。往东南走便是大草原，有辛勤的哈萨克族人在那里放牧。你走
着走着，竟然迷失了道路。
LONG );
  set("no_fly", 1);
  setup();
}
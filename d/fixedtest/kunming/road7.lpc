inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG
你走在一条崎岖的山路上，再往南，就进入了云贵高原了。
北面是一条大河拦住去路。
LONG );
  set("exits", ([
    "north" : __DIR__ "road6",
    "south" : __DIR__ "yunnan",
  ]));
  set("no_fly", 1);
  setup();
}
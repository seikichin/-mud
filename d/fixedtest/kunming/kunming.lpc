// kunming —— nitan d/kunming 固定地图映射区（vrm_fixed）
//
//   kunming.map         地图（方向位掩码 + [LINK] 特殊出口）
//   kunming-room.lpc    格房描述（改文字即可改每格 look）
//   kunminggate.lpc / kunminggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/kunming/kunming/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = kunming）
// 格索引 -> 原 coor： coor = (格索引 + (-1688,-727,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "kunming-room");
  set_maze_map(__DIR__ "kunming");
  set_maze_spacing(10);
  set_maze_owner_key("kunming");

  // 入口 = yunnan1（格 12,11,0），出口 = htroad3（格 4,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "kunminggate");
  set_link_exit_room(__DIR__ "kunminggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-16820);
  set_link_entry_room_y(-7210);
  set_link_entry_room_z(40);

  set_entry_short(HIW "红土路" NOR);
  set_entry_desc("红土路，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "黄土路" NOR);
  set_exit_desc("黄土路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 kunming-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("红土路");
  set_maze_room_desc("nitan d/kunming 映射区。");
}
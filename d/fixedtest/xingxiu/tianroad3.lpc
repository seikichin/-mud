// 原 coor(50,80,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "天山山路");
  set("long", " ");
  set("exits", ([
    "northup" : __DIR__ "xxroad4",
    "eastdown" : __DIR__ "xxh",
  ]));
  set("no_fly", 1);
  setup();
}
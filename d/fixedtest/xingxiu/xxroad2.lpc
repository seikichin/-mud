// 原 coor(170,0,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "青石大道");
  set("long", @LONG
这是一条青石大道。东面隐约可以看到兰州城的城墙。北面有座小
山丘。
LONG );
  set("exits", ([
    "northup" : __DIR__ "xxroad3",
    "east" : __DIR__ "xxroad1",
  ]));
  set("no_fly", 1);
  setup();
}
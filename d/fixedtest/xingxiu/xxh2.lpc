// 原 coor(60,100,10)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "星宿海");
  set("long", @LONG
这里是星宿海。因方圆几百里都是一望无际的湖泊和沼泽，当地牧
羊人称之为“海”。也因阴暗潮湿，毒虫繁殖甚富。星宿弟子常来此捕
捉毒虫，以备练毒之用。这里通向星宿海的深处。
LONG );
  set("exits", ([
    "north" : __DIR__ "huangdi",
    "west" : __DIR__ "xiaojing",
    "east" : __DIR__ "xiaolu",
    "south" : __DIR__ "xxh1",
  ]));
  set("no_fly", 1);
  setup();
}
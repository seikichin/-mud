// 原 coor(10,120,50)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "天池");
  set("long", " ");
  set("exits", ([
    "westup" : __DIR__ "shanluan",
    "southdown" : __DIR__ "guozi",
  ]));
  set("no_fly", 1);
  setup();
}
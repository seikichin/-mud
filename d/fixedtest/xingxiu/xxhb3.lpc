inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "星宿海");
  set("long", @LONG
这里是星宿海的尽头。因为附近有野羊出没，所以星宿派弟子常常
在此烤羊肉串吃。当打不到野羊时，他们就抢山下牧人的羊。
LONG );
  set("exits", ([
    "southeast" : __DIR__ "xxhb1",
    "southwest" : __DIR__ "xxhb2",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山间平地");
  set("long", @LONG
这里有点荒凉，小草也长得无精打采的，看来是星宿的底子毒练
多了，毒素都聚集在这里，连草木也遭了殃。地上零零散散的摆了几
个木人，有些破旧。
LONG );
  set("exits", ([
    "east" : __DIR__ "wuchang2",
    "westup" : __DIR__ "ertai",
  ]));
  set("no_fly", 1);
  setup();
}
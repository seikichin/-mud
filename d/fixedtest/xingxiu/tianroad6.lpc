// 原 coor(210,0,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "天山顶峰");
  set("long", " ");
  set("exits", ([
    "eastdown" : __DIR__ "tianroad5",
    "enter" : __DIR__ "candong",
  ]));
  set("no_fly", 1);
  setup();
}
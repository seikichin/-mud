inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小路");
  set("long", @LONG
山势在这里渐渐变得平缓，你已经可以听见西边山涧底的水声。东
面有一个山洞。
LONG );
  set("exits", ([
    "enter" : __DIR__ "cangku",
    "north" : __DIR__ "xxroad6",
    "south" : __DIR__ "xxroad4",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山间平地");
  set("long", @LONG
山间平地，地上是嫩绿的小草，周围布了几棵桦树，山边有一眼清
泉。草地上树着几个毒僵尸，显是星宿弟子练功所用。
LONG );
  set("exits", ([
    "west" : __DIR__ "wuchang2",
    "south" : __DIR__ "xxroad5",
  ]));
  set("no_fly", 1);
  setup();
}
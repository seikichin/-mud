inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "星宿海");
  set("long", @LONG
这里是天山脚下的星宿海海边。因方圆几百里都是一望无际的湖泊
和沼泽，地形十分险恶。当地牧羊人称之为“海”。一旦有几只离群的
羊走迷在“海”里，便再也找不着了。臭名昭著的星宿派总坛便设在海
中央。
    南面有一条捷径可通往白驼山。
LONG );
  set("exits", ([
    "southup" : __DIR__ "tianroad2",
    "westup" : __DIR__ "tianroad3",
    "north" : __DIR__ "xxh1",
  ]));
  set("no_fly", 1);
  setup();
}
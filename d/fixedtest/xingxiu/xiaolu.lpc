// 原 coor(60,100,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小路");
  set("long", " ");
  set("exits", ([
    "northup" : __DIR__ "shanbi",
    "west" : __DIR__ "xxh2",
  ]));
  set("no_fly", 1);
  setup();
}
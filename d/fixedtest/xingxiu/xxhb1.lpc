inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "星宿海");
  set("long", @LONG
这儿便是星宿海的尽头了。举目遥望, 周围是无际的湖泊和沼泽。
虽是荒芜, 然阴暗潮湿, 毒虫繁殖甚富。星宿弟子常来此捕捉毒虫,以
备练毒之用。
LONG );
  set("exits", ([
    "southwest" : __DIR__ "riyuedong1",
    "northwest" : __DIR__ "xxhb3",
  ]));
  set("no_fly", 1);
  setup();
}
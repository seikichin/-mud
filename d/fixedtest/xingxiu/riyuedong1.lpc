// 原 coor(60,120,20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "日月洞口");
  set("long", " ");
  set("exits", ([
    "southdown" : __DIR__ "huangdi",
    "northeast" : __DIR__ "xxhb1",
    "northwest" : __DIR__ "xxhb2",
    "north" : __DIR__ "riyuedong",
  ]));
  set("no_fly", 1);
  setup();
}
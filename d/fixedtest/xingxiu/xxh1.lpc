inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "星宿海");
  set("long", @LONG
这里是星宿海。因方圆几百里都是一望无际的湖泊和沼泽，当地
牧羊人称之为“海”。也因阴暗潮湿，毒虫繁殖甚富。星宿弟子常来此
捕捉毒虫，以备练毒之用。这里通向星宿海的深处。
LONG );
  set("exits", ([
    "north" : __DIR__ "xxh2",
    "south" : __DIR__ "xxh",
  ]));
  set("no_fly", 1);
  setup();
}
// 原 coor(60,110,30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山壁");
  set("long", " ");
  set("exits", ([
    "southdown" : __DIR__ "xiaolu",
  ]));
  set("no_fly", 1);
  setup();
}
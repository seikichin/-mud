// xingxiu —— nitan d/xingxiu 固定地图映射区（vrm_fixed）
//
//   xingxiu.map         地图（方向位掩码 + [LINK] 特殊出口）
//   xingxiu-room.lpc    格房描述（改文字即可改每格 look）
//   xingxiugate.lpc / xingxiugate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/xingxiu/xingxiu/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = xingxiu）
// 格索引 -> 原 coor： coor = (格索引 + (8,2,1)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "xingxiu-room");
  set_maze_map(__DIR__ "xingxiu");
  set_maze_spacing(10);
  set_maze_owner_key("xingxiu");

  // 入口 = luzhou（格 0,1,0），出口 = silk4（格 3,1,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "xingxiugate");
  set_link_exit_room(__DIR__ "xingxiugate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(110);
  set_link_entry_room_y(60);
  set_link_entry_room_z(50);

  set_entry_short(HIW "沙漠绿洲" NOR);
  set_entry_desc("沙漠绿洲，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "丝绸之路" NOR);
  set_exit_desc("丝绸之路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 xingxiu-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("沙漠绿洲");
  set_maze_room_desc("nitan d/xingxiu 映射区。");
}
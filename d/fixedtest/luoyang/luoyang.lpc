// luoyang —— nitan d/luoyang 固定地图映射区（vrm_fixed）
//
//   luoyang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   luoyang-room.lpc    格房描述（改文字即可改每格 look）
//   luoyanggate.lpc / luoyanggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/luoyang/luoyang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = luoyang）
// 格索引 -> 原 coor： coor = (格索引 + (-703,210,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "luoyang-room");
  set_maze_map(__DIR__ "luoyang");
  set_maze_spacing(10);
  set_maze_owner_key("luoyang");

  // 入口 = futusi（格 6,17,0），出口 = suishi2（格 9,3,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "luoyanggate");
  set_link_exit_room(__DIR__ "luoyanggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-6970);
  set_link_entry_room_y(2190);
  set_link_entry_room_z(50);

  set_entry_short(HIW "负图寺" NOR);
  set_entry_desc("负图寺，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "碎石路" NOR);
  set_exit_desc("碎石路，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 luoyang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("负图寺");
  set_maze_room_desc("nitan d/luoyang 映射区。");
}
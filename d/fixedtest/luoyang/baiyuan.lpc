void create() {
  set("short", "白园");
  set("long", @LONG
白园或称白冢，在东香山北端琵琶峰上。墓前石碑刻“唐少傅白公
墓”六字。白居易晚年寓居香山，自号“香山居士”。
LONG );
  set("exits", ([
    "westdown" : __DIR__ "longmen",
  ]));
  set("no_fly", 1);
  setup();

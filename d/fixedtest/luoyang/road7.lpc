inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "土路");
  set("long", @LONG
这是洛阳城郊的一条茅草土路。洛阳四塞之地，平原远处天际间，
隐隐可见群山逶迤。
LONG );
  set("exits", ([
    "south" : __DIR__ "dukang",
    "north" : __DIR__ "road2",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "杜康仙庄");
  set("long", @LONG
杜康仙庄是酒祖造酒遗址，是酒文化发源地。“杜康仙庄”为周平
王封赐，位于洛阳东南一百里杜康村。山门是琉璃瓦的朱红门楼，进入
庄内有杜康祠，爬山碑廊，雕栏池，樱花圆和七贤台。
LONG );
  set("exits", ([
    "north" : __DIR__ "road7",
  ]));
  set("no_fly", 1);
  setup();
}
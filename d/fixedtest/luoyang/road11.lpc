inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大官道");
  set("long", @LONG
这是一条宽阔笔直的官道，足可容得下十马并驰。道路两边，是一
排排高树。树林之外，便是一片片的农田了。大道往东通向脂粉之都的
扬州，而西面则是通往洛阳城。
LONG );
  set("exits", ([
    "east" : __DIR__ "road10",
    "west" : __DIR__ "road0",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大官道");
  set("long", @LONG
这是一条宽阔笔直，尘土飞扬的大官道，它连接了东都长安和西都洛
阳。官道很是宽广，足可容得下十马并驰。往西直达长安的东门，而往东
边不远便是东都洛阳古城的西城边了。
LONG );
  set("exits", ([
    "west" : "/d/fixedtest/changan/16/4/0",
    "eastup" : __DIR__ "wbridge",
  ]));
  set("no_fly", 1);
  setup();
}
// dukou1 —— 由 nitan/d/luoyang/dukou1.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-480,-40,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "洛水渡口");
  set("long", @LONG
这是洛阳城郊的洛水渡口，静静的洛水由此向东，汇入滚滚黄河。
码头上正泊着一艘乌篷船。
LONG );
  set("exits", ([
    "east" : __DIR__ "gongshu",
    "northwest" : __DIR__ "luopu",
  ]));
  set("no_fly", 1);
  setup();
}
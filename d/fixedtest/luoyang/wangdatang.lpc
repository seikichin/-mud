// wangdatang —— 由 nitan/d/luoyang/wangdatang.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-7021,2159,-1)  coor 不是 10 的倍数
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大堂");
  set("long", @LONG
一进大堂门，只见梁上悬着一块黑漆大匾，写着“见义勇为”四个
金字，下面落款是河南省的巡抚某人。看来王家的势力非只武功上的名
声而来的。这里也是王家迎宾欢宴的地方，檐下栏边，均装饰的十分华
贵。
LONG );
  set("exits", ([
    "west" : __DIR__ "wangzhangfang",
    "north" : __DIR__ "wangdayuan",
    "south" : __DIR__ "wanghuating",
  ]));
  set("no_fly", 1);
  setup();
}
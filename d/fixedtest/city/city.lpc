// city —— nitan d/city 映射区（vrm_fixed 固定地图）
//
// 必须文件：
//   city.map       地图（位掩码网格，勿手改）
//   city-room.lpc  格房描述表（改文字即可改每格 look 结果）
//
// 虚拟格房路径 = <本目录>/<x>/<y>/<z>
//   （vrm_fixed 短路径：owner 段与区名重复时省略；入口/出口为 <本目录>/entry|exit）
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "city-room");
  set_maze_map(__DIR__ "city");
  set_maze_spacing(10);
  set_maze_owner_key("city");

  // 入口=南门(nanmen)，出口=北门(beimen)
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "citygate");
  set_link_exit_room(__DIR__ "citygate2");
  set_entry_back_dir("up");   // 入口房 up -> citygate
  set_exit_back_dir("out");   // 出口房 out -> citygate2

  // 让格房 coor 与原 nitan 坐标逐个对齐
  //   coor = 格索引*10 + 偏移，偏移 = (link_x, link_y, link_z - h*spacing - spacing)
  set_link_entry_room_x(-10);
  set_link_entry_room_y(-10);
  set_link_entry_room_z(40);

  set_entry_short(HIW "城南门" NOR);
  set_entry_desc("城南门外，一条土路通向远方。");
  set_exit_short(HIY "城北门" NOR);
  set_exit_desc("城北门外，官道向北延伸。");

  // 下面两个只用于通过引擎 check_vars() 的非空校验；
  // 格房的实际 short/long 由 city-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("街道");
  set_maze_room_desc("nitan d/city 映射区。");
}

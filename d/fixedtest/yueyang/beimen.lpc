inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "岳阳北门");
  set("long", @LONG
这里是岳阳城的北门。青石筑成两层楼台坚固异常，巍峨宽阔的拱
形城门上方，镂着「岳阳」两个红漆大字。北面是一条黄土路，直通江
陵。
LONG );
  set("exits", ([
    "northwest" : "/d/fixedtest/jingzhou/tulu2",
    "south" : __DIR__ "beijie",
  ]));
  set("no_fly", 1);
  setup();
}
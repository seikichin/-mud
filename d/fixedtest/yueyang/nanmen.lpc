inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "岳阳南门");
  set("long", @LONG
这里是岳阳城的南门。青石筑成两层楼台坚固异常，巍峨宽阔的拱
形城门上方，镂着「岳阳」两个红漆大字。南面是一条林荫大道，通向
衡阳。
LONG );
  set("exits", ([
    "southeast" : "/d/fixedtest/henshan/6/6/1",
    "north" : __DIR__ "nanjie",
  ]));
  set("no_fly", 1);
  setup();
}
// nanjie —— 由 nitan/d/yueyang/nanjie.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-6200,-3020,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "南街");
  set("long", @LONG
这是一条又长又宽的青石大道，东边是客店，西边是饭店，这里是
南来北往的客商必到之处，因此也是全城最热闹的地方。两边的小二在
屋檐下不停地招揽生意，一些流氓和不成器的乞丐们也混在其中乘机揩
油，大姑娘喊，小媳妇闹，响成一片。
LONG );
  set("exits", ([
    "south" : __DIR__ "nanmen",
    "north" : __DIR__ "zhongxin",
    "east" : __DIR__ "kedian",
    "west" : __DIR__ "jiudian",
  ]));
  set("no_fly", 1);
  setup();
}
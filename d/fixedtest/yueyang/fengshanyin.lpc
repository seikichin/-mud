inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "封山印");
  set("long", " ");
  set("exits", ([
    "northwest" : __DIR__ "3/0/0",
    "northeast" : __DIR__ "5/0/0",
  ]));
  set("no_fly", 1);
  setup();
}
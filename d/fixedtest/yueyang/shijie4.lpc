inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "青石道");
  set("long", @LONG
这是通往酒香山上酒香亭的青石小道。小道两边茶树连绵，竹响随
人，真是个清幽所在。望山下，洞庭湖水簇拥君山，青碧一片，景色甚
是怡人。
LONG );
  set("exits", ([
    "eastdown" : __DIR__ "shijie3",
    "westup" : __DIR__ "shijie5",
  ]));
  set("no_fly", 1);
  setup();
}
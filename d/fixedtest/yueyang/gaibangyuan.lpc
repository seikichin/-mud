// gaibangyuan —— 由 nitan/d/yueyang/gaibangyuan.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-6210,-2990,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大院");
  set("long", " ");
  set("exits", ([
    "south" : __DIR__ "gaibanggate",
    "north" : __DIR__ "gaibangtang",
  ]));
  set("no_fly", 1);
  setup();
}
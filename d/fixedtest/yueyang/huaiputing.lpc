// 原 coor(-6230,-3000,10)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "怀甫亭");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "loumen",
    "westup" : __DIR__ "yueyanglou1",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "岳阳楼二楼");
  set("long", " ");
  set("exits", ([
    "down" : __DIR__ "yueyanglou1",
    "up" : __DIR__ "yueyanglou3",
  ]));
  set("no_fly", 1);
  setup();
}
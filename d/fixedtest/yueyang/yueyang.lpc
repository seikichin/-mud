// yueyang —— nitan d/yueyang 固定地图映射区（vrm_fixed）
//
//   yueyang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   yueyang-room.lpc    格房描述（改文字即可改每格 look）
//   yueyanggate.lpc / yueyanggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/yueyang/yueyang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = yueyang）
// 格索引 -> 原 coor： coor = (格索引 + (-174,228,-2)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "yueyang-room");
  set_maze_map(__DIR__ "yueyang");
  set_maze_spacing(10);
  set_maze_owner_key("yueyang");

  // 入口 = xiangfeici3（格 8,5,0），出口 = shejiaotai（格 0,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "yueyanggate");
  set_link_exit_room(__DIR__ "yueyanggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-1690);
  set_link_entry_room_y(2320);
  set_link_entry_room_z(20);

  set_entry_short(HIW "湘妃祠正殿" NOR);
  set_entry_desc("湘妃祠正殿，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "射蛟台" NOR);
  set_exit_desc("射蛟台，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 yueyang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("湘妃祠正殿");
  set_maze_room_desc("nitan d/yueyang 映射区。");
}
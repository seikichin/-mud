inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "岳阳楼门");
  set("long", @LONG
这里是岳阳楼的大门，门上是一幅黑底蓝字对联“洞庭天下水，岳
阳天下楼”。岳阳楼建在岳阳城楼上，建筑精巧雄伟，与洪都滕王阁、
武昌黄鹤楼并称江南三大名楼，
LONG );
  set("exits", ([
    "southdown" : __DIR__ "ximen",
    "west" : __DIR__ "huaiputing",
  ]));
  set("no_fly", 1);
  setup();
}
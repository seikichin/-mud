// road8 —— 由 nitan/d/beijing/road8.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-2770,7570,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大驿道");
  set("long", @LONG
你走在一条尘土飞扬的大驿道上。北上就是北京城。挑担子的、
行商的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。
不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。西边有个小摊，
许多人在那里歇息。
LONG );
  set("exits", ([
    "west" : __DIR__ "xiaotan",
    "south" : __DIR__ "road9",
    "north" : __DIR__ "road4",
  ]));
  set("no_fly", 1);
  setup();
}
// matou —— 由 nitan/d/beijing/matou.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-2800,7600,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "通州码头");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "chaoyangmen",
  ]));
  set("no_fly", 1);
  setup();
}
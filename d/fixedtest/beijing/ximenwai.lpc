inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "西门外");
  set("long", @LONG
这里是北京的西城门外。人来人往，煞是热闹。
LONG );
  set("exits", ([
    "south" : __DIR__ "liandan_lin2",
    "north" : __DIR__ "liandan_lin1",
    "east" : __DIR__ "xichengmen",
    "west" : "/d/fixedtest/heimuya/6/8/10",
  ]));
  set("no_fly", 1);
  setup();
}
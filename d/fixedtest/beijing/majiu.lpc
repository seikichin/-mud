// 原 coor(-2850,7680,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "马厩");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "0/6/0",
    "north" : __DIR__ "business",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "城西后林");
  set("long", @LONG
这是一片茂密的树林。很多棵几十丈高的大树聚在一块，象一把
把琼天大伞，连日月都被遮蔽得黯然无光。树林中还不时可以听到大
自然发出的声响。
LONG );
  set("exits", ([
    "south" : __DIR__ "liandan_lin6",
    "east" : __DIR__ "liandan_lin7",
    "north" : __DIR__ "ximenwai",
  ]));
  set("no_fly", 1);
  setup();
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "庄府大厅");
  set("long", @LONG
这是一间大厅，通往各个房间。东边的屋里有女子啼哭之声隐隐
传来。
LONG );
  set("exits", ([
    "south" : __DIR__ "6/2/0",
    "north" : __DIR__ "zhuang8",
    "east" : __DIR__ "zhuang6",
    "west" : __DIR__ "zhuang7",
  ]));
  set("no_fly", 1);
  setup();
}
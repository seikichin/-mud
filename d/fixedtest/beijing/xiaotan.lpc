inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小摊");
  set("long", @LONG
这是一临时搭成的小摊，生意却非常兴隆。路人都爱在这里落脚，
你可以在这里打听到京城的奇闻逸趣。小二匆匆忙忙地接待着南来北
往的客人。树荫下摆着几张小木桌，桌旁坐满了各种各样的游人。
LONG );
  set("exits", ([
    "east" : __DIR__ "road8",
  ]));
  set("no_fly", 1);
  setup();
}
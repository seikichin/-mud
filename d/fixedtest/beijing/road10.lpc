// 原 coor(-2770,7550,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小道");
  set("long", @LONG
你走在一条尘土飞扬的大驿道上。四周人来人往。挑担子的、行
商的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。不
时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁是整整
齐齐的杨树林。东边就是大海之滨了。
LONG );
  set("exits", ([
    "north" : __DIR__ "road9",
    "east" : __DIR__ "haigang",
    "south" : "/d/fixedtest/ruzhou/2/5/0",
  ]));
  set("no_fly", 1);
  setup();
}
// beijing —— nitan d/beijing 固定地图映射区（vrm_fixed）
//
//   beijing.map         地图（方向位掩码 + [LINK] 特殊出口）
//   beijing-room.lpc    格房描述（改文字即可改每格 look）
//   beijinggate.lpc / beijinggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/beijing/beijing/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = beijing）
// 格索引 -> 原 coor： coor = (格索引 + (-284,762,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "beijing-room");
  set_maze_map(__DIR__ "beijing");
  set_maze_spacing(10);
  set_maze_owner_key("beijing");

  // 入口 = anding（格 4,14,0），出口 = cagc_w（格 3,5,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "beijinggate");
  set_link_exit_room(__DIR__ "beijinggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-2790);
  set_link_entry_room_y(7710);
  set_link_entry_room_z(50);

  set_entry_short(HIW "安定门" NOR);
  set_entry_desc("安定门，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "西长安广场" NOR);
  set_exit_desc("西长安广场，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 beijing-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("安定门");
  set_maze_room_desc("nitan d/beijing 映射区。");
}
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "皇宫大殿");
  set("long", @LONG
这里便是紫禁城的正门的大殿，寻常百姓是到不了这里来的，如
果你以不正当的途径到了这里，还是赶快离开为好。
LONG );
  set("exits", ([
    "west" : __DIR__ "hg_w",
    "south" : __DIR__ "4/7/0",
    "north" : __DIR__ "4/9/0",
  ]));
  set("no_fly", 1);
  setup();
}
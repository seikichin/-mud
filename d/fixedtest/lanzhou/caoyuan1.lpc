inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大草原");
  set("long", @LONG
西北平原上的大草原，较之蒙古草原毫不逊色。绿油油的牧草直连
天边。西北的蓝天绿地，比起东北的黑山白水来，别有一番风趣。
LONG );
  set("exits", ([
    "south" : "/d/fixedtest/changan/road9",
  ]));
  set("no_fly", 1);
  setup();
}
// lanzhou —— nitan d/lanzhou 固定地图映射区（vrm_fixed）
//
//   lanzhou.map         地图（方向位掩码 + [LINK] 特殊出口）
//   lanzhou-room.lpc    格房描述（改文字即可改每格 look）
//   lanzhougate.lpc / lanzhougate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/lanzhou/lanzhou/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = lanzhou）
// 格索引 -> 原 coor： coor = (格索引 + (-1577,378,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "lanzhou-room");
  set_maze_map(__DIR__ "lanzhou");
  set_maze_spacing(10);
  set_maze_owner_key("lanzhou");

  // 入口 = caoyuan2（格 3,2,0），出口 = westgate（格 0,4,0）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "lanzhougate");
  set_link_exit_room(__DIR__ "lanzhougate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(-15750);
  set_link_entry_room_y(3820);
  set_link_entry_room_z(30);

  set_entry_short(HIW "大草原" NOR);
  set_entry_desc("大草原，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "西门" NOR);
  set_exit_desc("西门，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 lanzhou-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("大草原");
  set_maze_room_desc("nitan d/lanzhou 映射区。");
}
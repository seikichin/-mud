inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "沙丘小洞");
  set("long", @LONG
这里是沙丘石碑下的一个密洞。里面破破烂烂的，丢满了各种
杂物，还有丐帮弟子收集的破铜烂铁等。从这里通往丐帮的秘密通
道。
LONG );
  set("exits", ([
    "east" : __DIR__ "xxandao2",
  ]));
  set("no_fly", 1);
  setup();
}
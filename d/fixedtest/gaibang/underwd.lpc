inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "土匪窝边");
  set("long", @LONG
这是武当山下土匪窝边上的小山洞。里面破破烂烂的，丢满了各种
杂物，还有丐帮弟子收集的破铜烂铁等。从这里通往丐帮的秘密通道。
LONG );
  set("exits", ([
    "northeast" : __DIR__ "wdandao2",
    "out" : "/d/fixedtest/wudang/tufeiwo1",
  ]));
  set("no_fly", 1);
  setup();
}
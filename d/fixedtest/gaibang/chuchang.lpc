// 原 coor(10,-10,-30)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "储藏室");
  set("long", @LONG
这里是丐帮的储藏室，你可以看见一个个锁着的箱子。周围还悬
挂着一些武器和装备。这时有一位丐帮五袋弟子正闭目养神，看守着
这里。
LONG );
  set("exits", ([
    "east" : __DIR__ "undertre",
    "west" : __DIR__ "mishi",
  ]));
  set("no_fly", 1);
  setup();
}
// gaibang —— nitan d/gaibang 固定地图映射区（vrm_fixed）
//
//   gaibang.map         地图（方向位掩码 + [LINK] 特殊出口）
//   gaibang-room.lpc    格房描述（改文字即可改每格 look）
//   gaibanggate.lpc / gaibanggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/gaibang/gaibang/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = gaibang）
// 格索引 -> 原 coor： coor = (格索引 + (6,6,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "gaibang-room");
  set_maze_map(__DIR__ "gaibang");
  set_maze_spacing(10);
  set_maze_owner_key("gaibang");

  // 入口 = pomiao（格 1,0,0），出口 = shoushe（格 0,0,0）
  set_entry_dir("up");
  set_link_entry_room(__DIR__ "gaibanggate");
  set_link_exit_room(__DIR__ "gaibanggate2");
  set_entry_back_dir("up");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(70);
  set_link_entry_room_y(60);
  set_link_entry_room_z(20);

  set_entry_short(HIW "土地庙" NOR);
  set_entry_desc("土地庙，从这里可以进入迷宫（up）。\n");
  set_exit_short(HIY "兽舍" NOR);
  set_exit_desc("兽舍，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 gaibang-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("土地庙");
  set_maze_room_desc("nitan d/gaibang 映射区。");
}
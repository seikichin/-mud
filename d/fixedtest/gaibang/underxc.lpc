inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "谷场槐树边");
  set("long", @LONG
这是谷场槐树边的谷堆，四周都是大谷堆。四周丢满了各种
杂物，还有丐帮弟子收集的破铜烂铁等。从这里通往丐帮的秘密
通道。
LONG );
  set("exits", ([
    "south" : __DIR__ "xcandao2",
    "up" : "/d/fixedtest/village/3/8/0",
  ]));
  set("no_fly", 1);
  setup();
}
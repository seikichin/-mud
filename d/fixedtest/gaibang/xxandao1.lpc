inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "暗道");
  set("long", @LONG
这是丐帮极其秘密的地下通道，乃用丐帮几辈人之心血掘成。 
LONG );
  set("exits", ([
    "east" : __DIR__ "undertre",
    "west" : __DIR__ "xxandao2",
  ]));
  set("no_fly", 1);
  setup();
}
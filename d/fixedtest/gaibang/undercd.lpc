  set("short", "破床底下");
  set("long", @LONG
这是成都城一个偏僻大院的破床下。四周丢满了各种杂物，还有丐
帮弟子收集的破铜烂铁等。从这里通往丐帮的秘密通道。
LONG );
  set("exits", ([
    "northeast" : __DIR__ "cdandao2",
    "out" : "/d/fixedtest/chengdu/ruin2",
  ]));
  set("no_fly", 1);
  setup();
}
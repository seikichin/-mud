inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "雪坑小洞");
  set("long", @LONG
这里是大雪山雪坑下的一个密洞。里面破破烂烂的，丢满各种
杂物，还有丐帮弟子收集的破铜烂铁等。从这里通往丐帮的秘密通
道。
LONG );
  set("exits", ([
    "northeast" : __DIR__ "xsandao2",
  ]));
  set("no_fly", 1);
  setup();
}
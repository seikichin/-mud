// undertre —— 由 nitan/d/gaibang/undertre.c 转换（独立房间，不在固定地图网格内）
// 原 coor(10,-10,-20)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "树洞下");
  set("long", " ");
  set("exits", ([
    "1" : __DIR__ "xcandao1",
    "0" : __DIR__ "yyandao1",
    "3" : __DIR__ "slandao1",
    "west" : __DIR__ "chuchang",
    "5" : __DIR__ "wdandao1",
    "4" : __DIR__ "xxandao1",
    "7" : __DIR__ "bjandao1",
    "6" : __DIR__ "hsandao1",
    "9" : __DIR__ "xsandao1",
    "8" : __DIR__ "qzandao1",
    "f" : __DIR__ "cdandao1",
    "c" : __DIR__ "wxandao1",
    "b" : __DIR__ "fzandao1",
    "a" : __DIR__ "dlandao1",
    "up" : __DIR__ "inhole",
    "2" : __DIR__ "zlandao1",
  ]));
  set("no_fly", 1);
  setup();
}
// songlin6 —— 由 nitan/d/yubifeng/songlin6.c 转换（独立房间，不在固定地图网格内）
// 原 coor(6100,5170,0)  所属格无任何方向位（值为 0 = 引擎不生成房间）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "大松林");
  set("long", " ");
  set("exits", ([
    "east" : __DIR__ "fengdi",
    "west" : __DIR__ "songlin5",
  ]));
  set("no_fly", 1);
  setup();
}
// yubifeng —— nitan d/yubifeng 固定地图映射区（vrm_fixed）
//
//   yubifeng.map         地图（方向位掩码 + [LINK] 特殊出口）
//   yubifeng-room.lpc    格房描述（改文字即可改每格 look）
//   yubifenggate.lpc / yubifenggate2.lpc   迷宫外入口房 / 出口房
//   其它 .lpc               不能入网格的独立房间
//
// 虚拟格房路径 = <本目录>/yubifeng/yubifeng/x/y/z
//   （引擎 mroom_fname = base_name(区域对象)/owner/x/y/z，owner = yubifeng）
// 格索引 -> 原 coor： coor = (格索引 + (610,512,0)) * 10
inherit "/std/room/vrm_fixed";
#include <ansi.h>

void create() {
  set_inherit_room(__DIR__ "yubifeng-room");
  set_maze_map(__DIR__ "yubifeng");
  set_maze_spacing(10);
  set_maze_owner_key("yubifeng");

  // 入口 = eastroom2（格 4,8,10），出口 = fengding（格 1,5,10）
  set_entry_dir("down");
  set_link_entry_room(__DIR__ "yubifenggate");
  set_link_exit_room(__DIR__ "yubifenggate2");
  set_entry_back_dir("down");
  set_exit_back_dir("out");

  // 让格房 coor 与原 nitan 坐标逐个对齐
  set_link_entry_room_x(6120);
  set_link_entry_room_y(5170);
  set_link_entry_room_z(120);

  set_entry_short(HIW "东厢房" NOR);
  set_entry_desc("东厢房，从这里可以进入迷宫（down）。\n");
  set_exit_short(HIY "玉笔峰" NOR);
  set_exit_desc("玉笔峰，出口就在这里。\n");

  // 仅用于通过引擎 check_vars() 的非空校验；
  // 格房实际 short/long 由 yubifeng-room.lpc 的 setup_room_desc() 决定。
  set_maze_room_short("东厢房");
  set_maze_room_desc("nitan d/yubifeng 映射区。");
}
// chibi6 —— 由 nitan/d/jingzhou/chibi6.c 转换（独立房间，不在固定地图网格内）
// 原 coor(-370,-230,-20)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "赤壁古战场");
  set("long", @LONG
这里就是有名的古赤壁战场，对岸一面巨大的悬崖绝壁之上书有
「赤壁」两个大字，想当年曹操百万精兵在此被周愈杀的片甲不留，
含恨而归。文学家苏东坡游临此地，便感慨的留下了『遥想公谨当年，
小乔初嫁了，羽扇纶巾，雄姿英发，谈笑间，强虏灰飞烟灭……』令
后人引为佳句。从这里向江面看去，只见滚滚江水东流去，江面上若
隐若现一条条大铁索，原来是当年吴国为了抵御曹操而修的锁江链。
LONG );
  set("exits", ([
    "east" : __DIR__ "chibi5",
  ]));
  set("no_fly", 1);
  setup();
}
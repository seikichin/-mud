inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "饭馆");
  set("long", @LONG
这是一家湘西的小饭馆，布置颇为简易，顾客多是匆匆的行人，
买点包子、鸡腿、米酒就赶路去了。
LONG );
  set("exits", ([
    "west" : __DIR__ "4/7/0",
  ]));
  set("no_fly", 1);
  setup();
}
// 原 coor(-7100,-2150,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "长江南岸");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "qiao3",
    "south" : __DIR__ "tulu1",
  ]));
  set("no_fly", 1);
  setup();
}
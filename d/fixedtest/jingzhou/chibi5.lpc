inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "长江岸边");
  set("long", @LONG
这里是长江北岸，江水在你身边哗哗的流淌，偶尔你会在沙滩上
发现有一些残刀断戟，原来西边不远就是有名的古战场赤壁。
LONG );
  set("exits", ([
    "east" : __DIR__ "chibi4",
    "west" : __DIR__ "chibi6",
  ]));
  set("no_fly", 1);
  setup();
}
// 原 coor(-7120,-2070,-10)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "林荫道");
  set("long", @LONG
这是一条安静的林荫道，地上铺着奇奇怪怪五颜六色的石子，向
东西两头延伸。东面是一条林荫道。径直通南大街。西边好像有一眼
温泉。
LONG );
  set("exits", ([
    "east" : __DIR__ "lydao4",
    "westdown" : __DIR__ "wenquan",
  ]));
  set("no_fly", 1);
  setup();
}
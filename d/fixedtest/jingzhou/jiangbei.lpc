// 原 coor(-7100,-2110,0)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "长江北岸");
  set("long", " ");
  set("exits", ([
    "north" : __DIR__ "4/0/0",
    "south" : __DIR__ "qiao",
  ]));
  set("no_fly", 1);
  setup();
}
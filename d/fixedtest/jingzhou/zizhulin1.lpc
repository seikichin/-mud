// 原 coor(-7090,-2100,-10)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "紫竹林");
  set("long", " ");
  set("exits", ([
    "enter" : __DIR__ "xiaoyuan",
    "north" : __DIR__ "zizhulin",
  ]));
  set("no_fly", 1);
  setup();
}
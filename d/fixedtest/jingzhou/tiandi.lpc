// 原 coor(-7120,-2170,10)  超出引擎地图边长上限 100（只保留最密集窗口）
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "农田");
  set("long", @LONG
这里是湘西山中的一片农田。山里土地贫脊也没什么可种的，乡下
人家种了些小麦番薯。田里禾秧已长得四寸来高。田梗上插种着大豆和
花生，倒是绿油油的显得比较有生气。
LONG );
  set("exits", ([
    "eastdown" : __DIR__ "tulu3",
    "south" : __DIR__ "maxipu",
  ]));
  set("no_fly", 1);
  setup();
}
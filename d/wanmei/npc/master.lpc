void killed_enemy(object who) {
  command("say 狂妄之徒，死不足惜！\n");
}

void die() {
  object killer;
  if (objectp(killer = query_temp("last_damage_from"))) {
    if (killer->query("marks/won_lu")) killer->set("marks/kill_ximen", 1);
  }
  ::die();
}

smart_fight() {
  int i;
  object *enemy, who;
  who = this_object();
  enemy = this_object()->query_enemy();
  i = sizeof(enemy);
  if (i > 2 && enemy[1]->is_zombie() && random(3) > 0) {
    who->perform_action("sword.zombie-wp1");
    return;
  }
  if (!random(5))
    who->perform_action("sword.hunranyijian");
  return;
}

// 卡⑧《万梅·青穗剑》—— 剑神一笑
// 门下那柄锈死在木桩里二十年的剑，终于有人请了出来
int ask_sword() {
  object me = this_player();

  if (!present("qingsui sword", me)) {
    message_vision(CYN "$N淡淡道：后院木桩里那柄剑，已经插在那里二十年了。\n" NOR,
      this_object(), me);
    message_vision(CYN "「你若请得出来，尽管拿去。」\n" NOR, this_object(), me);
    return 1;
  }

  if (REWARD_D->check_m_success(me, "青穗剑")) {
    message_vision(CYN "$N看了你一眼，什么都没有说。\n" NOR, this_object(), me);
    return 1;
  }

  message_vision(YEL "\n$N的目光落在那柄剑上，停了很久。\n" NOR, this_object(), me);
  message_vision(CYN "「二十年前我把它插进木桩里，是因为我已经不需要它了。」\n" NOR,
    this_object(), me);
  message_vision(CYN "「二十年里，来拔它的人没有一百也有八十个。」\n" NOR,
    this_object(), me);
  message_vision(CYN "「他们拔的是剑；你想的是锈。」\n" NOR, this_object(), me);
  message_vision(CYN "「冷的东西，热一下就会松口 —— 这个道理，二十年来只有你想到。」\n" NOR,
    this_object(), me);
  message_vision(HIY "\n$N忽然笑了一笑。\n" NOR, this_object(), me);
  message_vision(CYN "「门上那四个字，你如今该看懂了：无剑为上。」\n" NOR, this_object(), me);

  REWARD_D->riddle_done(me, "青穗剑", 10, 1);
  tell_object(me, HIG "\n你忽然明白：他等的从来不是力气。\n" NOR);
  return 1;
}

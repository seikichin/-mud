// TIE@FY3 ALL RIGHTS RESERVED
#include <ansi.h>
inherit ROOM;

string shifeng_desc();

void create() {
  set("short", "苦竹溪");
  set("long", @LONG
沿途盛产苦竹，溪水从竹林底穿过，流到这里汇成了一眼小泉，泉水带有淡淡
的苦涩味，但是良药苦口，苦竹更是入药的上品，所以知情人甚爱饮此泉水，泉水
对于解乏提神极有帮助。再往前，一堵峭壁挡住了去路。
LONG
  );
  set("exits", ([
    "southup": __DIR__ "zhulin",
  ]));
  set("objects", ([
    __DIR__ "npc/snake": 2,
  ]));
  set("item_desc", ([
    "苦竹溪": "你可以试着从溪（ｘｉ）中喝（ｄｒｉｎｋ）一口。\n",
    "kuzhuxi": "你可以试着从溪（ｘｉ）中喝（ｄｒｉｎｋ）一口。\n",
    "峭壁": "峭壁挡住了去路，崖顶似乎露出几户人家。\n",
    "人家": "峭壁挡住了去路，崖顶似乎露出几户人家。\n",
    "石缝": (: shifeng_desc :),
    "石头": (: shifeng_desc :),
    "岩石": (: shifeng_desc :),
  ]));
  set("outdoors", "huangshan");
  set("coor/x", -50);
  set("coor/y", 45);
  set("coor/z", 10);
  setup();
}

void init() {
  add_action("do_drink", "drink");
  add_action("climbing", "climb");
}

int do_drink(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "xi") return 0;
  if (me->query("water") >= me->max_water_capacity())
    return notify_fail("你似乎并不渴。\n");
  message_vision("$N弯下腰，在苦竹溪中喝了一大口苦水！\n", me);
  me->add("water", 50);
  me->apply_condition("kuzhu", 3 + random(5));
  return 1;
}

int climbing(string arg) {
  object me;
  int i;

  me = this_player();
  i = me->query_skill("move");
  if (!arg || arg == "") return notify_fail("你要爬什么？\n");
  if (arg == "valley" || arg == "up" || arg == "峭壁") {
    if (me->is_busy())
      return notify_fail("你现在正忙。\n");
    if (me->query_temp("huangshan/hs_climb_down"))
      return notify_fail("你已经在往上爬了。\n");
    message_vision("$N抓着突出的石角，慢慢的顺着峭壁爬了上去。\n", me);
    call_out("fliping", 2, me);
    me->set_temp("huangshan/hs_climb_up", 1);
    me->start_busy(2);
    return 1;
  } else {
    write("你不可以爬" + arg + "\n");
  }
  return 1;
}

int fliping(object me) {
  if (!me->is_ghost() && objectp(me) && environment(me) == this_object()) {
    me->move(__DIR__ "huangshan");
    me->delete_temp("huangshan/hs_climb_up");
    message_vision("$N顺着谷壁爬了上来。\n", me);
  }
  return 1;
}

// ---- 画眉鸟：石缝中的尸体与面具 ----
string shifeng_desc() {
  object me, mask;
  int i;

  me = this_player();
  if (!me) return "溪边乱石嶙峋，被水冲得发白。\n";

  i = REWARD_D->riddle_check(me, "画眉鸟");

  if (i == 1) {
    REWARD_D->riddle_set(me, "画眉鸟", 2);
    mask = new(__DIR__ "obj/zitanmask");
    message_vision(HIW "\n$N拨开溪边一丛苦竹，忽然闻到一股极淡的腥气。\n\n" NOR, me);
    message_vision(HIY "石头缝里蜷着一个采药女子的尸身，衣衫完好，钱袋也还在。\n"
      "　　可她脸上——眉毛不见了。整整齐齐，被人一刀削了去。\n\n" NOR, me);
    message_vision(HIG "$N在尸身旁边发现了一样东西：\n"
      "　　一张紫檀木雕成的面具。五官栩栩如生，连眉毛都一根根雕了出来。\n\n" NOR, me);
    if (mask && mask->move(me)) {
      tell_object(me, "你拾起了紫檀面具。\n");
      return "石缝里空空荡荡，只剩下被水冲得发白的碎石。\n";
    }
    return "石缝里空空荡荡，只剩下被水冲得发白的碎石。\n";
  }

  if (i >= 2)
    return "石缝里空空荡荡，只剩下被水冲得发白的碎石。\n";

  return "溪边乱石嶙峋，被水冲得发白。石缝间似乎夹着些什么。\n";
}

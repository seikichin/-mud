// 《陆小凤·幽灵山庄》—— 十二张白纸卡（卡⑦ 核心道具）
// 白纸并非无字：须以炉火烘烤，字迹方显。
//
// 设计依据（古龙《陆小凤系列·幽灵山庄》）：
//   「光泽柔润古铜镇纸下，垫着十二张白纸卡。」
//   「十二张纸卡上，有十二个人的名字。十二个了不起的名字！」
//   高涛 / 顾飞云 / 柳青青 / 海奇阔 ……

#include <ansi.h>
inherit ITEM;

void create() {
  set_name("白纸卡", ({ "card", "cards", "白纸卡", "纸卡" }));
  set_weight(60);
  set_max_encumbrance(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "叠");
    set("value", 1);
    set("long",
      "一叠裁得整整齐齐的白纸卡，一共十二张，张张都是空白的。\n"
      "凑近了细看，纸面上又似乎浮着一层极淡的水痕，\n"
      "像是写过字的旧信，浸过了水，又烘干了。\n");
  }
  ::init_item();
}

// 戏折子 —— 剧情驱动器（原型验证）
// 命令、剧情、对话、spawn 全在玩家身上这一个道具里；剧情结束 destruct 回收。

inherit ITEM;
#include <ansi.h>

void create() {
  set_name("戏折子", ({ "xizhezi", "story", "script" }));
  set_weight(1);
  set("long", "一本薄薄的戏折子，封面写着四个字：身临其境。\n");
  set("no_drop", 1);
  set("no_sell", 1);
  set("no_get", 1);
  set("stage", 0);
}

void init() {
  if (this_player() == environment())
    add_action("do_story", "story");
}

int do_story(string arg) {
  object me, npc;
  int st;

  me = this_player();
  if (!me) return 0;
  st = query("stage");

  if (!arg || arg == "help") {
    tell_object(me, HIY "　戏折子：story 开场 ｜ story 退场 ｜ story 状态\n" NOR);
    return 1;
  }

  if (arg == "状态" || arg == "status") {
    tell_object(me, HIY "当前场次：" + st + "\n" NOR);
    return 1;
  }

  if (arg == "开场" || arg == "start") {
    if (st > 0) { tell_object(me, "已经开演了。\n"); return 1; }
    set("stage", 1);
    tell_object(me, HIC "\n　　　　　　【第 一 幕】\n" NOR);
    tell_object(me, "……夜幕低垂，长街尽头只剩一盏灯。\n");
    npc = new(__DIR__ "actor");
    if (npc) {
      npc->move(environment(me));
      message_vision(HIW "$N看到一个青衣人立在灯下，斗笠压得很低。\n" NOR, me);
    }
    return 1;
  }

  if (arg == "退场" || arg == "end") {
    tell_object(me, HIC "戏散了，人也不见了。\n" NOR);
    destruct(this_object());
    return 1;
  }

  return notify_fail("story help 看看用法。\n");
}
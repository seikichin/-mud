// TIE@FY3 ALL RIGHTS RESERVED
inherit ROOM;
string stone();


string poem1 = "浩浩愁茫茫劫短歌终明月缺郁郁佳城中有碧血碧亦有时尽血亦有时灭一缕香魂无断绝是耶非耶化为蝴蝶";
string final;


void create() {
  set("short", "山洞秘道");
  set("long", @LONG
秘道在这里突然变宽变大，形成了一个巨大的石室，室内长满了各种千奇百怪
的钟乳石，在光线的照耀下闪烁着迷人的色彩，如果没有光线你很难从这里绕出去。
石室一角有一个巨大的白石，象一张天然的书桌。
LONG
  );
  set("exits", ([
    "west": __DIR__ "lmidao1",
    "north": __DIR__ "lmidao3",
    "northeast": __DIR__ "lmidao4",
  ]));
  set("item_desc", ([
    "stone": (: stone :),
    "白石": (: stone :),
  ]));
  set("marks/finished", 0);
  set("coor/x", 100);
  set("coor/y", 30);
  set("coor/z", 0);
  setup();
}

void init() {
  add_action("do_write", "write");
}

string stone() {
  object me;
  me = this_player();
  if (query("marks/finished")) {
    tell_object(me, "一块表面十分平滑的白石。\n");
  } else {
    tell_object(me, "一块表面十分平滑的白石，上面平铺了一张宣纸，上面写了些字：\n\n");
    tell_object(me, query("final"));
    tell_object(me, "其中缺了六个字，纸边摆着现成的笔墨。 \n");
  }
  return "";
}


int do_write(string arg) {
  object me, room, obj;
  string msg, msg1, msg2;
  int n;

  me = this_player();
  if (query("marks/finished")) {
    tell_object(me, "好好的一首词，还写些什么？\n");
    return 1;
  }

  msg = query("num1") + query("num2") + query("num3");
  msg1 = query("num1") + "　" + query("num2") + "　" + query("num3");
  msg2 = query("num1") + " " + query("num2") + " " + query("num3");


  if (!arg || (arg != msg && arg != msg1 && arg != msg2)) {
    tell_object(me, "你提笔欲写，却总觉得不甚贴切。\n");
    return 1;
  }

  tell_object(me, "你略一沉吟，提笔在空格上填了几个字，又把笔放了下去。\n");
  message("vision", me->name() + "略一沉吟，从白石上提笔写了几个字，又把笔放了回去。\n", environment(me), me);

  set("marks/finished", 1);
  me->set_temp("marks/guest", 1);
  if (!REWARD_D->check_m_success(me, "三入神水")) {
    tell_object(me, "提笔落下的一瞬，满室钟乳石竟齐齐映出光来。石壁深处传来一个很轻的声音，像叹息：\n"
      + "「你写对了字——可你认得出，写这词的人是谁么？」\n"
      + "那声音顿了顿：「清平剑客的旧居，就在这水底。你已经站在门口了。」\n");
    me->set("marks/enter_ss/白石", 1);
    n = (me->query("marks/enter_ss/钓鱼") ? 1 : 0)
      + (me->query("marks/enter_ss/白石") ? 1 : 0)
      + (me->query("marks/enter_ss/风筝") ? 1 : 0);
    REWARD_D->riddle_set(me, "三入神水", n);
    if (n >= 3) {
      REWARD_D->riddle_done(me, "三入神水", 20, 1);
      obj = new(AREA_SHENSHUI "obj/kuzhi");
      if (objectp(obj)) obj->move(me);
    }
  }
  tell_object(me, "你只觉得后脑勺似乎被什么东西叮了一下。\n");
  me->unconcious();
  message("vision", "你只觉得眼前一花，似有一个人影掠过，" + me->name() + "已经失去了踪影。\n", environment(me), me);
  room = find_object(AREA_SHENSHUI "woshi2");
  if (!objectp(room)) room = load_object(AREA_SHENSHUI "woshi2");
  me->move(room);
  //	  me->set("marks/enter_ss/白石",1);  	  
  return 1;
}



void reorder() {

  string final, s1, s2, s3;

  // poem1 共 45 字：浩浩愁茫茫劫短歌终明月缺郁郁佳城中有碧血
  //                碧亦有时尽血亦有时灭一缕香魂无断绝是耶非耶化为蝴蝶
  // 三处各缺二字，缺字都留在能由上下文推出的位置。

  // 缺一：「郁郁佳城」
  if (random(2)) {
    set("num1", poem1[12..13]);
    s1 = "□□" + poem1[14..15];
  } else {
    set("num1", poem1[14..15]);
    s1 = poem1[12..13] + "□□";
  }

  // 缺二：「血亦有时灭」
  if (random(2)) {
    set("num2", poem1[26..27]);
    s2 = poem1[25..25] + "□□" + poem1[28..29];
  } else {
    set("num2", poem1[28..29]);
    s2 = poem1[25..27] + "□□";
  }

  // 缺三：「化为蝴蝶」
  if (random(2)) {
    set("num3", poem1[41..42]);
    s3 = "□□" + poem1[43..44];
  } else {
    set("num3", poem1[43..44]);
    s3 = poem1[41..42] + "□□";
  }

  final = "\n\t\t" + poem1[0..5] + "，" + poem1[6..11] + "，\n"
    + "\t\t" + s1 + "，" + poem1[16..19] + "。\n"
    + "\t\t" + poem1[20..24] + "，" + s2 + "。\n"
    + "\t\t" + poem1[30..36] + "！\n"
    + "\t\t" + poem1[37..40] + "？" + s3 + "。\n\n";

  set("final", final);
  return;
}
void reset() {
  ::reset();
  reorder();
  delete("marks/finished");
}

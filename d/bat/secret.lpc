#include <ansi.h>
inherit ROOM;

// 蝙蝠传奇：摸进密室 = 全谜题完成
void init() {
  object me = this_player();
  if (!userp(me))
    return;
  if (REWARD_D->riddle_check(me, "蝙蝠传奇") != 7)
    return;
  tell_object(me, HIC "\n你站在这间没有窗户的密室里，忽然什么都明白了——\n"
    "灯火照不见点灯的人，就像这一岛的光，从来照不见它的主人。\n" NOR);
  REWARD_D->riddle_done(me, "蝙蝠传奇", 10, 1);
}

void create() {
  set("short", "密室");
  set("long", @LONG
这是一间非常隐秘的房间，没有窗户，只点着一根蜡烛，烛光黯淡，有如一点
暗夜里的鬼火。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "up": __DIR__ "tianti1",
    "north": __DIR__ "feng",
  ]));

  set("coor/x", 0);
  set("coor/y", -10);
  set("coor/z", 0);
  setup();
}

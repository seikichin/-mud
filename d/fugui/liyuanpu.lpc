inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "利源当铺");

  set("long", @LONG
这屋子便是远近闻名的利源当铺，也和城里别的人家一样，建筑得朴实简陋，
窄而厚的门，小而高的窗子，昏黄的窗纸，昏黄的灯光。一个身影勾偻，白发苍苍
的老头子手里提着桶脏水正准备往外就泼。
LONG);

  set("type", "house");
  set("exits", ([
    "west": __DIR__ "xiaojie3",
  ]));
  set("objects", ([
    __DIR__ "npc/huo": 1,
  ]));

  set("item_desc", ([
    "柜台": "一张又高又厚的木柜台，台面被磨得发亮。柜台底下黑漆漆的，\n像是塞着些早就没人要的碎纸烂账。（ｆａｎ）\n",
    "counter": "一张又高又厚的木柜台，台面被磨得发亮。柜台底下黑漆漆的，\n像是塞着些早就没人要的碎纸烂账。（ｆａｎ）\n"
  ]));

  set("coor/x", 30);
  set("coor/y", 90);
  set("coor/z", 0);
  setup();
}

void init() {
  add_action("do_fan", "fan");
}

int do_fan(string arg) {
  object me, ob;
  me = this_player();
  if (!arg) return 0;
  if (arg != "counter" && arg != "柜台") return 0;
  if (me->query_temp("marks/fugui_dp_counter")) {
    tell_object(me, "柜台底下除了老灰，再没有别的东西了。\n");
    return 1;
  }
  message_vision(CYN "$N蹲下身子，伸手到柜台底下一阵摸索。\n" NOR, me);
  ob = new(__DIR__ "obj/canpian2");
  if (!ob) {
    tell_object(me, "你摸了半天，只摸到一手灰。\n");
    return 1;
  }
  if (!ob->move(me)) {
    tell_object(me, "你身上带着的东西已经太多了。\n");
    ob->move(this_object());
    return 1;
  }
  message_vision(CYN "$N从灰里摸出一片发黄的残纸。\n" NOR, me);
  me->set_temp("marks/fugui_dp_counter", 1);
  return 1;
}

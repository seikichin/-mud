#include <ansi.h>
inherit SMART_NPC;
int do_running();
string do_flower();

void create() {
  set_name("马小贝", ({ "ma xiaobei", "xiaobei" }));
  set("long", "
小宝和小贝是马方中的一双心肝宝贝，无论他们要什么几乎全都有求必应，
就算做错事，马方中也没有责备过他们一句。只要一空下来，就会陪他们到
处去玩。\n");

  set("gender", "男性");
  set("group", "ma");

  set("age", 10);


  set("combat_exp", 50000);
  set("attitude", "friendly");

  set("inquiry", ([
    "*": "有事儿去问我爸我妈吧。\n",
    "花": (: do_flower() :),
    "洞": (: do_flower() :),
  ]));

  set("arrive_msg", "跳跳蹦蹦地跑了过来");
  set("chat_chance", 20);
  set("chat_msg", ({
    (: do_running :),
  }));


  setup();
  carry_object("/obj/armor/cloth")->wear();

}

int do_running() {

  object env;

  if (query_busy()) return 1;

  env = environment();
  if (env->query("ma_room1")) {
    set("leave_msg", "跳跳蹦蹦地从里屋奔到外屋");
    ccommand("go north");
    return 1;
  }

  set("leave_msg", "跳跳蹦蹦地又从外屋冲进里屋");
  ccommand("go south");
  return 1;

}


string do_flower() {
  object me = this_player();

  if (!me) return "";

  if (me->query_temp("zangbei/守洞人"))
    return "action马小贝歪着头看了看你：“爹都跟你说了？那你可别跟人说是我告诉你的！”";

  return "action马小贝正在花丛里追着一只蝴蝶。听见你问起花，\n"
         "他忽然停下来，左右看了看，压低了声音：\n\n"
         "“那些花下面有个洞哦。”\n\n"
         "“爹不许我们碰那些花，也不许跟人说。”他吐了吐舌头，\n"
         "“去年我听见他在院子里跟人说话，说什么——守了十三年……”\n\n"
         "“你要是去问爹，可别说是我说的！”";
}

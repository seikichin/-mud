#include <ansi.h>
inherit SMART_NPC;
inherit INQUIRY_MSG;

int estate();
string do_hole();
string do_flower_deny();

void create() {
  set_name("马方中", ({ "ma fangzhong", "ma" }));
  set("title", "与世无争");
  set("long", "
马方中这个人就象他的名字一样，方方正正，规规矩矩，从出生到现在，
从来没有做过任何一件令人觉得惊奇意外的事。别人觉得应该成亲的时候，
他就成了亲，别人觉得应该生儿育女的时候，他就不多不少生了两个。种
花是他最大的嗜好。\n");

  set("gender", "男性");
  set("group", "ma");
  set("age", 32);

  set("marry_name", "马月云");
  set("marry", "ma yueyun");

  set("combat_exp", 5100000);
  set("attitude", "friendly");

  set("inquiry", ([
    "老伯": "老伯是我的兄弟，我的朋友，也是我的父母，若没有他，我在十六岁
的时候已经被人杀死了。",
    "孙玉伯": "老伯是我的兄弟，我的朋友，也是我的父母，若没有他，我在十六岁
的时候已经被人杀死了。",
    "洞": (: do_hole() :),
    "地道": (: do_hole() :),
    "秘道": (: do_hole() :),
    "花": (: do_flower_deny() :),
  ]));

  set("nb_chat_chance", 100);
  set("nb_chat_msg_combat", ([

  ]));
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: auto_smart_fight(30) :),
  }));
  set("chat_chance", 1);
  set("chat_msg", ({
    "\n天高气爽，风吹在身上，不冷也不热。马方中还在院子里流连着，这儿看看，
那儿拔拔，舍不得回房睡觉。\n",
  }));

  auto_npc_setup("wang", 200, 200, 0, "/obj/weapon/", "fighter_u", "dragonstrike", 1);

  setup();
  carry_object("/obj/armor/cloth")->wear();
  carry_object(__DIR__ "obj/cup");

}


string do_flower_deny() {
  object me = this_player();

  if (!me) return "";

  if (me->query_temp("zangbei/守洞人"))
    return "action马方中笑了笑：“那些花，年年都开得这样好。”";

  return "action马方中笑了笑：“不过是几株菊花罢了，不值一提。”\n\n"
         "他说这话的时候，眼睛却是看着别处的。";
}


string do_hole() {
  object me = this_player();
  object room = environment();

  if (!me || !room) return "";

  if (REWARD_D->check_m_success(me, "十三年"))
    return "action马方中看了看你，只是笑了笑，没有再说话。";

  if (!room->query("exits/down"))
    room->set("exits/down", "/d/zangbei/tunnel1");

  if (!REWARD_D->riddle_check(me, "十三年"))
    REWARD_D->riddle_set(me, "十三年", 1);

  me->set_temp("zangbei/守洞人", 1);

  return "action马方中的脸色忽然变了。\n\n"
         "他慢慢放下手里的茶杯，走到那片开得最盛的菊花前，弯下腰，\n"
         "抓住花根，用力往上一拔——连根而起，带起了一大块泥土。\n\n"
         "泥土底下，赫然露出一个黑漆漆的洞口，一股又冷又湿的风从下面涌上来。\n\n"
         "“我住在这里，就是要替他守着这地道的出口。”\n"
         "马方中的声音低得几乎听不见，\n"
         "“我只希望他永远都用不着这条地道。”\n\n"
         "他抬起头看着你，眼睛里有一种说不出的东西：\n"
         "“你若真要下去，就别指望还能干干净净地回来。”\n\n"
         "（往下的路，已经打开了。）";
}

inherit ROOM;
#include <ansi.h>

void create()

{
  set("short", "水下暗道");
  set("long", @LONG
地下竞有条秘密的河流。借着灯火，才看出这条河流很窄而弯曲，却看不出水
有多深，也不知通向哪里。两旁是坚固的石壁，左边的石壁上，过几步就有个巨大
的铁环，挂着很粗的铁链，石壁上长着青苔，铁环也已生锈。
LONG
  );
  set("exits", ([
    "up": __DIR__ "mgarden",
    "north": __DIR__ "tunnel2",
  ]));
  set("item_desc", ([
    "铁环": "这铁环已经生锈，看样子是用来栓船的。\n",
    "ring": "这铁环已经生锈，看样子是用来栓船的。\n",
    "铁链": "这铁环已经生锈，看样子是用来栓船的。\n",
    "chain": "这铁环已经生锈，看样子是用来栓船的。\n",
  ]));
  set("objects", ([
  ]));

  set("coor/x", -1280);
  set("coor/y", 680);
  set("coor/z", -10);
  set("map", "zbeast");
  setup();
}


void init() {
  add_action("do_climb", "climb");
}


int do_climb(string arg) {
  object me = this_player();
  int kee, dmg, floor;

  if (!arg) return 0;
  if (arg != "chain" && arg != "铁链" && arg != "ring" && arg != "铁环")
    return 0;

  if (me->query_temp("zangbei/秘道带血")) {
    tell_object(me, "你手上全是血，早已握不住那根锈链了。\n");
    return 1;
  }

  message_vision(HIR "$N伸手抓住石壁上那根粗重的铁链，用力一拽。\n" NOR, me);

  me->set_temp("zangbei/秘道带血", 1);

  kee = me->query("kee");
  dmg = me->query("max_kee") / 6;
  floor = me->query("max_kee") / 5;
  if (kee - dmg < floor) dmg = kee - floor;
  if (dmg > 0) me->receive_damage("kee", dmg, this_object());

  message_vision(HIR "生了锈的铁环忽然一转，剥落的铁屑像无数根细针，\n"
    "深深扎进$N的掌心。鲜血顺着铁链往下淌，在黑暗里发出轻轻的滴答声。\n" NOR, me);

  tell_object(me, HIR "（你受了伤——但你的手上，从此有了血。）\n" NOR);
  return 1;
}

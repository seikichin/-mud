#include <ansi.h>
inherit SMART_NPC;
int ask_blade();


void create() {
  object weapon;
  set_name("石重", ({ "shi chong", "shi", "chong" }));

  set("class", "assassin");
  set("title", BLU "千斤顶" NOR);
  set("gender", "男性");

  set("age", 47);
  set("chat_chance", 1);
  set("chat_msg", ({
    "石重嘀咕道：魔教没事发召集令找俺干啥？\n",
  }));

  set("combat_exp", 5100000);

  set("perform_weapon_attack", "assassin/hammer/longfenghuan/longfengshuangfei");

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: auto_smart_fight(30) :),
  }));

  set_skill("blade", 200);
  set_skill("sword", 200);
  set_skill("lefthand-sword", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("chillblade", 200);
  set_skill("13-sword", 150);
  set_skill("unarmed", 200);
  set_skill("hammer", 200);
  set_skill("longfenghuan", 186);
  set_skill("lingxi-zhi", 140);
  set_skill("force", 200);
  set_skill("jingxing", 200);
  set_skill("perception", 200);

  map_skill("force", "jingxing");
  map_skill("hammer", "longfenghuan");
  map_skill("unarmed", "spicyclaw");
  map_skill("sword", "lefthand-sword");
  map_skill("parry", "longfenghuan");
  map_skill("dodge", "13-sword");

  set("death_msg", CYN "\n$N大叫道：你～～～～～～～～！\n" NOR);

    set("inquiry", ([
    "圣刀"   : (: ask_blade :),
    "七个字" : (: ask_blade :),
    "刀"     : (: ask_blade :),
  ]));

setup();

  weapon = carry_object("/obj/weapon/hammer");
  weapon->set_name("千斤铜鼎", ({ "ding" }));
  weapon->set("value", 0);
  weapon->wield();


  weapon = carry_object("/obj/armor/cloth");
  weapon->set_name("油皱皱的布衣", ({ "cloth" }));
  weapon->set("value", 0);
  weapon->wear();

}


int ask_blade() {
  object me = this_player();
  int ph = REWARD_D->riddle_check(me, "幽冥渡");

  if (ph < 1) {
    message_vision("$N把铜鼎往地上一顿，摆摆手：「入魔关的守关者还没放你进来。先去找他。」\n", this_object(), me);
    return 1;
  }

  if (me->query_temp("youming/told_shi")) {
    message_vision("$N挠挠头咧嘴一笑：「俺就识那么两个字，再问也没有了。」\n", this_object(), me);
    return 1;
  }

  message_vision("$N挠了挠头，把那口千斤铜鼎往地上一顿。\n", this_object(), me);
  message_vision(CYN "「这是往生道。走过去的人，江湖上就当他已经死了。」\n" NOR, this_object(), me);
  message_vision(CYN "「至于教主问的那个……俺不识字。可就那么七个字，俺还是记住了一点。」\n" NOR, this_object(), me);
  message_vision(HIY "「头一个字，是个『小』字 —— 俺认得这个。」\n" NOR, this_object(), me);
  message_vision(HIY "「第二个字…… 像是说一座楼。」\n" NOR, this_object(), me);
  message_vision(WHT "「剩下的你往东边去问杜七，他认得字。」\n" NOR, this_object(), me);

  me->set_temp("youming/told_shi", 1);
  tell_object(me, HIG "\n【幽冥渡·往生道】圣刀七字，你得了头两个字：小 楼\n" NOR);
  return 1;
}

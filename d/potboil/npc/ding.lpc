#include <ansi.h>
#include <combat.h>
inherit SMART_NPC;
int ask_blade();

void smart_fight();

void create() {
  object weapon;
  set_name("丁迷", ({ "ding mi", "ding", "mi" }));

  set("class", "demon");
  set("title", BLU "神教外务" NOR);
  set("nickname", CYN "药人" NOR);

  set_temp("apply/haste", 100);
  set("always_duxin", 1);

  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 27);

  set("chat_chance", 1);
  set("chat_msg", ({
    "丁迷冷笑道：楼兰？唐门？那算甚么东西？\n",
  }));

  set("combat_exp", 7100000);

  set("nb_chat_chance", 100);
  set("nb_chat_msg_combat", ([
    30: (: smart_fight() :),
  ]));

  set_skill("blade", 200);
  set_skill("sword", 200);
  set_skill("lefthand-sword", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("chillblade", 200);
  set_skill("13-sword", 150);
  set_skill("unarmed", 200);
  set_skill("hammer", 200);
  set_skill("longfenghuan", 186);
  set_skill("lingxi-zhi", 190);
  set_skill("force", 200);
  set_skill("jingxing", 200);
  set_skill("spicyclaw", 240);
  set_skill("venusfinger", 200);
  set_skill("xifengying", 180);

  set_skill("divineforce", 200);
  set_skill("daimonsword", 200);

  set_skill("magic", 240);
  set_skill("essencemagic", 240);

  set_skill("six-sense", 300);
  set_skill("fall-steps", 220);
  set_skill("meng-steps", 220);

  map_skill("magic", "essencemagic");
  map_skill("force", "divineforce");
  map_skill("hammer", "longfenghuan");
  map_skill("unarmed", "spicyclaw");
  map_skill("sword", "daimonsword");
  map_skill("parry", "daimonsword");
  map_skill("dodge", "fall-steps");

  set("death_msg", CYN "\n$N大叫道：你～～～～～～～～！\n" NOR);

    set("inquiry", ([
    "圣刀"   : (: ask_blade :),
    "七个字" : (: ask_blade :),
    "三生石" : (: ask_blade :),
  ]));

setup();


  weapon = carry_object("/obj/armor/cloth");
  weapon->set_name("惨碧色的丧衣", ({ "cloth" }));
  weapon->set("value", 0);
  weapon->wear();

}


void smart_fight() {
  object me = this_object();
  object *enemy;
  int i;
  enemy = me->query_enemy();

  i = query_busy();
  stop_busy();

  switch (random(3)) {
    case 0:
      /*		ccommand("perform force.decaybreath");
		if (i)
			perform_busy(i);
		else
			stop_busy();*/
      return;
    case 1:
      ccommand("perform force.deathgrip");
      if (i)
        perform_busy(i);
      else
        stop_busy();
      return;
    case 2:
      ccommand("perform force.zombify");
      if (i)
        perform_busy(i);
      else
        stop_busy();
      return;
  }
  if (i)
    perform_busy(i);
  else
    stop_busy();

  return;
}


int ask_blade() {
  object me = this_player();
  int ph = REWARD_D->riddle_check(me, "幽冥渡");

  if (ph < 5) {
    message_vision("$N穿着一身惨碧色的丧衣，冷冷道：「楼兰？唐门？那算甚么东西？」\n", this_object(), me);
    message_vision("$N：「这石头照见的，是你心里想的那个人。还不到时候。」\n", this_object(), me);
    return 1;
  }

  if (me->query_temp("youming/told_ding")) {
    message_vision("$N一动不动地站着：「有些事，你最好还是不要知道。」\n", this_object(), me);
    return 1;
  }

  message_vision("$N回过头，那双眼睛亮得不像活人。\n", this_object(), me);
  message_vision(CYN "「这石头照见的，是你心里想的那个人。你要找的那七个字……」\n" NOR,
    this_object(), me);
  message_vision(HIY "「那是陆放翁的诗。你读过唐诗，便该想得起来。」\n" NOR, this_object(), me);
  message_vision(HIW "「有些事，你最好还是不要知道。知道了，就一定会有灾祸。」\n" NOR,
    this_object(), me);

  me->set_temp("youming/told_ding", 1);
  tell_object(me, HIG "\n【幽冥渡·三生石】那七个字，是陆放翁的诗（look 三生石 试试）。\n" NOR);
  return 1;
}

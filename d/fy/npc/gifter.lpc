//	/d/fy/npc/gifter.lpc
//	礼物使者  gift angel
//
//	来源：D:\\mud\\fymud\\d\\fy\\npc\\gifter.c （ldmud 风云，GBK 编码）
//	移植至 fluffos / fy2005 的适配说明：
//	  1. 本档与题库 /data/poem/QRdata.txt、/data/poem/grewords.txt 均为 UTF-8。
//	  2. fluffos 的字符串按「字符（码点）」索引与切片（str[i]、str[i..j] 皆为全闭区间），
//	     故 swap_word() / insert_string() 改写为字符级实现（原版按 GBK 双字节切分）。
//	  3. ask 指令只认 inquiry 中的「函数指针」——dbase 的 query() 会执行
//	     evaluate(fp, this_object())，所以各入口函数皆接收一个参数。
//	  4. 原版 call_out("greeting", ...) 却没有定义 greeting()，此处补上以免运行时出错。
//	  5. 原版死代码 random_string()（GBK 双字节乱序）已移除，未被任何地方调用。

inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

#define CHANNEL_D	"/adm/daemons/channeld"
#define QR_DATA		"/data/poem/QRdata.txt"
#define GRE_WORDS	"/data/poem/grewords.txt"

#define QR_MAX_LINE		703		// 开心词典题库行数
#define GRE_MAX_LINE	12646	// 英语单词表行数

//	入口：供 set("inquiry") 以函数指针引用（dbase 会带 this_object() 调用）
int get_reward(object ob);
int ask_test(object ob);
int ask_gre(object ob);

//	内部实现
string get_question(object me);
string get_words(object me);
string insert_string(string str);
string swap_word(string str);
int do_answer(string arg);
int do_guess(string arg);


void create()
{
	object cloth;

	set_name(HIM + "礼物使者" + NOR,
		({ "gift angel", "tian shi", "gift", "angel", "liwu" }));

	set("long", "礼物天使，负责风云节庆期间礼物发放的使者。每天也可以找她参与答题\n");
	set("gender", "女性");
	set("age", 18);
	set("attitude", "friendly");
	set("can_speak", 1);

	set("max_gin", 5000);
	set("max_kee", 5000);
	set("max_sen", 5000);
	set("max_force", 5000);
	set("force", 5000);
	set("enforce", 350);

	set("str", 50);
	set("int", 50);
	set("con", 50);
	set("dex", 50);
	set("combat_exp", 1200000);

	set("inquiry", ([
		"节日礼物"	: (: get_reward :),
		"礼物"		: (: get_reward :),
		"question"	: (: ask_test :),
		"开心词典"	: (: ask_test :),
		"开心辞典"	: (: ask_test :),
		"english"	: (: ask_gre :),
		"English"	: (: ask_gre :),
		"单词"		: (: ask_gre :),
	]));

	set("vendor_goods", ([
		"/obj/wiz_toy/lvyi.lpc"			: 10,
		"/obj/wiz_toy/qingshiling.lpc"	: 10,
	]));

	setup();

	cloth = carry_object("/obj/armor/cloth");
	cloth->set_name(MAG + "霓裳羽衣" + NOR, ({ "nishang yuyi", "yuyi" }));
	cloth->set("long", "这是一件霓裳羽衣(nishang yuyi)  婷婷袅袅，锦簇花攒。\n");
	cloth->set("value", 0);
	cloth->wear();
}

